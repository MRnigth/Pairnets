<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <!-- Popups are separate roots and do not inherit the window font. -->
  <Style Selector="ContextMenu, MenuFlyoutPresenter, ToolTip, FlyoutPresenter">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
  </Style>

  <!-- Keyboard focus (Tab and arrow keys only, never mouse clicks): a 2 px ring in the dark accent ink, 3 px outside
       the control, instead of Fluent's black and white one. The Windows app draws the same ring (FocusRing in
       Themes/Controls.xaml). Round buttons and page tiles get a ring of their own shape. -->
  <Style Selector="AdornerLayer">
    <Setter Property="DefaultFocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="2" CornerRadius="14" BorderBrush="{DynamicResource T.AccentInk}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.RoundIconButton, Button.dockbtn, RadioButton.dockpage, Button.fpill">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="2" CornerRadius="999" BorderBrush="{DynamicResource T.AccentInk}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.sidetile">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="2" CornerRadius="21" BorderBrush="{DynamicResource T.AccentInk}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>

  <!-- Line icons -->
  <Style Selector="v|LineIcon.icon">
    <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    <Setter Property="StrokeThickness" Value="2.3" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="v|LineIcon.icon.white">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <Style Selector="v|LineIcon.icon.muted">
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="22,24" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- Chips: fully round, T.Chip fill. Icon squares are Border.iconsq. -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Border.chip.dim">
    <Setter Property="Background" Value="{DynamicResource T.ChipDim}" />
  </Style>
  <Style Selector="Border.iconsq">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <Style Selector="Border.iconsq.dim">
    <Setter Property="Background" Value="{DynamicResource T.ChipDim}" />
  </Style>
  <!-- Class names shared with the Windows app -->
  <Style Selector="TextBlock.PageTitle">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.SectionTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.SmallLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style Selector="TextBlock.SoftText">
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style Selector="Button.SecondaryButton">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.RoundIconButton">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="Button.RoundIconButton /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
  </Style>
  <Style Selector="Border.Attention">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.Attention TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="Border.IconSquare">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
  </Style>
  <!-- Page tiles and group boxes -->
  <Style Selector="Border.tile2">
    <Setter Property="Background" Value="{DynamicResource T.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <!-- The tray panel's "needs you" strip (a flat button around this border) -->
  <Style Selector="Button.strip > Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <Style Selector="Button.strip:pointerover > Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPillHover}" />
  </Style>
  <Style Selector="Button.strip">
    <Setter Property="FocusAdorner">
      <FocusAdornerTemplate>
        <Border Margin="-3" BorderThickness="2" CornerRadius="21" BorderBrush="{DynamicResource T.AccentInk}" />
      </FocusAdornerTemplate>
    </Setter>
  </Style>
  <!-- Attention strip -->
  <Style Selector="Border.attention">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.attention TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>

  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource T.Banner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.BannerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Border}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.flat /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <!-- "Stalled" next to a transfer: after .muted, so it wins. -->
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.soft">
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>

  <!-- Buttons -->
  <!-- Secondary button is the default; .accent is the primary one. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.SubtleHover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <!-- Smaller button for tight rows. -->
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.AccentButtonHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1F55C9" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- The tray's "Fix" button: a darker orange than the badge, so the white words read well. -->
  <Style Selector="Button.warn">
    <Setter Property="Background" Value="{StaticResource S.OrangeButton}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.warn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S.OrangeButton}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S.OrangeButtonHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- For actions that cannot be undone (Reset this app). -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource S.Red}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S.Red}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A61B25" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Segmented control (two RadioButtons inside Border.segments) -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource T.Subtle}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="9" Padding="12.5,4.5">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
  </Style>

  <!-- List rows -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>

  <!-- Count badge -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource S.Orange}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <!-- Progress -->
  <Style Selector="ProgressBar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource T.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Indicator">
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ProgressBar /template/ Border#PART_Track">
    <Setter Property="CornerRadius" Value="999" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="999" />
  </Style>
  <Style Selector="ProgressBar.up">
    <Setter Property="Foreground" Value="{StaticResource S.Green}" />
  </Style>
  <Style Selector="ProgressBar.down">
    <Setter Property="Foreground" Value="{StaticResource S.Blue}" />
  </Style>

  <!-- Settings form -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style Selector="Border.chip-ok">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Border.chip-bad">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Border.chip-busy">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="12,6" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Toggle switch: 42x24 pill, white 20px knob, on = T.AccentButton -->
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,Auto" Background="Transparent">
          <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
            <ContentPresenter x:Name="PART_OffContentPresenter" Content="{TemplateBinding OffContent}"
                              ContentTemplate="{TemplateBinding OffContentTemplate}" Foreground="{TemplateBinding Foreground}" />
            <ContentPresenter x:Name="PART_OnContentPresenter" Content="{TemplateBinding OnContent}"
                              ContentTemplate="{TemplateBinding OnContentTemplate}" Foreground="{TemplateBinding Foreground}" IsVisible="False" />
          </Grid>
          <Border x:Name="track" Grid.Column="1" Width="42" Height="24" CornerRadius="12" Padding="2"
                  Background="{DynamicResource T.SwitchOff}" VerticalAlignment="Center">
            <Panel x:Name="PART_MovingKnobs" HorizontalAlignment="Left"><Panel x:Name="PART_SwitchKnob"><Ellipse x:Name="knob" Width="20" Height="20" Fill="{DynamicResource T.KnobOff}" /></Panel></Panel>
          </Border>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#track">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Ellipse#knob">
    <Setter Property="Fill" Value="White" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Panel#PART_MovingKnobs">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ ContentPresenter#PART_OffContentPresenter">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ ContentPresenter#PART_OnContentPresenter">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- ================= Main window: sidebar, pages, tiles ================= -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.8" />
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource T.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Sidebar navigation (RadioButtons) -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="12" Padding="9.5,7.5">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.NavHover}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.NavSelected}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
  </Style>
  <Style Selector="RadioButton.nav v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style Selector="RadioButton.nav:checked v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.Accent}" />
  </Style>

  <!-- Status card on the overview: a soft tint of the status colour at the top -->
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Small fact tiles (folder, last synced, server, free space) -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource T.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.tile.warn">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <Style Selector="Border.tile.warn TextBlock.value">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- "2 things need your attention" -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style Selector="Border.callout TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>

  <!-- Buttons that look like links, and round icon-only buttons -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.AccentHover}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.SubtleHover}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>

  <!-- Coloured message chips (History: restored / failed) -->
  <Style Selector="Border.ok">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.OkText}" />
  </Style>
  <Style Selector="Border.bad">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="Border.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
  </Style>

  <!-- Selectable lists (History) -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Selected}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Selected}" />
  </Style>

  <!-- Day headings in the activity list -->
  <Style Selector="TextBlock.day">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
    <Setter Property="Margin" Value="8,12,0,4" />
  </Style>

  <!-- The "this computer ⇄ server ⇄ other computer" picture -->
  <Style Selector="Ellipse.ring">
    <Setter Property="Fill" Value="{DynamicResource T.Node}" />
    <Setter Property="Stroke" Value="{DynamicResource T.NodeRing}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Ellipse.ring.online">
    <Setter Property="Stroke" Value="{StaticResource S.Green}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Ellipse.ring.unknown">
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Stroke" Value="{DynamicResource T.Card}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <Style Selector="v|FlowLine">
    <Setter Property="LineBrush" Value="{DynamicResource T.Line}" />
    <Setter Property="UpBrush" Value="{StaticResource S.Green}" />
    <Setter Property="DownBrush" Value="{StaticResource S.Blue}" />
  </Style>
  <!-- A FlowLine moves its dots itself, frame by frame, at the speed of the bytes. -->

  <!-- The tray panel: a card that floats next to the tray / menu bar -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- ================= Motion (runs only while a window is shown) ================= -->
  <!-- Gentle up-and-down bob: the server icon waiting for an update, the update arrow. -->
  <Style Selector=":is(Control).bob">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="-6" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Continuous rotation: the sync glyph while syncing, the ring while the server updates. -->
  <Style Selector=":is(Control).spin">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A calm turn: the badge while it only checks for changes. -->
  <Style Selector=":is(Control).spin-slow">
    <Style.Animations>
      <Animation Duration="0:0:3.6" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- A ring that keeps growing out of a circle and fading: the other computer while it downloads. -->
  <Style Selector=":is(Control).ripple">
    <Style.Animations>
      <Animation Duration="0:0:1.7" IterationCount="INFINITE" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /><Setter Property="Opacity" Value="0.6" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1.42" /><Setter Property="ScaleTransform.ScaleY" Value="1.42" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Soft breathing: waiting for the other computer. -->
  <Style Selector=":is(Control).pulse">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.08" /><Setter Property="ScaleTransform.ScaleY" Value="1.08" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- One small pop when something changes (status badge, success). -->
  <Style Selector=":is(Control).pop">
    <Style.Animations>
      <Animation Duration="0:0:0.38" Easing="BackEaseOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.82" /><Setter Property="ScaleTransform.ScaleY" Value="0.82" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Arrows that keep travelling: up while uploading, down while downloading. -->
  <Style Selector=":is(Control).rise">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="QuadraticEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).fall">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="QuadraticEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The badge's second arrow while it goes both ways: falls half a beat after the first one rises. -->
  <Style Selector=":is(Control).fall-late">
    <Style.Animations>
      <Animation Duration="0:0:1.1" Delay="0:0:0.55" IterationCount="INFINITE" Easing="QuadraticEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- New rows (activity, files in progress) slide in from above. -->
  <Style Selector=":is(Control).enter">
    <Style.Animations>
      <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-8" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- ================= New look (stage 2): the left side and the dock ================= -->
  <Style Selector="Border.sidepanel">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <!-- A flat clickable row (this computer, the nest): the background is the state colour, set from code -->
  <Style Selector="Button.siderow">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- A computer cell in the group: no chrome -->
  <Style Selector="Button.sidecell">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="0,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!-- Page tiles (2x3, 72 high, radius 18). Blue when chosen, with white text. -->
  <Style Selector="RadioButton.sidetile">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="{DynamicResource T.Tile}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="18" Padding="12,11">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.sidetile:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>
  <Style Selector="RadioButton.sidetile:checked">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="RadioButton.sidetile:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.AccentButton}" />
  </Style>
  <Style Selector="RadioButton.sidetile v|LineIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="RadioButton.sidetile:checked v|LineIcon">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <!-- The Needs-you tile: amber, and solid amber when chosen -->
  <Style Selector="RadioButton.sidetile.amber">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.WarnPillHover}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber:checked">
    <Setter Property="Foreground" Value="{DynamicResource T.NeedsActiveText}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.NeedsActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.NeedsActive}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="RadioButton.sidetile.amber:checked v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.NeedsActiveText}" />
  </Style>
  <!-- The folded dock: pills of round 44 px buttons -->
  <Style Selector="Border.dockpill">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="Width" Value="60" />
    <Setter Property="BoxShadow" Value="0 6 20 0 #40000000" />
  </Style>
  <Style Selector="Button.dockbtn">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="RadioButton.dockpage">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="Transparent" CornerRadius="22">
          <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.dockpage:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>
  <Style Selector="RadioButton.dockpage:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
  </Style>
  <Style Selector="RadioButton.dockpage v|LineIcon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style Selector="RadioButton.dockpage:checked v|LineIcon">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <!-- Overview: the amber button of a stop ("Allow these deletions") -->
  <Style Selector="Button.amber">
    <Setter Property="Background" Value="{DynamicResource T.NeedsActive}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource T.NeedsActiveText}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.amber /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.NeedsActive}" />
    <Setter Property="Foreground" Value="{DynamicResource T.NeedsActiveText}" />
  </Style>
  <Style Selector="Button.amber:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.NeedsActive}" />
    <Setter Property="Foreground" Value="{DynamicResource T.NeedsActiveText}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
</Styles>
