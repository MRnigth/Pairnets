<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>

  <!-- Line icons -->
  <Style Selector="v|LineIcon.icon">
    <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    <Setter Property="StrokeThickness" Value="2.3" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="v|LineIcon.icon.white">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <Style Selector="v|LineIcon.icon.muted">
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
  </Style>

  <!-- Cards -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,3" />
  </Style>

  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource T.Banner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.BannerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Border}" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Buttons -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="13,7" />
  </Style>
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="{DynamicResource T.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.SubtleHover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource T.Accent}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Accent}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.AccentHover}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.warn">
    <Setter Property="Background" Value="{StaticResource S.Orange}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.warn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C95E0F" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <!-- For actions that cannot be undone (Reset this app). -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource S.Red}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S.Red}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#A61B25" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Segmented control (two RadioButtons inside Border.segments) -->
  <Style Selector="Border.segments">
    <Setter Property="Background" Value="{DynamicResource T.Subtle}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style Selector="RadioButton.seg">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,6">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.seg:checked">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style Selector="RadioButton.seg:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
  </Style>

  <!-- List rows -->
  <Style Selector="Border.row">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>

  <!-- Count badge -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource S.Orange}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <!-- Progress -->
  <Style Selector="ProgressBar">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Value" Duration="0:0:0.35" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="{DynamicResource T.Track}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
  </Style>

  <Style Selector="ProgressBar.thin">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ProgressBar.up">
    <Setter Property="Foreground" Value="{StaticResource S.Green}" />
  </Style>
  <Style Selector="ProgressBar.down">
    <Setter Property="Foreground" Value="{StaticResource S.Blue}" />
  </Style>

  <!-- Settings form -->
  <Style Selector="TextBlock.label">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>
  <Style Selector="Border.chip-ok">
    <Setter Property="Background" Value="#1A2EA043" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.chip-bad">
    <Setter Property="Background" Value="#1ACF222E" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style Selector="Border.chip-busy">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Inputs -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>

  <!-- ================= Main window: sidebar, pages, tiles ================= -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.caps">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource T.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Sidebar navigation (RadioButtons) -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="11,9">
          <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.NavHover}" />
  </Style>
  <Style Selector="RadioButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#bd">
    <Setter Property="Background" Value="{DynamicResource T.NavSelected}" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #14000000" />
  </Style>
  <Style Selector="RadioButton.nav v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style Selector="RadioButton.nav:checked v|LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.Accent}" />
  </Style>

  <!-- Status card on the overview: a soft tint of the status colour at the top -->
  <Style Selector="Border.hero">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <!-- Small fact tiles (folder, last synced, server, free space) -->
  <Style Selector="Border.tile">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style Selector="Border.tile.warn">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <Style Selector="Border.tile.warn TextBlock.value">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- "2 things need your attention" -->
  <Style Selector="Border.callout">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style Selector="Border.callout TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
  </Style>

  <!-- Buttons that look like links, and round icon-only buttons -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.AccentHover}" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{DynamicResource T.Subtle}" />
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.SubtleHover}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>

  <!-- Coloured message chips (History: restored / failed) -->
  <Style Selector="Border.ok">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.OkText}" />
  </Style>
  <Style Selector="Border.bad">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.bad TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
  </Style>

  <!-- Selectable lists (History) -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Hover}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Selected}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource T.Selected}" />
  </Style>

  <!-- Day headings in the activity list -->
  <Style Selector="TextBlock.day">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Margin" Value="8,12,0,4" />
  </Style>

  <!-- The "this computer ⇄ server ⇄ other computer" picture -->
  <Style Selector="Ellipse.ring">
    <Setter Property="Fill" Value="{DynamicResource T.Node}" />
    <Setter Property="Stroke" Value="{DynamicResource T.NodeRing}" />
    <Setter Property="StrokeThickness" Value="1.5" />
  </Style>
  <Style Selector="Ellipse.ring.online">
    <Setter Property="Stroke" Value="{StaticResource S.Green}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <Style Selector="Ellipse.ring.unknown">
    <Setter Property="StrokeDashArray" Value="3,3" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Ellipse.dot">
    <Setter Property="Stroke" Value="{DynamicResource T.Card}" />
    <Setter Property="StrokeThickness" Value="2.5" />
  </Style>
  <Style Selector="v|FlowLine">
    <Setter Property="LineBrush" Value="{DynamicResource T.Line}" />
    <Setter Property="UpBrush" Value="{StaticResource S.Green}" />
    <Setter Property="DownBrush" Value="{StaticResource S.Blue}" />
  </Style>
  <Style Selector="v|FlowLine.flowing">
    <Style.Animations>
      <Animation Duration="0:0:1.3" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="Phase" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Phase" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The tray panel: a card that floats next to the tray / menu bar -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <!-- ================= Motion (runs only while a window is shown) ================= -->
  <!-- Gentle up-and-down bob: the server icon waiting for an update, the update arrow. -->
  <Style Selector=":is(Control).bob">
    <Style.Animations>
      <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="TranslateTransform.Y" Value="-6" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Continuous rotation: the sync glyph while syncing, the ring while the server updates. -->
  <Style Selector=":is(Control).spin">
    <Style.Animations>
      <Animation Duration="0:0:1.4" IterationCount="INFINITE">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Soft breathing: waiting for the other computer. -->
  <Style Selector=":is(Control).pulse">
    <Style.Animations>
      <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="SineEaseInOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
        <KeyFrame Cue="50%"><Setter Property="ScaleTransform.ScaleX" Value="1.08" /><Setter Property="ScaleTransform.ScaleY" Value="1.08" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- One small pop when something changes (status badge, success). -->
  <Style Selector=":is(Control).pop">
    <Style.Animations>
      <Animation Duration="0:0:0.38" Easing="BackEaseOut">
        <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="0.82" /><Setter Property="ScaleTransform.ScaleY" Value="0.82" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Arrows that keep travelling: up while uploading, down while downloading. -->
  <Style Selector=":is(Control).rise">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="QuadraticEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="-5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=":is(Control).fall">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="QuadraticEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="5" /><Setter Property="Opacity" Value="0" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- New rows (activity, files in progress) slide in from above. -->
  <Style Selector=":is(Control).enter">
    <Style.Animations>
      <Animation Duration="0:0:0.3" Easing="CubicEaseOut">
        <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="-8" /><Setter Property="Opacity" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="0" /><Setter Property="Opacity" Value="1" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
