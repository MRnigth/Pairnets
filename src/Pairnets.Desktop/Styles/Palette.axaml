<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Theme colours follow the operating system (light / dark). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="T.Bg" Color="#F4F5F8" />
      <SolidColorBrush x:Key="T.Card" Color="#FFFFFF" />
      <SolidColorBrush x:Key="T.Text" Color="#12151C" />
      <SolidColorBrush x:Key="T.Muted" Color="#525A6A" />
      <SolidColorBrush x:Key="T.Border" Color="#E6E8EE" />
      <SolidColorBrush x:Key="T.Hover" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.Subtle" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.SubtleHover" Color="#E7EAF0" />
      <SolidColorBrush x:Key="T.Accent" Color="#2F6FEB" />
      <SolidColorBrush x:Key="T.AccentHover" Color="#2560D6" />
      <SolidColorBrush x:Key="T.Track" Color="#E4E7EE" />
      <SolidColorBrush x:Key="T.Pill" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.Banner" Color="#E6EEFE" />
      <SolidColorBrush x:Key="T.BannerBorder" Color="#C9DAFB" />
      <SolidColorBrush x:Key="T.WarnPill" Color="#FFF3DC" />
      <SolidColorBrush x:Key="T.WarnText" Color="#6B4600" />
      <SolidColorBrush x:Key="T.Sidebar" Color="#F4F5F8" />
      <SolidColorBrush x:Key="T.NavHover" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.NavSelected" Color="#E6EEFE" />
      <SolidColorBrush x:Key="T.Node" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.NodeRing" Color="#C9CFDA" />
      <SolidColorBrush x:Key="T.Line" Color="#C9CFDA" />
      <SolidColorBrush x:Key="T.Selected" Color="#EDF3FF" />
      <SolidColorBrush x:Key="T.OkPill" Color="#E3F6EA" />
      <SolidColorBrush x:Key="T.OkText" Color="#0E7A3C" />
      <SolidColorBrush x:Key="T.BadPill" Color="#FDECEC" />
      <SolidColorBrush x:Key="T.BadText" Color="#B3261E" />
      <SolidColorBrush x:Key="T.Panel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="T.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="T.InputBorder" Color="#D5DAE3" />
      <SolidColorBrush x:Key="T.Tile" Color="#F7F8FB" />
      <SolidColorBrush x:Key="T.Chip" Color="#F0F2F6" />
      <SolidColorBrush x:Key="T.ChipDim" Color="#F5F6F9" />
      <SolidColorBrush x:Key="T.Dash" Color="#C3C8D3" />
      <SolidColorBrush x:Key="T.TextSoft" Color="#646C7C" />
      <SolidColorBrush x:Key="T.AccentButton" Color="#2F6FEB" />
      <SolidColorBrush x:Key="T.AccentButtonHover" Color="#2560D6" />
      <SolidColorBrush x:Key="T.AccentSoft" Color="#E6EEFE" />
      <SolidColorBrush x:Key="T.AccentInk" Color="#1F55C9" />
      <SolidColorBrush x:Key="T.Ok" Color="#12A150" />
      <SolidColorBrush x:Key="T.OkLine" Color="#7FCB9C" />
      <SolidColorBrush x:Key="T.Warn" Color="#E89B12" />
      <SolidColorBrush x:Key="T.WarnBorder" Color="#F2D69C" />
      <SolidColorBrush x:Key="T.Bad" Color="#D93636" />
      <SolidColorBrush x:Key="T.Off" Color="#9AA1AE" />
      <SolidColorBrush x:Key="T.Folder" Color="#D99A1E" />
      <SolidColorBrush x:Key="T.NeedsActive" Color="#FFB547" />
      <SolidColorBrush x:Key="T.NeedsActiveText" Color="#2B1A00" />
      <SolidColorBrush x:Key="T.Code" Color="#F0F2F6" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="T.Bg" Color="#0E1014" />
      <SolidColorBrush x:Key="T.Card" Color="#171A20" />
      <SolidColorBrush x:Key="T.Text" Color="#EEF1F6" />
      <SolidColorBrush x:Key="T.Muted" Color="#A9B0BE" />
      <SolidColorBrush x:Key="T.Border" Color="#252932" />
      <SolidColorBrush x:Key="T.Hover" Color="#20242C" />
      <SolidColorBrush x:Key="T.Subtle" Color="#20242C" />
      <SolidColorBrush x:Key="T.SubtleHover" Color="#2A2F39" />
      <SolidColorBrush x:Key="T.Accent" Color="#5B9BFF" />
      <SolidColorBrush x:Key="T.AccentHover" Color="#7AAEFF" />
      <SolidColorBrush x:Key="T.Track" Color="#2A2F39" />
      <SolidColorBrush x:Key="T.Pill" Color="#20242C" />
      <SolidColorBrush x:Key="T.Banner" Color="#245B9BFF" />
      <SolidColorBrush x:Key="T.BannerBorder" Color="#4D5B9BFF" />
      <SolidColorBrush x:Key="T.WarnPill" Color="#1AFFB74D" />
      <SolidColorBrush x:Key="T.WarnText" Color="#FFCB7A" />
      <SolidColorBrush x:Key="T.Sidebar" Color="#0E1014" />
      <SolidColorBrush x:Key="T.NavHover" Color="#20242C" />
      <SolidColorBrush x:Key="T.NavSelected" Color="#1C2740" />
      <SolidColorBrush x:Key="T.Node" Color="#20242C" />
      <SolidColorBrush x:Key="T.NodeRing" Color="#3A404C" />
      <SolidColorBrush x:Key="T.Line" Color="#3A404C" />
      <SolidColorBrush x:Key="T.Selected" Color="#1A2740" />
      <SolidColorBrush x:Key="T.OkPill" Color="#1F3DD68C" />
      <SolidColorBrush x:Key="T.OkText" Color="#7EE2AE" />
      <SolidColorBrush x:Key="T.BadPill" Color="#24FF6B6B" />
      <SolidColorBrush x:Key="T.BadText" Color="#FF9B9B" />
      <SolidColorBrush x:Key="T.Panel" Color="#171A20" />
      <SolidColorBrush x:Key="T.Input" Color="#121419" />
      <SolidColorBrush x:Key="T.InputBorder" Color="#3A404C" />
      <SolidColorBrush x:Key="T.Tile" Color="#1B1F26" />
      <SolidColorBrush x:Key="T.Chip" Color="#20242C" />
      <SolidColorBrush x:Key="T.ChipDim" Color="#1B1E24" />
      <SolidColorBrush x:Key="T.Dash" Color="#3A404C" />
      <SolidColorBrush x:Key="T.TextSoft" Color="#8A92A2" />
      <SolidColorBrush x:Key="T.AccentButton" Color="#2F6FEB" />
      <SolidColorBrush x:Key="T.AccentButtonHover" Color="#4F82F0" />
      <SolidColorBrush x:Key="T.AccentSoft" Color="#245B9BFF" />
      <SolidColorBrush x:Key="T.AccentInk" Color="#9CC2FF" />
      <SolidColorBrush x:Key="T.Ok" Color="#3DD68C" />
      <SolidColorBrush x:Key="T.OkLine" Color="#8C3DD68C" />
      <SolidColorBrush x:Key="T.Warn" Color="#FFB547" />
      <SolidColorBrush x:Key="T.WarnBorder" Color="#4DFFB74D" />
      <SolidColorBrush x:Key="T.Bad" Color="#FF6B6B" />
      <SolidColorBrush x:Key="T.Off" Color="#5D6573" />
      <SolidColorBrush x:Key="T.Folder" Color="#F0B43C" />
      <SolidColorBrush x:Key="T.NeedsActive" Color="#FFB547" />
      <SolidColorBrush x:Key="T.NeedsActiveText" Color="#2B1A00" />
      <SolidColorBrush x:Key="T.Code" Color="#0A0C10" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Status colours: the same in both themes. -->
  <SolidColorBrush x:Key="S.Green" Color="#2EA043" />
  <SolidColorBrush x:Key="S.Blue" Color="#2176D6" />
  <SolidColorBrush x:Key="S.Grey" Color="#8A9099" />
  <SolidColorBrush x:Key="S.Orange" Color="#E66E14" />
  <SolidColorBrush x:Key="S.Red" Color="#CF222E" />
  <SolidColorBrush x:Key="S.Yellow" Color="#D6A021" />
</ResourceDictionary>
