<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Pairnets.Desktop.Views"
             xmlns:core="using:Pairnets.Core"
             x:Class="Pairnets.Desktop.Views.SettingsView">
  <!-- The Settings page: a header with Cancel and Save, then two columns of cards (one column when the window is narrow). -->
  <Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="PageTitle" Text="Settings" />
        <TextBlock Classes="t2" Margin="0,2,0,0" TextWrapping="Wrap" FontSize="13" Text="Your nest, the folder, and how Pairnets behaves on this computer." />
      </StackPanel>
      <Button Grid.Column="1" Classes="SecondaryButton" Height="38" Padding="16,0" Margin="8,0" VerticalAlignment="Center" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="SaveButton" Grid.Column="2" Classes="accent" Height="38" Padding="18,0" VerticalAlignment="Center" IsDefault="True" Click="OnSave">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Classes="icon white" Width="15" Height="15" StrokeThickness="2.6" Data="{StaticResource I.Check}" />
          <TextBlock Text="Save" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="OnScrollWheel">
      <StackPanel x:Name="Form" Spacing="16" Margin="0,0,0,8">
        <Grid x:Name="Columns" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
          <!-- ======== Left column ======== -->
          <StackPanel x:Name="LeftColumn" Spacing="16" Margin="0,0,8,0">
            <!-- Your nest -->
            <Border Classes="pcard" Padding="20,16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Margin="0,0,8,0" Data="{StaticResource I.Nest}" />
                  <TextBlock x:Name="ServerHeading" Grid.Column="1" Classes="stitle" Text="Your nest" VerticalAlignment="Center" />
                  <Border x:Name="ConnectedPill" Grid.Column="2" Classes="pillok" Height="24" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="7" Height="7" Fill="{DynamicResource T.OkText}" VerticalAlignment="Center" />
                      <TextBlock Text="Connected" />
                    </StackPanel>
                  </Border>
                </Grid>
                <!-- Signed in with this computer's own key: who it is, and signing out. -->
                <StackPanel x:Name="SignedInPanel" IsVisible="False" Spacing="14">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="40" Height="40" CornerRadius="12" Classes="tint-accent" Margin="0,0,12,0">
                      <TextBlock x:Name="AvatarText" FontSize="17" FontWeight="ExtraBold" Foreground="{DynamicResource T.AccentInk}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="NestHostText" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="SignedInText" Classes="t2" FontSize="13" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <WrapPanel>
                    <Button x:Name="SignInAgainButton" Classes="chipbtn" Margin="0,0,8,8">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <v:LineIcon Classes="icon" Width="15" Height="15" Data="{StaticResource I.Retry}" />
                        <TextBlock Text="Sign in again" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="chipbtn redtext" Margin="0,0,8,8" Click="OnSignOut" ToolTip.Tip="Sign out of this computer">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <v:LineIcon Classes="icon ink-bad" Width="15" Height="15" Data="{StaticResource I.Logout}" />
                        <TextBlock Text="Sign out" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Classes="chipbtn" Margin="0,0,0,8" Click="OnManageDevices">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <v:LineIcon Classes="icon" Width="15" Height="15" Data="{StaticResource I.External}" />
                        <TextBlock Text="Manage devices on the web" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                  <Button x:Name="ShowAddressButton" Classes="link" HorizontalAlignment="Left" Margin="-6,-6,0,0" Content="Advanced: server address and token ▸" Click="OnShowAddress" />
                </StackPanel>
                <StackPanel x:Name="AddressFields" Spacing="10">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="Server address" />
                    <TextBox x:Name="ServerUrlBox" Classes="field" Watermark="https://sync.example.com/" />
                  </StackPanel>
                  <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="Token" />
                    <TextBox x:Name="TokenBox" Classes="field" PasswordChar="•" />
                  </StackPanel>
                  <Grid ColumnDefinitions="Auto,*">
                    <Button x:Name="TestButton" Classes="chipbtn" Content="Test connection" Click="OnTest" VerticalAlignment="Top" />
                    <Border x:Name="TestChip" Grid.Column="1" Margin="10,0,0,0" IsVisible="False" HorizontalAlignment="Left">
                      <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
                    </Border>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- This computer -->
            <Border Classes="pcard" Padding="20,16">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Data="{StaticResource I.Desktop}" />
                  <TextBlock Classes="stitle" Text="This computer" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" FontWeight="Bold" Text="Folder to keep in sync" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="FolderBox" Classes="field" Height="38" MinHeight="38" CornerRadius="11" Watermark="Choose a folder…">
                      <TextBox.InnerLeftContent>
                        <v:LineIcon Classes="icon" Stroke="{DynamicResource T.Folder}" Width="16" Height="16" Margin="12,0,0,0" Data="{StaticResource I.Folder}" />
                      </TextBox.InnerLeftContent>
                    </TextBox>
                    <Button Grid.Column="1" Classes="chipbtn" Height="38" Margin="8,0,0,0" Content="Change…" Click="OnBrowse" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock FontSize="13" FontWeight="Bold" Text="This computer's name" />
                  <TextBox x:Name="DeviceBox" Classes="field" Height="38" MinHeight="38" CornerRadius="11" FontWeight="SemiBold" />
                  <TextBlock Classes="t3" TextWrapping="Wrap" Text="Use a different name on each computer. It shows in conflict file names." />
                </StackPanel>
                <Border Classes="hair" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Start Pairnets when I log in" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="AutoStartBox" Grid.Column="1" Classes="bare" OnContent="Start Pairnets when I log in" OffContent="Start Pairnets when I log in" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="FileManagerTitle" Text="Show Pairnets in the file manager" FontWeight="SemiBold" />
                    <TextBlock x:Name="FileManagerText" Classes="t3" TextWrapping="Wrap"
                               Text="In the sidebar, with right-click items and a Pairnets folder icon. Your files are not changed." />
                  </StackPanel>
                  <ToggleSwitch x:Name="FileManagerBox" Grid.Column="1" Classes="bare" OnContent="Show Pairnets in the file manager" OffContent="Show Pairnets in the file manager" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Advanced: files to ignore -->
            <StackPanel>
              <Button x:Name="IgnoreHeader" Classes="rowbtn cardbtn" Padding="20,14" HorizontalContentAlignment="Stretch">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                  <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Margin="0,0,12,0" Data="{StaticResource I.Sliders}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="advtitle" Text="Advanced: files to ignore" />
                    <TextBlock Classes="t3" Text="Add your own rules on top of the usual ones." TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock x:Name="IgnoreCount" Grid.Column="2" Classes="t3" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                  <v:LineIcon x:Name="IgnoreChevron" Grid.Column="3" Classes="icon ink-soft" Width="14" Height="14" StrokeThickness="2.4" Data="{StaticResource I.ChevronDown}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Border x:Name="IgnorePanel" Classes="pcard" Padding="20,14" Margin="0,8,0,0" IsVisible="False">
                <StackPanel Spacing="6">
                  <TextBox x:Name="IgnoreBox" Classes="field" Height="86" AcceptsReturn="True" Watermark="One pattern per line, e.g. *.bak or node_modules/" />
                  <TextBlock Classes="t3" Text="Temporary and system files (~$*, *.tmp, Thumbs.db, .git/ …) are always ignored." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- ======== Right column ======== -->
          <StackPanel x:Name="RightColumn" Grid.Column="1" Spacing="16" Margin="8,0,0,0">
            <!-- Updates -->
            <Border Classes="pcard" Padding="20,16">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Margin="0,0,8,0" Data="{StaticResource I.Download}" />
                  <TextBlock Grid.Column="1" Classes="stitle" Text="Updates" VerticalAlignment="Center" />
                  <TextBlock x:Name="AppVersionText" Grid.Column="2" Classes="t3" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Check for updates by itself" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="t3" TextWrapping="Wrap" Text="Looks when Pairnets starts and once a day. You choose when to install." />
                  </StackPanel>
                  <ToggleSwitch x:Name="UpdateBox" Grid.Column="1" Classes="bare" OnContent="Check for updates by itself" OffContent="Check for updates by itself" />
                </Grid>
                <Border Background="{DynamicResource T.Chip}" CornerRadius="12" Padding="12,7,7,7">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <v:LineIcon Classes="icon ink-ok" Width="15" Height="15" StrokeThickness="2.4" Margin="0,0,10,0" Data="{StaticResource I.Check}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionText" Grid.Column="1" Classes="t2" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button x:Name="CheckNowButton" Grid.Column="2" Classes="small" Margin="10,0,0,0" FontWeight="Bold" Click="OnCheckNow">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <v:LineIcon Classes="icon" Width="13" Height="13" Data="{StaticResource I.Sync}" />
                        <TextBlock Text="Check now" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </Border>
                <Border Classes="hair" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Update the nest by itself" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="t3" TextWrapping="Wrap" Text="When your nest runs an older version it updates in about 30 seconds. Your files are never touched." />
                  </StackPanel>
                  <ToggleSwitch x:Name="AutoServerBox" Grid.Column="1" Classes="bare" OnContent="Update the nest by itself" OffContent="Update the nest by itself" />
                </Grid>
              </StackPanel>
            </Border>

            <!-- Speed -->
            <Border Classes="pcard" Padding="20,16">
              <StackPanel Spacing="14">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Data="{StaticResource I.Bolt}" />
                  <TextBlock Classes="stitle" Text="Speed" VerticalAlignment="Center" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wait when another computer sends a lot" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="t3" TextWrapping="Wrap" Text="Over 100 files: get them in one go at the end." />
                  </StackPanel>
                  <ToggleSwitch x:Name="WaitBox" Grid.Column="1" Classes="bare" OnContent="Wait when another computer sends a lot" OffContent="Wait when another computer sends a lot" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Files at the same time" FontWeight="SemiBold" />
                    <TextBlock Classes="t3" TextWrapping="Wrap" Text="4 suits most connections." />
                  </StackPanel>
                  <Border Grid.Column="1" Classes="numsegs" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="Par1" Classes="numseg" GroupName="par" Content="1" />
                      <RadioButton x:Name="Par2" Classes="numseg" GroupName="par" Content="2" />
                      <RadioButton x:Name="Par4" Classes="numseg" GroupName="par" Content="4" />
                      <RadioButton x:Name="Par8" Classes="numseg" GroupName="par" Content="8" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="hair" />
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="34">
                    <ToggleSwitch x:Name="UpLimitBox" Classes="bare" Margin="-12,0,0,0" OnContent="Limit upload to" OffContent="Limit upload to" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Limit upload to" FontWeight="SemiBold" VerticalAlignment="Center" Margin="-4,0,0,0" />
                    <TextBox x:Name="UpLimitValue" Grid.Column="2" Classes="field" Width="64" Height="34" MinHeight="34" CornerRadius="10" Padding="10,0" Text="5" TextAlignment="Right" FontWeight="Bold"
                             IsVisible="{Binding #UpLimitBox.IsChecked}" />
                    <TextBlock Grid.Column="3" Text="MB/s" Classes="t2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding #UpLimitBox.IsChecked}" />
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="No limit" Classes="t3" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"
                               IsVisible="{Binding !#UpLimitBox.IsChecked}" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="34">
                    <ToggleSwitch x:Name="DownLimitBox" Classes="bare" Margin="-12,0,0,0" OnContent="Limit download from" OffContent="Limit download from" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Limit download" FontWeight="SemiBold" VerticalAlignment="Center" Margin="-4,0,0,0" />
                    <TextBox x:Name="DownLimitValue" Grid.Column="2" Classes="field" Width="64" Height="34" MinHeight="34" CornerRadius="10" Padding="10,0" Text="10" TextAlignment="Right" FontWeight="Bold"
                             IsVisible="{Binding #DownLimitBox.IsChecked}" />
                    <TextBlock Grid.Column="3" Text="MB/s" Classes="t2" FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding #DownLimitBox.IsChecked}" />
                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Text="No limit" Classes="t3" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"
                               IsVisible="{Binding !#DownLimitBox.IsChecked}" />
                  </Grid>
                  <TextBlock Classes="t3" TextWrapping="Wrap" Text="Includes files from your other computers: they always come through your nest." />
                </StackPanel>
                <Border Classes="hair" />
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Show speed on the map" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="t3" TextWrapping="Wrap" Text="Shows how fast files move (MB/s) on the lines between the computers on the overview." />
                  </StackPanel>
                  <ToggleSwitch x:Name="MapSpeedBox" Grid.Column="1" Classes="bare" OnContent="Show speed on the map" OffContent="Show speed on the map" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- Help -->
        <Border Classes="pcard">
          <Grid x:Name="HelpGrid" ColumnDefinitions="*,*">
            <Button x:Name="ReportBugButton" Classes="rowbtn" Click="OnReportBug" Padding="20,14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="sq34" Margin="0,0,12,0"><v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Bang}" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Report a bug…" FontWeight="Bold" />
                  <TextBlock Classes="t3" Text="Makes a report to paste. Nothing is sent." TextWrapping="Wrap" />
                </StackPanel>
                <v:LineIcon Grid.Column="2" Classes="icon ink-dim" Width="14" Height="14" StrokeThickness="2.4" Data="{StaticResource I.ChevronRight}" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource T.Border}" Padding="20,14">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="sq34" Margin="0,0,12,0"><v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Terminal}" /></Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Debug mode" FontWeight="Bold" />
                  <TextBlock Classes="t3" Text="Writes more detail to the log and shows the nest's update log." TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch x:Name="DebugBox" Grid.Column="2" Classes="bare" OnContent="Debug mode" OffContent="Debug mode" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <!-- Start over -->
        <Border x:Name="StartOverCard" Classes="pcard dangercard" Padding="20,18">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Classes="sq44 tint-bad" Margin="0,0,16,0" VerticalAlignment="Center">
              <v:LineIcon Classes="icon ink-bad" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.Restore}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="stitle" Text="Start over" />
              <TextBlock Classes="t2" FontSize="13" TextWrapping="Wrap"
                         Text="Forgets every setting and signs this computer out of your nest, then opens the sign-in screen so you can set it up again." />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <v:LineIcon Classes="icon ink-ok" Width="13" Height="13" StrokeThickness="2.6" Data="{StaticResource I.Check}" VerticalAlignment="Center" />
                <TextBlock x:Name="StartOverNote" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            <Button x:Name="ResetButton" Grid.Column="2" Classes="reset" Height="38" Padding="16,0" Margin="16,0,0,0" VerticalAlignment="Center" Content="Reset this app…" Click="OnReset" />
          </Grid>
        </Border>

        <!-- About: version and licence, and the website's help and legal pages (each link's CommandParameter is its address) -->
        <Border Classes="pcard" Padding="20,16">
          <StackPanel Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" Data="{StaticResource I.Info}" />
              <TextBlock Classes="stitle" Text="About Pairnets" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="AboutText" Classes="t3" TextWrapping="Wrap" />
            <WrapPanel x:Name="AboutLinks" Margin="-6,0,0,0">
              <Button x:Name="DonateLink" Classes="link" Content="Support Pairnets ♥" CommandParameter="{x:Static core:PairnetsLinks.Donate}" Click="OnAboutLink" />
              <Button x:Name="HelpLink" Classes="link" Content="Help" CommandParameter="{x:Static core:PairnetsLinks.Help}" Click="OnAboutLink" />
              <Button x:Name="FaqLink" Classes="link" Content="FAQ" CommandParameter="{x:Static core:PairnetsLinks.Faq}" Click="OnAboutLink" />
              <Button x:Name="ContactLink" Classes="link" Content="Contact" CommandParameter="{x:Static core:PairnetsLinks.Contact}" Click="OnAboutLink" />
              <Button x:Name="PrivacyLink" Classes="link" Content="Privacy" CommandParameter="{x:Static core:PairnetsLinks.Privacy}" Click="OnAboutLink" />
              <Button x:Name="TermsLink" Classes="link" Content="Terms" CommandParameter="{x:Static core:PairnetsLinks.Terms}" Click="OnAboutLink" />
              <Button x:Name="GuidelinesLink" Classes="link" Content="Guidelines" CommandParameter="{x:Static core:PairnetsLinks.Guidelines}" Click="OnAboutLink" />
              <Button x:Name="CookiesLink" Classes="link" Content="Cookie settings" CommandParameter="{x:Static core:PairnetsLinks.Cookies}" Click="OnAboutLink" />
              <Button x:Name="SecurityLink" Classes="link" Content="Security" CommandParameter="{x:Static core:PairnetsLinks.Security}" Click="OnAboutLink" />
              <Button x:Name="LicensesLink" Classes="link" Content="Open-source licences" CommandParameter="{x:Static core:PairnetsLinks.Licenses}" Click="OnAboutLink" />
              <Button x:Name="DeleteAccountLink" Classes="link" Content="Delete my account" CommandParameter="{x:Static core:PairnetsLinks.DeleteAccount}" Click="OnAboutLink" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <TextBlock x:Name="ServerVersionText" Classes="t3" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
