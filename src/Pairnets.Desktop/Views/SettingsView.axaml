<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Pairnets.Desktop.Views"
             x:Class="Pairnets.Desktop.Views.SettingsView">
  <!-- Inside the main window, which has its own margins. Rows: a label on the left, the controls on the right. -->
  <DockPanel>
    <!-- Save and Cancel stay at the bottom while the form scrolls. -->
    <Border DockPanel.Dock="Bottom" Classes="hairline" Padding="0,14,16,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
        <Button x:Name="SaveButton" Classes="accent" Content="Save" IsDefault="True" Click="OnSave" />
      </StackPanel>
    </Border>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="OnScrollWheel">
      <StackPanel x:Name="Form" Margin="0,8,16,16">
        <!-- Server -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock x:Name="ServerHeading" Classes="setting-label" Text="Your server" />
            <StackPanel Grid.Column="1" Spacing="10">
              <!-- Signed in with this computer's own key: who it is (signing out is on the Account page). -->
              <StackPanel x:Name="SignedInPanel" IsVisible="False" Spacing="8">
                <TextBlock x:Name="SignedInText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <Button Classes="link" Content="Account settings" Click="OnAccount" />
                  <Button x:Name="ShowAddressButton" Classes="link" Content="Advanced: server address and token ▸" Click="OnShowAddress" />
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="AddressFields" Spacing="10">
                <StackPanel>
                  <TextBlock Classes="label" Text="Server address" />
                  <TextBox x:Name="ServerUrlBox" Watermark="https://sync.example.com/" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Classes="label" Text="Token" />
                  <TextBox x:Name="TokenBox" PasswordChar="•" />
                </StackPanel>
                <Grid ColumnDefinitions="Auto,*">
                  <Button x:Name="TestButton" Content="Test connection" Click="OnTest" VerticalAlignment="Top" />
                  <Border x:Name="TestChip" Grid.Column="1" Margin="10,0,0,0" IsVisible="False" HorizontalAlignment="Left">
                    <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
                  </Border>
                </Grid>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Folder -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Classes="setting-label" Text="Folder to keep in sync" Margin="0,9,24,0" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBox x:Name="FolderBox" Watermark="Choose a folder…" />
              <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
            </Grid>
          </Grid>
        </Border>

        <!-- This computer -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Classes="setting-label" Text="This computer" />
            <StackPanel Grid.Column="1" Spacing="14">
              <StackPanel>
                <TextBlock Classes="label" Text="Device name" />
                <TextBox x:Name="DeviceBox" />
                <TextBlock Classes="help" Margin="0,6,0,0" Text="Shown in conflict file names. Use a different name on each computer." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <ToggleSwitch x:Name="AutoStartBox" VerticalAlignment="Center" />
                <TextBlock Text="Start Pairnets when I log in" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Spacing="8">
                <Button x:Name="IgnoreToggle" Classes="link" HorizontalAlignment="Left" Content="Advanced: files to ignore ▸" Click="OnToggleIgnore" />
                <StackPanel x:Name="IgnorePanel" Spacing="6" IsVisible="False">
                  <TextBox x:Name="IgnoreBox" Height="76" AcceptsReturn="True" VerticalContentAlignment="Top" Watermark="One pattern per line, e.g. *.bak or node_modules/" />
                  <TextBlock Classes="help" Text="Temporary and system files (~$*, *.tmp, Thumbs.db, .git/ …) are always ignored." />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Updates and speed -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Classes="setting-label" Text="Updates and speed" />
            <StackPanel Grid.Column="1" Spacing="16">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <ToggleSwitch x:Name="UpdateBox" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Check for updates when Pairnets starts" />
                  <TextBlock Classes="help" Text="Looks for a new version on GitHub at start-up and once a day. Nothing is installed until you click Update." />
                  <TextBlock x:Name="VersionText" Classes="help" />
                </StackPanel>
                <Button x:Name="CheckNowButton" Grid.Column="2" Content="Check now" MinHeight="32" Padding="12,0" Margin="12,0,0,0" VerticalAlignment="Top" Click="OnCheckNow" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <ToggleSwitch x:Name="AutoServerBox" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Update the server automatically" />
                  <TextBlock Classes="help" Text="When this app finds the server on an older version, it updates it without asking (about 30 seconds; your files are not touched)." />
                  <TextBlock x:Name="ServerVersionText" Classes="help" />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <ToggleSwitch x:Name="DebugBox" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Debug mode" />
                  <TextBlock Classes="help" Text="Writes more detail to the log and shows the server's update log in the update window. Turn it on when updating the server does not work." />
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,*">
                <ToggleSwitch x:Name="WaitBox" VerticalAlignment="Top" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Spacing="2">
                  <TextBlock Text="Wait while my other computer uploads many files" />
                  <TextBlock Classes="help" Text="When the other computer sends more than 100 files, download them in one go after it finishes instead of a few at a time." />
                </StackPanel>
              </Grid>
              <StackPanel Spacing="6">
                <TextBlock Text="Files at the same time" />
                <Border Classes="segments" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <RadioButton x:Name="Par1" Classes="seg" GroupName="par" Content="1" />
                    <RadioButton x:Name="Par2" Classes="seg" GroupName="par" Content="2" />
                    <RadioButton x:Name="Par4" Classes="seg" GroupName="par" Content="4" />
                    <RadioButton x:Name="Par8" Classes="seg" GroupName="par" Content="8" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="help" Text="4 is fastest for most connections. Use 1 on a very slow or metered connection." />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Speed limits -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Classes="setting-label" Text="Speed limits" />
            <StackPanel Grid.Column="1" Spacing="8">
              <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                <CheckBox x:Name="UpLimitBox" Content="Limit upload to the server to" Margin="0,0,10,6" />
                <NumericUpDown x:Name="UpLimitValue" Grid.Column="1" Minimum="0.1" Maximum="10000" Increment="1" Value="5" FormatString="0.##" Width="120" Margin="0,0,8,6" />
                <TextBlock Grid.Column="2" Classes="muted" Text="MB/s" VerticalAlignment="Center" Margin="0,0,0,6" />
                <CheckBox x:Name="DownLimitBox" Grid.Row="1" Content="Limit download from the server to" Margin="0,0,10,0" />
                <NumericUpDown x:Name="DownLimitValue" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="10000" Increment="1" Value="10" FormatString="0.##" Width="120" Margin="0,0,8,0" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="MB/s" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="help" MaxWidth="560" HorizontalAlignment="Left"
                         Text="Files from your other computers always come through the server, so the download limit covers them too. All files at once stay under the limit together." />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Start over -->
        <Border Classes="hairline" Padding="0,16">
          <Grid ColumnDefinitions="200,*">
            <TextBlock Classes="setting-label" Text="Start over" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBlock Classes="help" Margin="0,0,18,0" VerticalAlignment="Center"
                         Text="Forgets every setting, signs this computer out of your nest and starts again from the sign-in screen. The files in your sync folder are never deleted." />
              <Button x:Name="ResetButton" Grid.Column="1" Classes="danger" Content="Reset this app…" VerticalAlignment="Center" Click="OnReset" />
            </Grid>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
