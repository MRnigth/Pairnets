<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views"
        x:Class="Pairnets.Desktop.Views.NestPlaceWindow"
        Title="Where your nest keeps files" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Icon="avares://Pairnets/Assets/pairnets-icon-256.png">
  <!-- Settings > Your nest > "Change…": the nest's drives, the choice, then how the move goes (looks like the nest update window). -->
  <Grid MinHeight="400">
    <Grid Margin="28,10,28,24" RowDefinitions="Auto,*">
      <!-- Header -->
      <Grid ColumnDefinitions="Auto,*">
        <!-- The round badge: a drive (a ring around it while the nest is asked or moves), pops when done -->
        <Panel Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
          <Arc x:Name="Ring" Classes="spin" Width="45" Height="45" StartAngle="-90" SweepAngle="100" StrokeThickness="3"
               Stroke="{DynamicResource T.Accent}" StrokeLineCap="Round" IsVisible="False" />
          <Ellipse x:Name="RingTrack" Width="45" Height="45" Stroke="{DynamicResource T.Track}" StrokeThickness="3" IsVisible="False" />
          <Panel x:Name="BadgeHost" Width="48" Height="48">
            <Border x:Name="Badge" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource T.AccentSoft}">
              <v:LineIcon x:Name="BadgeIcon" Width="22" Height="22" StrokeThickness="1.8" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Disk}" />
            </Border>
          </Panel>
        </Panel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock x:Name="Heading" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="Where your nest keeps files" />
          <TextBlock x:Name="Explanation" Classes="muted" FontSize="13" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <Panel Grid.Row="1">
        <!-- 1. The drives -->
        <Grid x:Name="ListPanel" RowDefinitions="Auto,*,Auto" Margin="0,20,0,0">
          <StackPanel x:Name="Drives" Spacing="8" />
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <v:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Shield}" />
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" Text="The old copy is kept until you delete it." />
            </StackPanel>
            <Button Grid.Column="1" Classes="SecondaryButton" MinHeight="40" Padding="18,0" Content="Close" Click="OnClose" />
          </Grid>
        </Grid>

        <!-- 2. Sure? -->
        <Grid x:Name="ConfirmPanel" RowDefinitions="Auto,*,Auto" Margin="0,20,0,0" IsVisible="False">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto,*">
              <Border Classes="card" CornerRadius="20" Padding="16,14" Background="{DynamicResource T.Card}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Disk}" />
                    <TextBlock FontSize="12" FontWeight="Bold" Classes="muted" Text="Now" />
                  </StackPanel>
                  <TextBlock x:Name="FromText" Classes="muted" FontSize="14" FontWeight="ExtraBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="FromSub" Classes="soft" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource T.AccentButton}" Margin="10,0">
                <v:LineIcon Width="18" Height="18" StrokeThickness="2.4" Stroke="White" Data="{StaticResource I.Arrow}" />
              </Border>
              <Border Grid.Column="2" CornerRadius="20" Padding="16,14" Background="{DynamicResource T.AccentSoft}"
                      BorderBrush="{DynamicResource T.BannerBorder}" BorderThickness="1">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Disk}" />
                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}" Text="Moves to" />
                  </StackPanel>
                  <TextBlock x:Name="ToText" FontSize="14" FontWeight="ExtraBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="ToSub" Classes="muted" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Margin="0,16,0,0" Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <v:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Clock2}" />
                <TextBlock Classes="muted" FontSize="13" Text="Your nest keeps running while they copy, then pauses for a moment." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <v:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Shield}" />
                <TextBlock Classes="muted" FontSize="13" Text="The old copy is kept until you delete it." />
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Classes="SecondaryButton" MinHeight="40" Content="Back" Click="OnBack" />
            <Button x:Name="MoveButton" Classes="accent" MinHeight="40" Click="OnMove">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <v:LineIcon Width="16" Height="16" StrokeThickness="2.2" Stroke="White" Data="{StaticResource I.Arrow}" />
                <TextBlock Text="Move the files" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- 3. Moving -->
        <Grid x:Name="BusyPanel" RowDefinitions="Auto,*,Auto" Margin="0,18,0,0" IsVisible="False">
          <Border Classes="card" Padding="18,14">
            <StackPanel>
              <Grid ColumnDefinitions="Auto,*">
                <TextBlock x:Name="ProgressText" FontSize="12" FontWeight="ExtraBold" Text="Copying your files… 0%" />
                <TextBlock x:Name="ProgressWhere" Grid.Column="1" Classes="soft" FontSize="12" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
              </Grid>
              <Border Height="6" CornerRadius="3" Background="{DynamicResource T.Track}" Margin="0,8,0,0">
                <Grid x:Name="BarGrid" ColumnDefinitions="0*,100*"><Border Height="6" CornerRadius="3" Background="{DynamicResource T.Accent}" /></Grid>
              </Border>
            </StackPanel>
          </Border>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <v:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
              <TextBlock Classes="muted" FontSize="12.5" TextWrapping="Wrap" MaxWidth="320" Text="You can close this window. The move carries on." />
            </StackPanel>
            <Button Grid.Column="1" Classes="SecondaryButton" MinHeight="40" Padding="18,0" Content="Close" Click="OnClose" />
          </Grid>
        </Grid>

        <!-- 4. Done or not moved -->
        <Grid x:Name="ResultPanel" RowDefinitions="Auto,*,Auto" Margin="0,20,0,0" IsVisible="False">
          <StackPanel x:Name="OldCopyPanel" IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <v:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Folder}" />
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="The old copy" />
            </StackPanel>
            <Border CornerRadius="16" Background="{DynamicResource T.Code}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" Padding="16,12,12,12" Margin="0,10,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <SelectableTextBlock x:Name="CommandText" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                     Margin="0,4,12,0" />
                <Button Grid.Column="1" Classes="accent" VerticalAlignment="Top" MinHeight="34" CornerRadius="10" Padding="14,0" Click="OnCopy">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{StaticResource I.Copy}" />
                    <TextBlock Text="Copy" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,12,0,0">
              <v:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Lock}" />
              <TextBlock Classes="muted" FontSize="12.5" Text="Run it on the nest when everything works, to free the space." />
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="RetryButton" Classes="SecondaryButton" MinHeight="40" Content="Try again" Click="OnRetry" IsVisible="False" />
            <Button x:Name="CloseButton" Classes="accent" MinHeight="40" Padding="22,0" Content="Close" Click="OnClose" />
          </StackPanel>
        </Grid>
      </Panel>
    </Grid>
  </Grid>
</Window>
