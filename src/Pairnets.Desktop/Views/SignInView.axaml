<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Pairnets.Desktop.Views"
             x:Class="Pairnets.Desktop.Views.SignInView">
  <!-- "Sign in with your browser": welcome → waiting for approval → choose the folder. -->
  <UserControl.Styles>
    <Style Selector="Button.big">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.big">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock.step-title">
      <Setter Property="FontSize" Value="26" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Panel>

      <!-- 1. Welcome: which nest, then the ways to sign in there -->
      <StackPanel x:Name="WelcomeStep" Spacing="0" Width="420" Margin="0,52,0,24" HorizontalAlignment="Center">
        <Image Source="avares://Pairnets/Assets/pairnets-icon-256.png" Width="52" Height="52" HorizontalAlignment="Center" />
        <TextBlock Text="Sign in" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.6" HorizontalAlignment="Center" Margin="0,18,0,0" />
        <TextBlock Classes="muted" FontSize="14" Text="Keep one folder the same on all your computers." HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Spacing="6" Margin="0,30,0,0">
          <TextBlock FontSize="13" FontWeight="SemiBold" Text="Your nest" />
          <TextBox x:Name="AddressBox" Classes="big" Watermark="nest.example.com" />
          <StackPanel x:Name="CheckRow" Orientation="Horizontal" Spacing="6" IsVisible="False">
            <v:LineIcon x:Name="CheckIcon" Classes="icon" Width="13" Height="13" StrokeThickness="2.8" VerticalAlignment="Top" Margin="0,2,0,0" />
            <TextBlock x:Name="CheckText" Classes="small" TextWrapping="Wrap" MaxWidth="390" />
          </StackPanel>
        </StackPanel>

        <!-- "Continue with Google": the browser signs in with Google right away -->
        <Button x:Name="GoogleButton" Classes="big" Margin="0,18,0,0" Click="OnGoogle" IsEnabled="False" IsVisible="False">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Width="18" Height="18" VerticalAlignment="Center">
              <Canvas Width="48" Height="48">
                <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                <Path Fill="#34A853" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                <Path Fill="#FBBC05" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <!-- or -->
        <Grid x:Name="OrRow" ColumnDefinitions="*,Auto,*" Margin="0,14,0,0" IsVisible="False">
          <Border Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="or" Margin="12,0" />
          <Border Grid.Column="2" Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
        </Grid>

        <!-- "Continue with email": a sign-in link lands in the owner's inbox -->
        <StackPanel x:Name="EmailPanel" Spacing="12" Margin="0,14,0,0" IsVisible="False">
          <TextBox x:Name="EmailBox" Classes="big" Watermark="Enter your email" IsEnabled="False" />
          <Button x:Name="EmailButton" Classes="accent big" Content="Continue with email" Click="OnEmail" IsEnabled="False" />
        </StackPanel>

        <!-- password, passkey, and everything else live on the nest's own page -->
        <Button x:Name="BrowserButton" Classes="accent big" Margin="0,12,0,0" Content="Sign in with your browser" Click="OnSignIn" IsEnabled="False" />

        <Border Classes="hairline" Margin="0,22,0,0" Padding="0,18,0,0">
          <TextBlock Classes="muted small" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                     Text="Your nest is your own server. New computers only get in when you allow them there." />
        </Border>
      </StackPanel>

      <!-- 2. Waiting: the code to compare, until it is approved on the nest -->
      <StackPanel x:Name="WaitStep" Spacing="0" Margin="70,64,70,24" MaxWidth="480" HorizontalAlignment="Left" IsVisible="False">
        <TextBlock Classes="step-title" Text="Approve this computer" />
        <TextBlock x:Name="WaitIntro" Classes="muted" FontSize="14" LineHeight="21" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Your browser opened your nest. Sign in there and check that it shows this code:" />
        <Border BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="12" Padding="12,24" Margin="0,22,0,0">
          <TextBlock x:Name="CodeText" FontSize="36" FontWeight="SemiBold" LetterSpacing="7" HorizontalAlignment="Center" />
        </Border>
        <StackPanel x:Name="WaitRow" Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
          <v:LineIcon x:Name="WaitIcon" Classes="icon accent spin" Width="17" Height="17" StrokeThickness="2.2" Data="{StaticResource I.Sync}" />
          <TextBlock x:Name="WaitText" FontSize="14" />
        </StackPanel>
        <TextBlock x:Name="WaitHint" Classes="muted small" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0"
                   Text="Your other computers show a “wants to join” notice too; it leads to the same page." />
        <Border x:Name="OutcomeBox" Classes="callout" Padding="12,10" Margin="0,14,0,0" IsVisible="False">
          <TextBlock x:Name="OutcomeText" TextWrapping="Wrap" />
        </Border>
        <WrapPanel x:Name="WaitButtons" Margin="0,22,0,0">
          <Button x:Name="OpenAgainButton" Content="Open the browser again" Margin="0,0,8,8" Click="OnOpenAgain" />
          <Button x:Name="CopyButton" Content="Copy link" Margin="0,0,8,8" Click="OnCopy" />
          <Button x:Name="RetryButton" Classes="accent" Content="Get a new code" Margin="0,0,8,8" Click="OnRetry" IsVisible="False" />
          <Button x:Name="BackButton" Classes="flat" Foreground="{DynamicResource T.Muted}" Content="Cancel" Margin="0,0,8,8" Click="OnBack" />
        </WrapPanel>
      </StackPanel>

      <!-- 3. Signed in: which folder to keep in sync -->
      <StackPanel x:Name="FolderStep" Spacing="0" Margin="70,64,70,24" MaxWidth="480" HorizontalAlignment="Left" IsVisible="False">
        <Border Classes="pill ok" HorizontalAlignment="Left" Padding="12,5">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <v:LineIcon Classes="icon" Width="13" Height="13" StrokeThickness="2.8" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.Check}" VerticalAlignment="Center" />
            <TextBlock x:Name="SignedInText" FontSize="13" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Classes="step-title" Text="Choose the folder to keep in sync" Margin="0,18,0,0" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,22,0,0">
          <TextBox x:Name="FolderBox" Classes="big" Watermark="Choose a folder…" />
          <Button Grid.Column="1" Content="Browse…" MinHeight="40" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>
        <TextBlock Classes="help" Margin="0,8,0,0"
                   Text="Files on your nest are copied here. Files already in this folder are kept and merged, never replaced." />
        <Border Classes="hairline" BorderThickness="0,1,0,1" Padding="0,16" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ToggleSwitch x:Name="AutoStartBox" VerticalAlignment="Center" />
            <TextBlock Text="Start Pairnets when I log in" FontSize="14" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <Button x:Name="StartButton" Classes="accent" HorizontalAlignment="Right" MinHeight="42" Padding="22,0" FontSize="14" Margin="0,22,0,0"
                Content="Start syncing" Click="OnStart" />
      </StackPanel>

    </Panel>
  </ScrollViewer>
</UserControl>
