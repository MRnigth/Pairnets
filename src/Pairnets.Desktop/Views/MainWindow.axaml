<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views"
        xmlns:c="using:Pairnets.Core.Client"
        x:Class="Pairnets.Desktop.Views.MainWindow"
        Title="Pairnets" Width="980" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="avares://Pairnets/Assets/pairnets-icon-256.png">
  <Window.Resources>
    <v:ActivityBrushConverter x:Key="KindBrush" />
    <v:ActivityIconConverter x:Key="KindIcon" />
  </Window.Resources>

  <Window.DataTemplates>
    <!-- Activity rows and day headings (Overview and Activity pages) -->
    <DataTemplate DataType="c:ActivityDay">
      <TextBlock Classes="day" Text="{Binding Text}" />
    </DataTemplate>
    <DataTemplate DataType="c:ActivityItem">
      <Border Classes="row enter" ToolTip.Tip="{Binding TimeText}" Background="Transparent">
        <Border.ContextMenu>
          <ContextMenu IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
            <MenuItem Header="Show in folder" Click="OnRevealActivity" />
            <MenuItem Header="Show versions…" Click="OnActivityVersions" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Grid Width="30" Height="30" Margin="0,0,12,0">
            <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
            <v:LineIcon Classes="icon white" Width="19" Height="19" StrokeThickness="2.6"
                        Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Primary}" Classes="strong" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Secondary}" Classes="muted small" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted small" VerticalAlignment="Center" Margin="12,0,4,0" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="Root" ColumnDefinitions="320,*">
    <!-- ======================= Left side, open ======================= -->
    <Grid x:Name="SideOpen" Margin="12,12,0,12">
      <Border Classes="sidepanel">
        <DockPanel Margin="14,16,14,14">
          <!-- Top: logo, fold, account -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0,0,0">
            <Image x:Name="AppIcon" Source="avares://Pairnets/Assets/pairnets-icon-256.png" Width="30" Height="30" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Pairnets" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
            <Button x:Name="FoldButton" Grid.Column="2" Classes="RoundIconButton" Width="32" Height="32" Margin="0,0,8,0"
                    ToolTip.Tip="Fold into the dock" AutomationProperties.Name="Fold into the dock" Click="OnFoldSide">
              <v:LineIcon Classes="icon" Width="16" Height="16" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.FoldLeft}" />
            </Button>
            <Button x:Name="AccountButton" Grid.Column="3" Classes="RoundIconButton" Width="32" Height="32"
                    Background="{DynamicResource T.AccentSoft}" Foreground="{DynamicResource T.AccentInk}" Click="OnAccount">
              <TextBlock x:Name="AccountInitial" Text="A" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>

          <!-- Bottom: the app update, then the page tiles -->
          <StackPanel DockPanel.Dock="Bottom">
            <Border x:Name="UpdateCard" Background="{DynamicResource T.AccentSoft}" CornerRadius="14" Padding="12,8,8,8" Margin="0,10,0,0" IsVisible="False">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <v:LineIcon x:Name="UpdateIcon" Classes="icon bob" Width="16" Height="16" StrokeThickness="2.2" Margin="0,0,8,0" VerticalAlignment="Center"
                              Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Download}" />
                  <TextBlock x:Name="UpdateTitle" Grid.Column="1" FontWeight="ExtraBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                  <TextBlock x:Name="UpdatePercent" Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}"
                             VerticalAlignment="Center" Margin="8,0,4,0" IsVisible="False" />
                  <Button x:Name="UpdateButton" Grid.Column="3" Classes="accent small" Content="Update" Margin="8,0,0,0" Click="OnUpdateNow" />
                  <Button x:Name="UpdateLater" Grid.Column="4" Classes="RoundIconButton" Width="26" Height="26" Margin="4,0,0,0" Background="Transparent"
                          ToolTip.Tip="Later" AutomationProperties.Name="Later" Click="OnUpdateLater">
                    <v:LineIcon Classes="icon" Width="12" Height="12" StrokeThickness="2.4" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Close}" />
                  </Button>
                </Grid>
                <ProgressBar x:Name="UpdateProgress" Classes="thin" Minimum="0" Maximum="100" Margin="0,8,4,2" IsVisible="False" />
              </StackPanel>
            </Border>

            <TextBlock Classes="SmallLabel" Text="PAGES" Margin="4,16,0,4" />
            <UniformGrid Columns="2" Margin="-4,0,-4,0">
              <RadioButton x:Name="NavOverview" Classes="sidetile" GroupName="page" IsChecked="True" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Overview" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Home}" />
                  <TextBlock x:Name="OverviewNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavActivity" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Activity" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Activity}" />
                  <TextBlock x:Name="ActivityNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavAttention" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Needs you" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Warning}" />
                  <TextBlock x:Name="AttentionCount" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavHistory" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="History" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.History}" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavDevices" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Devices" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Desktop}" />
                  <TextBlock x:Name="DevicesNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavSettings" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Settings" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Gear}" StrokeThickness="1.8" />
                </Grid>
              </RadioButton>
            </UniformGrid>
          </StackPanel>

          <!-- Your computers (scrolls when the window is short) -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Classes="SmallLabel" Text="YOUR COMPUTERS" Margin="4,16,0,8" />

              <!-- This computer -->
              <Button x:Name="ThisCard" Classes="siderow" Background="Transparent" Click="OnThisComputer">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*">
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                      <Border x:Name="ThisIconSq" Classes="IconSquare" />
                      <v:LineIcon x:Name="ThisIcon" Classes="icon" Width="17" Height="17" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                      <Ellipse x:Name="ThisDot" Width="10" Height="10" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="ThisName" FontWeight="ExtraBold" Text="DESKTOP" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="ThisSub" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar x:Name="ThisBar" Classes="thin" Minimum="0" Maximum="100" Margin="0,9,0,0" IsVisible="False" />
                </StackPanel>
              </Button>

              <!-- The nest -->
              <Button x:Name="NestRow" Classes="siderow" Background="Transparent" Margin="0,6,0,0" Click="OnNestRow">
                <Grid ColumnDefinitions="Auto,*">
                  <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Classes="IconSquare" />
                    <v:LineIcon Classes="icon" Width="17" Height="17" StrokeThickness="1.8" Data="{StaticResource I.Nest}" />
                    <Ellipse x:Name="NestDot" Width="10" Height="10" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="ExtraBold" Text="Your nest" />
                    <TextBlock x:Name="NestSub" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Other computers, as one group -->
              <Border Background="{DynamicResource T.Tile}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="16" Padding="12,10" Margin="0,6,0,0">
                <StackPanel>
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="Other computers" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="GroupNote" Grid.Column="1" Classes="SoftText" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="GroupFold" Grid.Column="2" Classes="RoundIconButton" Width="24" Height="24" Background="Transparent"
                            ToolTip.Tip="Fold the group" AutomationProperties.Name="Fold the group" Click="OnFoldGroup">
                      <v:LineIcon x:Name="GroupFoldIcon" Classes="icon" Width="14" Height="14" StrokeThickness="2.4" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.ChevronUp}" />
                    </Button>
                  </Grid>
                  <UniformGrid x:Name="GroupGrid" Columns="3" Margin="-2,6,-2,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ======================= Left side, folded into the dock ======================= -->
    <Grid x:Name="SideDock" RowDefinitions="Auto,*,Auto" Margin="0,18" IsVisible="False">
      <StackPanel HorizontalAlignment="Center">
        <Image x:Name="DockIcon" Source="avares://Pairnets/Assets/pairnets-icon-256.png" Width="38" Height="38" />
        <Button x:Name="DockUnfold" Classes="RoundIconButton" Width="32" Height="32" Margin="0,10,0,0"
                ToolTip.Tip="Open the side panel" AutomationProperties.Name="Open the side panel" Click="OnUnfoldSide">
          <v:LineIcon Classes="icon" Width="16" Height="16" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.FoldRight}" />
        </Button>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- Pages -->
          <Border Classes="dockpill">
            <StackPanel>
              <RadioButton x:Name="DockOverview" Classes="dockpage" GroupName="dock" IsChecked="True" ToolTip.Tip="Overview" AutomationProperties.Name="Overview" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Home}" />
              </RadioButton>
              <RadioButton x:Name="DockActivity" Classes="dockpage" GroupName="dock" ToolTip.Tip="Activity" AutomationProperties.Name="Activity" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Activity}" />
              </RadioButton>
              <Grid>
                <RadioButton x:Name="DockAttention" Classes="dockpage" GroupName="dock" ToolTip.Tip="Needs you" AutomationProperties.Name="Needs you" IsCheckedChanged="OnNav">
                  <v:LineIcon Data="{StaticResource I.Warning}" />
                </RadioButton>
                <Border x:Name="DockBadge" Width="20" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource T.Card}" Background="{DynamicResource T.NeedsActive}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False" IsVisible="False">
                  <TextBlock x:Name="DockBadgeText" Foreground="{DynamicResource T.NeedsActiveText}" FontSize="10" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <RadioButton x:Name="DockHistory" Classes="dockpage" GroupName="dock" ToolTip.Tip="History" AutomationProperties.Name="History" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.History}" />
              </RadioButton>
              <RadioButton x:Name="DockDevices" Classes="dockpage" GroupName="dock" ToolTip.Tip="Devices" AutomationProperties.Name="Devices" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Desktop}" />
              </RadioButton>
              <Border Classes="divider" Width="24" Margin="0,4" />
              <RadioButton x:Name="DockSettings" Classes="dockpage" GroupName="dock" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Gear}" StrokeThickness="1.8" />
              </RadioButton>
            </StackPanel>
          </Border>

          <!-- Computers -->
          <Border Classes="dockpill" Margin="0,12,0,0">
            <StackPanel>
              <Button x:Name="DockThis" Classes="dockbtn" Background="{DynamicResource T.AccentSoft}" Click="OnThisComputer">
                <Grid Width="44" Height="44">
                  <Ellipse x:Name="DockRingTrack" Stroke="{DynamicResource T.Track}" StrokeThickness="2.5" IsVisible="False" Margin="1" />
                  <Ellipse x:Name="DockRing" Stroke="{DynamicResource T.Accent}" StrokeThickness="2.5" StrokeLineCap="Round" RenderTransformOrigin="50%,50%" IsVisible="False" Margin="1">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <v:LineIcon x:Name="DockThisIcon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                </Grid>
              </Button>
              <Button x:Name="DockNest" Classes="dockbtn" Click="OnNestRow">
                <Grid Width="44" Height="44">
                  <v:LineIcon Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Nest}" />
                  <Ellipse x:Name="DockNestDot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockOther1" Classes="dockbtn" Click="OnDevices">
                <Grid Width="44" Height="44">
                  <v:LineIcon x:Name="DockOther1Icon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                  <Ellipse x:Name="DockOther1Dot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockOther2" Classes="dockbtn" Click="OnDevices">
                <Grid Width="44" Height="44">
                  <v:LineIcon x:Name="DockOther2Icon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                  <Ellipse x:Name="DockOther2Dot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockMore" Classes="dockbtn" Background="{DynamicResource T.Hover}" BorderBrush="{DynamicResource T.Dash}" BorderThickness="1.5" Click="OnDevices"
                      FontSize="13" FontWeight="ExtraBold">
                <TextBlock x:Name="DockMoreText" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Button x:Name="DockAccount" Grid.Row="2" Classes="RoundIconButton" Width="42" Height="42" HorizontalAlignment="Center"
              Background="{DynamicResource T.AccentSoft}" Foreground="{DynamicResource T.AccentInk}" Click="OnAccount">
        <TextBlock x:Name="DockAccountInitial" Text="A" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </Grid>

    <!-- ======================= Page ======================= -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="28,22,28,0">
        <TextBlock x:Name="PageTitle" Classes="title" Text="Overview" VerticalAlignment="Center" />
        <TextBlock x:Name="PageSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="subtle" Click="OnOpenFolder" ToolTip.Tip="Open the synced folder">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Folder}" />
              <TextBlock Text="Open folder" />
            </StackPanel>
          </Button>
          <Button Classes="subtle" Click="OnPause">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon x:Name="PauseGlyph" Classes="icon" Width="17" Height="17" Data="{StaticResource I.Pause}" />
              <TextBlock x:Name="PauseText" Text="Pause" />
            </StackPanel>
          </Button>
          <Button Classes="accent" Click="OnSyncNow">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon Classes="icon white" Width="17" Height="17" Data="{StaticResource I.Sync}" />
              <TextBlock Text="Sync now" />
            </StackPanel>
          </Button>
          <Button Classes="icon" ToolTip.Tip="More">
            <v:LineIcon Classes="icon" Width="18" Height="18" StrokeThickness="3.2" Data="{StaticResource I.More}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="View log" Click="OnViewLog" />
                <MenuItem Header="Report a bug…" Click="OnReportBug" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <Panel Grid.Row="1">
        <!-- ============ Overview ============ -->
        <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
          <v:OverviewView x:Name="Overview" />
        </ScrollViewer>

        <!-- ============ Activity ============ -->
        <Border x:Name="ActivityPage" Classes="card" Margin="28,18,28,24" Padding="8,4,8,8" IsVisible="False">
          <Grid>
            <ScrollViewer x:Name="ActivityPanel">
              <ItemsControl x:Name="ActivityList" />
            </ScrollViewer>
            <StackPanel x:Name="ActivityEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Activity}" HorizontalAlignment="Center" />
              <TextBlock Classes="muted" Text="Nothing has happened yet. Changes appear here as they sync." />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============ History ============ -->
        <Grid x:Name="HistoryPage" RowDefinitions="Auto,*" Margin="28,18,28,24" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Border Classes="segments">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DeletedTab" Classes="seg" GroupName="history" IsChecked="True" IsCheckedChanged="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.Trash}" />
                    <TextBlock Text="Deleted files" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilesTab" Classes="seg" GroupName="history" IsCheckedChanged="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.File}" />
                    <TextBlock Text="All files" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <TextBox x:Name="HistorySearch" Grid.Column="1" Margin="12,0,8,0" Watermark="Search by name or folder"
                     TextChanged="OnHistorySearch" VerticalContentAlignment="Center">
              <TextBox.InnerLeftContent>
                <v:LineIcon Classes="icon muted" Width="15" Height="15" Margin="10,0,0,0" Data="{StaticResource I.Search}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Reload from the server" Click="OnHistoryReload">
              <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Sync}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="11*,10*">
            <Border Classes="card" Padding="8" Margin="0,0,7,0">
              <Grid RowDefinitions="Auto,*">
                <TextBlock x:Name="HistorySummary" Classes="muted small" Margin="8,4,8,6" />
                <ListBox x:Name="FileList" Grid.Row="1" Classes="rows" SelectionChanged="OnFileSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="c:ServerFile">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource T.Pill}" Margin="0,0,11,0">
                          <Panel>
                            <v:LineIcon Classes="icon" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.File}" IsVisible="{Binding !Deleted}" />
                            <v:LineIcon Classes="icon" Width="17" Height="17" StrokeThickness="2" Stroke="{StaticResource S.Red}" Data="{StaticResource I.Trash}" IsVisible="{Binding Deleted}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                          <TextBlock Text="{Binding Name}" Classes="strong" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Secondary}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="HistoryMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="False">
                  <v:LineIcon x:Name="HistoryMessageIcon" Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.History}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="HistoryMessageText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
                  <Button x:Name="HistoryRetry" Classes="subtle" Content="Try again" HorizontalAlignment="Center" Click="OnHistoryReload" IsVisible="False" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Margin="7,0,0,0" Padding="18,16">
              <Grid>
                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                  <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Restore}" HorizontalAlignment="Center" />
                  <TextBlock Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                             Text="Choose a file to see the versions the server keeps, and get one back." />
                </StackPanel>
                <DockPanel x:Name="DetailPanel" IsVisible="False">
                  <StackPanel DockPanel.Dock="Top" Spacing="3">
                    <TextBlock x:Name="DetailName" Classes="h2" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailFolder" Classes="muted small" TextWrapping="Wrap" />
                    <Border x:Name="DetailStatePill" Classes="pill" HorizontalAlignment="Left" Margin="0,8,0,0">
                      <TextBlock x:Name="DetailState" FontSize="12" />
                    </Border>
                    <Border x:Name="RestoreMessage" Margin="0,10,0,0" IsVisible="False">
                      <TextBlock x:Name="RestoreMessageText" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <TextBlock Classes="caps" Text="VERSIONS ON THE SERVER" Margin="0,16,0,4" />
                  </StackPanel>
                  <Grid>
                    <ScrollViewer>
                      <ItemsControl x:Name="VersionList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="c:VersionRow">
                            <Border Classes="row enter">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource T.Line}" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                  <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="subtle" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnRestore" Tag="{Binding}">
                                  <StackPanel Orientation="Horizontal" Spacing="6">
                                    <v:LineIcon Classes="icon" Width="15" Height="15" Data="{StaticResource I.Restore}" />
                                    <TextBlock Text="Restore" />
                                  </StackPanel>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="VersionsMessage" Classes="muted" TextWrapping="Wrap" Margin="8" IsVisible="False" />
                  </Grid>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ============ Devices: every computer that uses the server ============ -->
        <Border x:Name="DevicesPage" Classes="card" Margin="28,18,28,24" Padding="8" IsVisible="False">
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer x:Name="DevicesPanel" IsVisible="False">
              <ItemsControl x:Name="DevicesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="c:DeviceRowView">
                    <Border Classes="row enter" Padding="10,10">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="40" Height="40" Margin="0,0,14,0">
                          <Ellipse Classes="ring" />
                          <v:LineIcon Classes="icon" Width="20" Height="20" StrokeThickness="1.9" Data="{StaticResource I.Computer}" />
                          <Ellipse Classes="dot" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Fill="{StaticResource S.Green}" IsVisible="{Binding Online}" />
                          <Ellipse Classes="dot" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Fill="{StaticResource S.Grey}" IsVisible="{Binding !Online}" />
                        </Panel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Title}" Classes="strong" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="pill" VerticalAlignment="Center" Margin="12,0,4,0">
                          <TextBlock Text="{Binding StatusText}" FontSize="12" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
              <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Server}" HorizontalAlignment="Center" />
              <TextBlock x:Name="DevicesEmptyText" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                         Text="Loading the computers that use your server…" />
            </StackPanel>
            <!-- Adding happens on the new computer (it signs in); removing and renaming on the nest's website. -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="6,12,6,4" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Button Classes="subtle" Content="+ Add a computer…" Click="OnAddComputer" />
                <Button Classes="link" Content="Manage devices on your nest" VerticalAlignment="Center" Click="OnManageDevices" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ============ Needs attention ============ -->
        <ScrollViewer x:Name="AttentionPage" IsVisible="False">
          <StackPanel Margin="28,18,28,24">
            <ItemsControl x:Name="AttentionList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="card enter" Margin="0,0,0,10" Padding="0">
                    <Grid ColumnDefinitions="5,*,Auto">
                      <Border Width="5" CornerRadius="12,0,0,12" Background="{StaticResource S.Orange}" />
                      <StackPanel Grid.Column="1" Margin="16,14,0,14" Spacing="3">
                        <TextBlock Text="{Binding Title}" Classes="strong" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="subtle" Content="{Binding ActionLabel}" Margin="16,0,16,0"
                              VerticalAlignment="Center" Click="OnAttentionAction" Tag="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="AttentionEmpty" HorizontalAlignment="Center" Margin="0,80,0,0" Spacing="10" IsVisible="False">
              <Grid Width="56" Height="56" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource T.OkPill}" />
                <v:LineIcon Classes="icon" Width="28" Height="28" StrokeThickness="2.2" Stroke="{StaticResource S.Green}" Data="{StaticResource I.Check}" />
              </Grid>
              <TextBlock Classes="h2" HorizontalAlignment="Center" Text="Nothing needs your attention" />
              <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Conflicts and files Pairnets can't sync show up here." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Settings (the form is a SettingsView the controller provides) ============ -->
        <ContentControl x:Name="SettingsPage" Margin="28,12,14,6" IsVisible="False" />
      </Panel>
    </Grid>
  </Grid>
</Window>
