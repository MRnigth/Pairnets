<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views"
        xmlns:c="using:Pairnets.Core.Client"
        x:Class="Pairnets.Desktop.Views.MainWindow"
        Title="Pairnets" Width="980" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="avares://Pairnets/Assets/pairnets-icon-256.png">
  <Window.Resources>
    <v:ActivityBrushConverter x:Key="KindBrush" />
    <v:ActivityIconConverter x:Key="KindIcon" />
    <!-- The same pictures as the Windows app: a computer with a plus (asking to join), an undo arrow (Restore). -->
    <StreamGeometry x:Key="I.JoinPc">M4,5 L15,5 A2,2 0 0 1 17,7 L17,14 A2,2 0 0 1 15,16 L4,16 A2,2 0 0 1 2,14 L2,7 A2,2 0 0 1 4,5 Z M6 20h7M9.5 16v4 M20 3v6M17 6h6</StreamGeometry>
    <StreamGeometry x:Key="I.Undo">M9 14 4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 0 11H11</StreamGeometry>
  </Window.Resources>

  <Window.DataTemplates>
    <!-- Activity rows and day headings (Overview and Activity pages) -->
    <DataTemplate DataType="c:ActivityDay">
      <TextBlock Classes="day" Text="{Binding Text}" />
    </DataTemplate>
    <DataTemplate DataType="c:ActivityItem">
      <Border Classes="row enter" ToolTip.Tip="{Binding TimeText}" Background="Transparent">
        <Border.ContextMenu>
          <ContextMenu IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
            <MenuItem Header="Show in folder" Click="OnRevealActivity" />
            <MenuItem Header="Show versions…" Click="OnActivityVersions" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Grid Width="30" Height="30" Margin="0,0,12,0">
            <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
            <v:LineIcon Classes="icon white" Width="19" Height="19" StrokeThickness="2.6"
                        Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Primary}" Classes="strong" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Secondary}" Classes="muted small" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted small" VerticalAlignment="Center" Margin="12,0,4,0" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid x:Name="Root" ColumnDefinitions="320,*">
    <!-- ======================= Left side, open ======================= -->
    <Grid x:Name="SideOpen" Margin="12,12,0,12">
      <Border Classes="sidepanel">
        <!-- Top-aligned, so the page tiles sit right under the computers and the spare space goes to the bottom; the
             computers' row is the one that shrinks (and scrolls) when the window is short. -->
        <Grid Margin="14,16,14,14" RowDefinitions="Auto,*,Auto" VerticalAlignment="Top">
          <!-- Top: logo, fold, account -->
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4,0,0,0">
            <Image x:Name="AppIcon" Source="avares://Pairnets/Assets/pairnets-icon-256.png" Width="30" Height="30" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" Text="Pairnets" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
            <Button x:Name="FoldButton" Grid.Column="2" Classes="RoundIconButton" Width="32" Height="32" Margin="0,0,8,0"
                    ToolTip.Tip="Fold into the dock" AutomationProperties.Name="Fold into the dock" Click="OnFoldSide">
              <v:LineIcon Classes="icon" Width="16" Height="16" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.FoldLeft}" />
            </Button>
            <Button x:Name="AccountButton" Grid.Column="3" Classes="RoundIconButton" Width="32" Height="32"
                    Background="{DynamicResource T.AccentSoft}" Foreground="{DynamicResource T.AccentInk}" Click="OnAccount">
              <TextBlock x:Name="AccountInitial" Text="A" FontSize="14" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>

          <!-- Your computers (scrolls when the window is short) -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Classes="SmallLabel" Text="YOUR COMPUTERS" Margin="4,16,0,8" />

              <!-- This computer -->
              <Button x:Name="ThisCard" Classes="siderow" Background="Transparent" Click="OnThisComputer">
                <StackPanel>
                  <Grid ColumnDefinitions="Auto,*">
                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                      <Border x:Name="ThisIconSq" Classes="IconSquare" />
                      <v:LineIcon x:Name="ThisIcon" Classes="icon" Width="17" Height="17" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                      <Ellipse x:Name="ThisDot" Width="10" Height="10" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="ThisName" FontWeight="ExtraBold" Text="DESKTOP" TextTrimming="CharacterEllipsis" />
                      <TextBlock x:Name="ThisSub" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                  <ProgressBar x:Name="ThisBar" Classes="thin" Minimum="0" Maximum="100" Margin="0,9,0,0" IsVisible="False" />
                </StackPanel>
              </Button>

              <!-- The nest -->
              <Button x:Name="NestRow" Classes="siderow" Background="Transparent" Margin="0,6,0,0" Click="OnNestRow">
                <Grid ColumnDefinitions="Auto,*">
                  <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                    <Border Classes="IconSquare" />
                    <v:LineIcon Classes="icon" Width="17" Height="17" StrokeThickness="1.8" Data="{StaticResource I.Nest}" />
                    <Ellipse x:Name="NestDot" Width="10" Height="10" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NestTitle" FontWeight="ExtraBold" Text="Your nest" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NestSub" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </Button>

              <!-- Other computers, as one group -->
              <Border Background="{DynamicResource T.Tile}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="16" Padding="12,10" Margin="0,6,0,0">
                <StackPanel>
                  <!-- The heading is never cut; the note gets what is left (it was drawn over the heading). -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock x:Name="GroupTitle" Text="Other computers" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="GroupNote" Grid.Column="1" Classes="SoftText" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button x:Name="GroupFold" Grid.Column="2" Classes="RoundIconButton" Width="28" Height="28" Background="Transparent"
                            ToolTip.Tip="Fold the group" AutomationProperties.Name="Fold the group" Click="OnFoldGroup">
                      <v:LineIcon x:Name="GroupFoldIcon" Classes="icon" Width="14" Height="14" StrokeThickness="2.4" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.ChevronUp}" />
                    </Button>
                  </Grid>
                  <UniformGrid x:Name="GroupGrid" Columns="3" Margin="-2,6,-2,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Under the computers: the app update, then the page tiles -->
          <StackPanel Grid.Row="2">
            <Border x:Name="UpdateCard" Background="{DynamicResource T.AccentSoft}" CornerRadius="14" Padding="12,8,8,8" Margin="0,10,0,0" IsVisible="False">
              <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                  <v:LineIcon x:Name="UpdateIcon" Classes="icon bob" Width="16" Height="16" StrokeThickness="2.2" Margin="0,0,8,0" VerticalAlignment="Center"
                              Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Download}" />
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateTitle" FontWeight="ExtraBold" FontSize="13" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock x:Name="UpdatePercent" Grid.Column="2" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}"
                             VerticalAlignment="Center" Margin="8,0,4,0" IsVisible="False" />
                  <Button x:Name="UpdateButton" Grid.Column="3" Classes="accent small" Content="Update" Margin="8,0,0,0" Click="OnUpdateNow" />
                  <Button x:Name="UpdateLater" Grid.Column="4" Classes="RoundIconButton" Width="28" Height="28" Margin="8,0,0,0" Background="Transparent"
                          ToolTip.Tip="Later" AutomationProperties.Name="Later" Click="OnUpdateLater">
                    <v:LineIcon Classes="icon" Width="12" Height="12" StrokeThickness="2.4" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Close}" />
                  </Button>
                </Grid>
                <!-- Why the update was not installed, or why it is done by hand (a Mac), the whole card wide -->
                <TextBlock x:Name="UpdateReason" FontSize="12" Foreground="{DynamicResource T.Muted}" TextWrapping="Wrap" Margin="24,4,4,2" IsVisible="False" />
                <ProgressBar x:Name="UpdateProgress" Classes="thin" Minimum="0" Maximum="100" Margin="0,8,4,2" IsVisible="False" />
              </StackPanel>
            </Border>

            <TextBlock Classes="SmallLabel" Text="PAGES" Margin="4,16,0,4" />
            <UniformGrid Columns="2" Margin="-4,0,-4,0">
              <RadioButton x:Name="NavOverview" Classes="sidetile" GroupName="page" IsChecked="True" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Overview" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Home}" />
                  <TextBlock x:Name="OverviewNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavActivity" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Activity" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Activity}" />
                  <TextBlock x:Name="ActivityNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="14" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavAttention" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Needs you" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Warning}" />
                  <TextBlock x:Name="AttentionCount" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="20" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavFiles" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Files" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Folder}" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavDevices" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Computers" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Desktop}" />
                  <TextBlock x:Name="DevicesNote" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="NavSettings" Classes="sidetile" GroupName="page" IsCheckedChanged="OnNav">
                <Grid>
                  <TextBlock Text="Settings" VerticalAlignment="Bottom" FontSize="14" />
                  <v:LineIcon Data="{StaticResource I.Gear}" StrokeThickness="1.8" />
                </Grid>
              </RadioButton>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <!-- ======================= Left side, folded into the dock ======================= -->
    <Grid x:Name="SideDock" RowDefinitions="Auto,*,Auto" Margin="0,18" IsVisible="False">
      <StackPanel HorizontalAlignment="Center">
        <Image x:Name="DockIcon" Source="avares://Pairnets/Assets/pairnets-icon-256.png" Width="38" Height="38" />
        <Button x:Name="DockUnfold" Classes="RoundIconButton" Width="32" Height="32" Margin="0,10,0,0"
                ToolTip.Tip="Open the side panel" AutomationProperties.Name="Open the side panel" Click="OnUnfoldSide">
          <v:LineIcon Classes="icon" Width="16" Height="16" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.FoldRight}" />
        </Button>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <!-- Pages -->
          <Border Classes="dockpill">
            <StackPanel>
              <RadioButton x:Name="DockOverview" Classes="dockpage" GroupName="dock" IsChecked="True" ToolTip.Tip="Overview" AutomationProperties.Name="Overview" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Home}" />
              </RadioButton>
              <RadioButton x:Name="DockActivity" Classes="dockpage" GroupName="dock" ToolTip.Tip="Activity" AutomationProperties.Name="Activity" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Activity}" />
              </RadioButton>
              <Grid>
                <RadioButton x:Name="DockAttention" Classes="dockpage" GroupName="dock" ToolTip.Tip="Needs you" AutomationProperties.Name="Needs you" IsCheckedChanged="OnNav">
                  <v:LineIcon Data="{StaticResource I.Warning}" />
                </RadioButton>
                <Border x:Name="DockBadge" Width="20" Height="20" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource T.Card}" Background="{DynamicResource T.NeedsActive}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False" IsVisible="False">
                  <TextBlock x:Name="DockBadgeText" Foreground="{DynamicResource T.NeedsActiveText}" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </Grid>
              <RadioButton x:Name="DockFiles" Classes="dockpage" GroupName="dock" ToolTip.Tip="Files" AutomationProperties.Name="Files" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Folder}" />
              </RadioButton>
              <RadioButton x:Name="DockDevices" Classes="dockpage" GroupName="dock" ToolTip.Tip="Computers" AutomationProperties.Name="Computers" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Desktop}" />
              </RadioButton>
              <Border Classes="divider" Width="24" Margin="0,4" />
              <RadioButton x:Name="DockSettings" Classes="dockpage" GroupName="dock" ToolTip.Tip="Settings" AutomationProperties.Name="Settings" IsCheckedChanged="OnNav">
                <v:LineIcon Data="{StaticResource I.Gear}" StrokeThickness="1.8" />
              </RadioButton>
            </StackPanel>
          </Border>

          <!-- Computers -->
          <Border Classes="dockpill" Margin="0,12,0,0">
            <StackPanel>
              <Button x:Name="DockThis" Classes="dockbtn" Background="{DynamicResource T.AccentSoft}" Click="OnThisComputer">
                <Grid Width="44" Height="44">
                  <Ellipse x:Name="DockRingTrack" Stroke="{DynamicResource T.Track}" StrokeThickness="2.5" IsVisible="False" Margin="1" />
                  <Ellipse x:Name="DockRing" Stroke="{DynamicResource T.Accent}" StrokeThickness="2.5" StrokeLineCap="Round" RenderTransformOrigin="50%,50%" IsVisible="False" Margin="1">
                    <Ellipse.RenderTransform>
                      <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <v:LineIcon x:Name="DockThisIcon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                </Grid>
              </Button>
              <Button x:Name="DockNest" Classes="dockbtn" Click="OnNestRow">
                <Grid Width="44" Height="44">
                  <v:LineIcon Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Nest}" />
                  <Ellipse x:Name="DockNestDot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockOther1" Classes="dockbtn" Click="OnDevices">
                <Grid Width="44" Height="44">
                  <v:LineIcon x:Name="DockOther1Icon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                  <Ellipse x:Name="DockOther1Dot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockOther2" Classes="dockbtn" Click="OnDevices">
                <Grid Width="44" Height="44">
                  <v:LineIcon x:Name="DockOther2Icon" Classes="icon" Width="18" Height="18" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                  <Ellipse x:Name="DockOther2Dot" Width="11" Height="11" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,1" />
                </Grid>
              </Button>
              <Button x:Name="DockMore" Classes="dockbtn" Background="{DynamicResource T.Hover}" BorderBrush="{DynamicResource T.Dash}" BorderThickness="1.5" Click="OnDevices"
                      FontSize="13" FontWeight="ExtraBold">
                <TextBlock x:Name="DockMoreText" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Button x:Name="DockAccount" Grid.Row="2" Classes="RoundIconButton" Width="42" Height="42" HorizontalAlignment="Center"
              Background="{DynamicResource T.AccentSoft}" Foreground="{DynamicResource T.AccentInk}" Click="OnAccount">
        <TextBlock x:Name="DockAccountInitial" Text="A" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Button>
    </Grid>

    <!-- ======================= Page ======================= -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">
      <Grid x:Name="HeaderRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="28,22,28,0">
        <TextBlock x:Name="PageTitle" Classes="title" Text="Overview" VerticalAlignment="Center" />
        <TextBlock x:Name="PageSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Classes="muted" Margin="0,4,0,0" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="subtle" Click="OnOpenFolder" ToolTip.Tip="Open the synced folder">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Folder}" />
              <TextBlock Text="Open folder" />
            </StackPanel>
          </Button>
          <Button Classes="subtle" Click="OnPause">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon x:Name="PauseGlyph" Classes="icon" Width="17" Height="17" Data="{StaticResource I.Pause}" />
              <TextBlock x:Name="PauseText" Text="Pause" />
            </StackPanel>
          </Button>
          <Button x:Name="SyncNowButton" Classes="accent" Click="OnSyncNow">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <v:LineIcon x:Name="SyncNowIcon" Classes="icon white" Width="17" Height="17" Data="{StaticResource I.Sync}" />
              <TextBlock Text="Sync now" />
            </StackPanel>
          </Button>
          <Button Classes="icon" ToolTip.Tip="More">
            <v:LineIcon Classes="icon" Width="18" Height="18" StrokeThickness="3.2" Data="{StaticResource I.More}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="View log" Click="OnViewLog" />
                <MenuItem Header="Report a bug…" Click="OnReportBug" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>

      <Panel Grid.Row="1">
        <!-- ============ Overview ============ -->
        <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
          <v:OverviewView x:Name="Overview" />
        </ScrollViewer>

        <!-- ============ Activity ============ -->
        <Grid x:Name="ActivityPage" RowDefinitions="Auto,Auto,*" Margin="28,40,28,24" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="PageTitle" Text="Activity" />
              <TextBlock Classes="t2" Margin="0,2,0,0" Text="Everything that synced, newest first." />
            </StackPanel>
            <Button Grid.Column="1" Classes="SecondaryButton" Height="38" Padding="14,0" Click="OnOpenFolder" ToolTip.Tip="Open the synced folder">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <v:LineIcon Classes="icon" Width="16" Height="16" Data="{StaticResource I.Folder}" />
                <TextBlock Text="Open folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <Grid x:Name="ActivityTools" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,16,0,0">
            <WrapPanel x:Name="ActivityFilters" VerticalAlignment="Top" />
            <TextBox x:Name="ActivitySearch" Grid.Column="1" Classes="search" Width="250" VerticalAlignment="Top" Watermark="Search files and folders">
              <TextBox.InnerLeftContent>
                <v:LineIcon Classes="icon muted" Width="15" Height="15" Margin="12,0,0,0" Data="{StaticResource I.Search}" />
              </TextBox.InnerLeftContent>
            </TextBox>
          </Grid>

          <Border x:Name="ActivityListCard" Grid.Row="2" Classes="pcard" Margin="0,10,0,0" Padding="12,6">
            <Grid>
              <ScrollViewer x:Name="ActivityPanel" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ActivityList">
                  <ItemsControl.DataTemplates>
                    <DataTemplate DataType="c:ActivityDay">
                      <Grid ColumnDefinitions="*,Auto" Margin="10,14,10,6">
                        <TextBlock Classes="heading" Text="{Binding Text, Converter={x:Static v:UpperText.Instance}}" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Classes="t3" Text="{Binding CountText}" VerticalAlignment="Bottom" />
                      </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="c:ActivityItem">
                      <Border Background="Transparent" Padding="10,6" ToolTip.Tip="{Binding TimeText}">
                        <Border.ContextMenu>
                          <ContextMenu IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <MenuItem Header="Show in folder" Click="OnRevealActivity" />
                            <MenuItem Header="Show versions…" Click="OnActivityVersions" />
                          </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,44,30">
                          <Border Classes="sq34" Margin="0,0,12,0" VerticalAlignment="Center"
                                  Classes.tint-warn="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Conflict,Blocked,Warning'}">
                            <Panel>
                              <v:LineIcon Classes="icon ink-accent" Width="17" Height="17" StrokeThickness="2.2" Data="{StaticResource I.Up}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Uploaded'}" />
                              <v:LineIcon Classes="icon ink-ok" Width="17" Height="17" StrokeThickness="2.2" Data="{StaticResource I.Down}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Downloaded'}" />
                              <v:LineIcon Classes="icon ink-warn" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Warning}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Conflict,Blocked,Warning'}" />
                              <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Trash}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='DeletedHere,DeletedOnServer'}" />
                              <v:LineIcon Classes="icon ink-bad" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Bang}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Error'}" />
                              <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.CloudOff}"
                                          IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Offline,Info'}" />
                            </Panel>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Secondary}" Classes="t3" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Classes="small" Content="Review" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                                  BorderBrush="{DynamicResource T.WarnBorder}" Click="OnReviewConflict"
                                  IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Conflict'}" />
                          <TextBlock Grid.Column="4" Text="{Binding Time, Converter={x:Static v:ClockText.Instance}}" Classes="t3" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                    <DataTemplate DataType="c:ActivityFolder">
                      <StackPanel>
                        <Grid ColumnDefinitions="Auto,*,44,30" Margin="10,6">
                          <Border Classes="sq34" Margin="0,0,12,0" VerticalAlignment="Center">
                            <v:LineIcon Classes="icon ink-folder" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.Folder}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              <Border Classes="countchip" VerticalAlignment="Center"><TextBlock Text="{Binding CountText}" /></Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Detail}" Classes="t3" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Time, Converter={x:Static v:ClockText.Instance}}" Classes="t3" TextAlignment="Right" VerticalAlignment="Center" />
                          <ToggleButton x:Name="FolderChevron" Grid.Column="3" Classes="chev" VerticalAlignment="Center" ToolTip.Tip="Show the files">
                            <Panel>
                              <v:LineIcon Classes="icon ink-soft" Width="14" Height="14" StrokeThickness="2.4" Data="{StaticResource I.ChevronDown}"
                                          IsVisible="{Binding !#FolderChevron.IsChecked}" />
                              <v:LineIcon Classes="icon ink-soft" Width="14" Height="14" StrokeThickness="2.4" Data="{StaticResource I.ChevronUp}"
                                          IsVisible="{Binding #FolderChevron.IsChecked}" />
                            </Panel>
                          </ToggleButton>
                        </Grid>
                        <Border IsVisible="{Binding #FolderChevron.IsChecked}" Margin="56,0,40,6" Padding="14,0,0,0" BorderThickness="2,0,0,0" BorderBrush="{DynamicResource T.Track}">
                          <StackPanel>
                            <ItemsControl ItemsSource="{Binding Items, Converter={x:Static v:FirstItems.Instance}, ConverterParameter=2}"
                                          IsVisible="{Binding !#ShowAllToggle.IsChecked}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="c:ActivityItem">
                                  <Grid ColumnDefinitions="*,Auto" Height="26">
                                    <TextBlock Text="{Binding Primary}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Time, Converter={x:Static v:ClockText.Instance}}" Classes="t3" VerticalAlignment="Center" Margin="10,0,0,0" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding #ShowAllToggle.IsChecked}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="c:ActivityItem">
                                  <Grid ColumnDefinitions="*,Auto" Height="26">
                                    <TextBlock Text="{Binding Primary}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Time, Converter={x:Static v:ClockText.Instance}}" Classes="t3" VerticalAlignment="Center" Margin="10,0,0,0" />
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ToggleButton x:Name="ShowAllToggle" Classes="link2" HorizontalAlignment="Left" Height="26"
                                          Content="{Binding CountText, Converter={x:Static v:ShowAllText.Instance}}"
                                          IsVisible="{Binding !#ShowAllToggle.IsChecked}" />
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock x:Name="ActivityNoMatch" Classes="t2" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" IsVisible="False" />
            </Grid>
          </Border>

          <!-- Nothing has synced yet -->
          <Border x:Name="ActivityEmpty" Grid.Row="1" Grid.RowSpan="2" Classes="pcard" Margin="0,16,0,0" Padding="32" IsVisible="False">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas Width="340" Height="150" HorizontalAlignment="Center">
                <Line StartPoint="60,75" EndPoint="280,75" Stroke="{DynamicResource T.Track}" StrokeThickness="2" StrokeDashArray="2,2" />
                <Border Canvas.Left="16" Canvas.Top="52" Width="48" Height="48" CornerRadius="15" Background="{DynamicResource T.Chip}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><RotateTransform Angle="-6" /></Border.RenderTransform>
                  <v:LineIcon Classes="icon ink-soft" Width="22" Height="22" StrokeThickness="1.8" Data="{StaticResource I.Desktop}" />
                </Border>
                <Border Canvas.Left="276" Canvas.Top="52" Width="48" Height="48" CornerRadius="15" Background="{DynamicResource T.Chip}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><RotateTransform Angle="6" /></Border.RenderTransform>
                  <v:LineIcon Classes="icon ink-soft" Width="22" Height="22" StrokeThickness="1.8" Data="{StaticResource I.Laptop}" />
                </Border>
                <Border Canvas.Left="110" Canvas.Top="15" Width="120" Height="120" CornerRadius="60" Background="{DynamicResource T.Card}">
                  <Border CornerRadius="60" Background="{DynamicResource T.AccentSoft}">
                    <Border Width="68" Height="68" CornerRadius="22" Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                      <v:LineIcon Stroke="{DynamicResource T.Accent}" Width="30" Height="30" StrokeThickness="2.2" Data="{StaticResource I.Activity}" />
                    </Border>
                  </Border>
                </Border>
                <Border Canvas.Left="96" Canvas.Top="8" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><RotateTransform Angle="-10" /></Border.RenderTransform>
                  <v:LineIcon Classes="icon ink-folder" Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.Folder}" />
                </Border>
                <Border Canvas.Left="216" Canvas.Top="114" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1"
                        RenderTransformOrigin="50%,50%">
                  <Border.RenderTransform><RotateTransform Angle="9" /></Border.RenderTransform>
                  <v:LineIcon Classes="icon ink-soft" Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.File}" />
                </Border>
              </Canvas>
              <TextBlock Text="Nothing has synced yet" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,26,0,0" />
              <TextBlock x:Name="ActivityEmptyText" Classes="t2" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Center" Margin="0,8,0,0" />
              <Button Classes="accent" Height="38" Padding="16,0" HorizontalAlignment="Center" Margin="0,22,0,0" Click="OnOpenFolder">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <v:LineIcon Classes="icon white" Width="16" Height="16" Data="{StaticResource I.Folder}" />
                  <TextBlock Text="Open your folder" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ============ Files: all files on the nest, and the deleted ones (History); Clean up in its place ============ -->
        <Grid x:Name="FilesPage" RowDefinitions="Auto,*" IsVisible="False">
          <StackPanel x:Name="FilesHeader" Margin="28,40,28,0">
            <TextBlock Classes="PageTitle" Text="Files" />
            <TextBlock Classes="t2" Margin="0,2,0,0" TextWrapping="Wrap" Text="Everything on your nest, and what was deleted in the last 30 days." />
            <Border Classes="tabs" HorizontalAlignment="Left" Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton x:Name="AllFilesTab" Classes="tab" GroupName="files" IsChecked="True" IsCheckedChanged="OnFilesTab">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.Folder}" />
                    <TextBlock Text="All files" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DeletedFilesTab" Classes="tab" GroupName="files" IsCheckedChanged="OnFilesTab">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.Trash}" />
                    <TextBlock Text="Deleted" />
                    <TextBlock x:Name="DeletedTabCount" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
          </StackPanel>
          <v:NestFilesView x:Name="NestFilesPage" Grid.Row="1" />
          <v:CleanupView x:Name="CleanupPage" Grid.RowSpan="2" IsVisible="False" />

        <!-- ============ History: the Files page's Deleted tab ============ -->
        <Grid x:Name="HistoryPage" Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="28,0,28,24" IsVisible="False">
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
            <Border Classes="tabs" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton x:Name="DeletedTab" Classes="tab" GroupName="history" IsChecked="True" IsCheckedChanged="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.Trash}" />
                    <TextBlock Text="Deleted files" />
                    <TextBlock x:Name="DeletedCount" FontWeight="SemiBold" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilesTab" Classes="tab" GroupName="history" IsCheckedChanged="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <v:LineIcon Classes="icon" Width="14" Height="14" Stroke="{Binding $parent[RadioButton].Foreground}" Data="{StaticResource I.File}" />
                    <TextBlock Text="Older versions" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <TextBox x:Name="HistorySearch" Grid.Column="1" Classes="search" Margin="10,0" Height="42" MinHeight="42" CornerRadius="14" Watermark="Search deleted files by name or folder"
                     TextChanged="OnTextChanged" VerticalContentAlignment="Center">
              <TextBox.InnerLeftContent>
                <v:LineIcon Classes="icon muted" Width="15" Height="15" Margin="12,0,0,0" Data="{StaticResource I.Search}" />
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="2" Classes="SecondaryButton" Width="42" Height="42" MinHeight="42" Padding="0" CornerRadius="14" ToolTip.Tip="Reload from your nest" AutomationProperties.Name="Reload from your nest" Click="OnHistoryReload">
              <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Sync}" />
            </Button>
          </Grid>

          <Panel Grid.Row="2" Margin="0,16,0,0">
            <!-- Deleted files: one wide table -->
            <ScrollViewer x:Name="DeletedPane" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Spacing="10">
                <Border x:Name="DeletedMessage" Classes="msg" IsVisible="False">
                  <TextBlock x:Name="DeletedMessageText" TextWrapping="Wrap" FontSize="12.5" />
                </Border>
                <Border Classes="pcard" Padding="10,4,10,6">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,150,96" Margin="12,12,12,8">
                      <TextBlock Classes="heading" Text="FILE" Margin="48,0,0,0" />
                      <TextBlock Grid.Column="1" Classes="heading" Text="DELETED" />
                    </Grid>
                    <ItemsControl x:Name="DeletedList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="c:ServerFile">
                          <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="12,9">
                            <Grid ColumnDefinitions="Auto,*,150,96">
                              <Border Classes="sq34" Margin="0,0,14,0" VerticalAlignment="Center">
                                <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.File}" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" Classes="t3" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WhenText}" FontSize="13" />
                                <TextBlock Text="{Binding DaysLeftText}" Classes="t3" Classes.warn="{Binding ExpiresSoon}" />
                              </StackPanel>
                              <Button Grid.Column="3" Classes="small" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold" Click="OnRestoreFile" Tag="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <v:LineIcon Classes="icon" Width="14" Height="14" Data="{StaticResource I.Undo}" />
                                  <TextBlock Text="Restore" />
                                </StackPanel>
                              </Button>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <TextBlock Classes="t3" FontSize="13" Margin="4,2,0,8" TextWrapping="Wrap"
                           Text="Restored files go back to the folder they came from. After 30 days your nest removes deleted files for good." />
              </StackPanel>
            </ScrollViewer>

            <!-- All files: the list, and the versions of the chosen file -->
            <Grid x:Name="FilesPane" ColumnDefinitions="*,1.12*" IsVisible="False">
              <Border Classes="pcard" Padding="8,6" Margin="0,0,8,0">
                <Grid RowDefinitions="Auto,*">
                  <TextBlock x:Name="HistorySummary" Classes="t3" Margin="10,10,10,8" />
                  <ListBox x:Name="FileList" Grid.Row="1" Classes="frows" SelectionChanged="OnFileSelected">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="c:ServerFile">
                        <Grid ColumnDefinitions="Auto,*">
                          <Border Classes="sq34" Margin="0,0,12,0">
                            <v:LineIcon Classes="icon ink-soft" Width="17" Height="17" StrokeThickness="2" Data="{StaticResource I.File}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FolderAndWhen}" Classes="t3" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>

              <Border Grid.Column="1" Classes="pcard" Padding="22,20" Margin="8,0,0,0">
                <Grid>
                  <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Restore}" HorizontalAlignment="Center" />
                    <TextBlock Classes="t2" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"
                               Text="Choose a file to see the versions your nest keeps, and get one back." />
                  </StackPanel>
                  <Grid x:Name="DetailPanel" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="48" Height="48" CornerRadius="14" Classes="tint-ok" Margin="0,0,14,0">
                        <v:LineIcon Classes="icon ink-ok" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.File}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" FontSize="18" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="DetailFolder" Classes="t3" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <Button x:Name="ShowInFolderButton" Grid.Column="2" Classes="small" Height="34" VerticalAlignment="Center" FontWeight="Bold" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <v:LineIcon Classes="icon" Width="14" Height="14" Data="{StaticResource I.Folder}" />
                          <TextBlock Text="Show in folder" />
                        </StackPanel>
                      </Button>
                    </Grid>
                    <Border Grid.Row="1" Classes="hair" Margin="0,18,0,16" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                      <TextBlock Classes="heading" Text="VERSIONS ON YOUR NEST" />
                      <TextBlock x:Name="VersionCount" Grid.Column="1" Classes="t3" />
                    </Grid>
                    <Border x:Name="RestoreMessage" Grid.Row="3" Classes="msg" Margin="0,8,0,4" IsVisible="False">
                      <TextBlock x:Name="RestoreMessageText" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                      <Grid VerticalAlignment="Top">
                        <Border Width="2" CornerRadius="1" HorizontalAlignment="Left" Margin="7,30,0,30" Background="{DynamicResource T.Track}" />
                        <StackPanel>
                          <Grid x:Name="CurrentVersion" ColumnDefinitions="16,*,Auto" Margin="0,10">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource T.Accent}" BorderBrush="{DynamicResource T.Card}" BorderThickness="3" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                              <TextBlock x:Name="CurrentWhen" FontWeight="Bold" />
                              <TextBlock x:Name="CurrentSize" Classes="t3" />
                            </StackPanel>
                            <Border Grid.Column="2" Classes="pillok" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <v:LineIcon Classes="icon ink-ok" Width="12" Height="12" StrokeThickness="2.6" Data="{StaticResource I.Check}" VerticalAlignment="Center" />
                                <TextBlock Text="Current version" />
                              </StackPanel>
                            </Border>
                          </Grid>
                          <ItemsControl x:Name="VersionList">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="c:VersionRow">
                                <Grid ColumnDefinitions="16,*,Auto" Margin="0,10" Classes="enter">
                                  <Border Width="14" Height="14" CornerRadius="7" Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.TextSoft}" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                  <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Classes="t3" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <Button Grid.Column="2" Classes="small" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnRestore" Tag="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                      <v:LineIcon Classes="icon" Width="14" Height="14" Data="{StaticResource I.Undo}" />
                                      <TextBlock Text="Restore" />
                                    </StackPanel>
                                  </Button>
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock x:Name="VersionsMessage" Classes="t2" TextWrapping="Wrap" Margin="30,8,0,8" IsVisible="False" />
                        </StackPanel>
                      </Grid>
                    </ScrollViewer>
                    <Border x:Name="RestoreNote" Grid.Row="5" CornerRadius="14" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource T.Chip}">
                      <Grid ColumnDefinitions="Auto,*">
                        <v:LineIcon Classes="icon ink-soft" Width="16" Height="16" StrokeThickness="1.9" Margin="0,1,10,0" VerticalAlignment="Top" Data="{StaticResource I.InfoCircle}" />
                        <TextBlock Grid.Column="1" Classes="t2" FontSize="13" TextWrapping="Wrap"
                                   Text="Restore puts that version back in your folder. The one you have now stays here as a version, so nothing is lost." />
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>

            <!-- Loading, unreachable, nothing found -->
            <Border x:Name="HistoryMessageCard" Classes="pcard" IsVisible="False">
              <StackPanel x:Name="HistoryMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="32">
                <v:LineIcon x:Name="HistoryMessageIcon" Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.History}" HorizontalAlignment="Center" />
                <TextBlock x:Name="HistoryMessageText" Classes="t2" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320" />
                <Button x:Name="HistoryRetry" Classes="subtle" Content="Try again" HorizontalAlignment="Center" Click="OnHistoryReload" IsVisible="False" />
              </StackPanel>
            </Border>
          </Panel>
        </Grid>
        </Grid>

        <!-- ============ Devices: the nest and every computer that uses it ============ -->
        <Grid x:Name="DevicesPage" RowDefinitions="Auto,*" Margin="28,40,28,24" IsVisible="False">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="PageTitle" Text="Computers" />
              <TextBlock Classes="t2" Margin="0,2,0,0" TextWrapping="Wrap" Text="Every computer on your nest, and the nest itself." />
            </StackPanel>
            <Button Grid.Column="1" Classes="SecondaryButton" Height="38" Padding="14,0" Margin="8,0" VerticalAlignment="Center" Click="OnManageDevices">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <v:LineIcon Classes="icon" Width="16" Height="16" Data="{StaticResource I.External}" />
                <TextBlock Text="Manage computers on your nest" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="accent" Height="38" Padding="16,0" VerticalAlignment="Center" Click="OnAddComputer">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <v:LineIcon Classes="icon white" Width="16" Height="16" Data="{StaticResource I.Plus}" />
                <TextBlock Text="Add a computer…" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <!-- The nest -->
              <Border x:Name="NestCardBox" Classes="pcard" Padding="24,22">
                <StackPanel Spacing="18">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Width="52" Height="52" CornerRadius="16" Classes="tint-accent" Margin="0,0,16,0">
                      <v:LineIcon Classes="icon ink-accent" Width="24" Height="24" StrokeThickness="1.8" Data="{StaticResource I.Nest}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="NestHeading" Text="Your nest" FontSize="20" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="t2" Text="The home server that keeps your files and their history." TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="NestOnlinePill" Grid.Column="2" Classes="pillok" Height="28" VerticalAlignment="Center" Margin="12,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="NestOnlineDot" Width="7" Height="7" Fill="{DynamicResource T.Ok}" VerticalAlignment="Center" />
                        <TextBlock x:Name="NestOnlineText" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <Border Classes="hair" />
                  <UniformGrid x:Name="NestChips" Columns="4" Margin="-5">
                    <Border Classes="infochip" Margin="5">
                      <StackPanel>
                        <TextBlock Classes="t3" Foreground="{DynamicResource T.Muted}" Text="Address" />
                        <TextBlock x:Name="NestAddress" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Border>
                    <Border Classes="infochip" Margin="5">
                      <StackPanel>
                        <TextBlock Classes="t3" Foreground="{DynamicResource T.Muted}" Text="Version" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock x:Name="NestVersion" FontSize="15" FontWeight="Bold" />
                          <TextBlock x:Name="NestVersionNote" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" VerticalAlignment="Bottom" Margin="0,0,0,1" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                    <Border Classes="infochip" Margin="5">
                      <StackPanel>
                        <TextBlock Classes="t3" Foreground="{DynamicResource T.Muted}" Text="Free space" />
                        <TextBlock x:Name="NestSpace" FontSize="15" FontWeight="Bold" />
                      </StackPanel>
                    </Border>
                    <Border Classes="infochip" Margin="5">
                      <StackPanel>
                        <TextBlock Classes="t3" Foreground="{DynamicResource T.Muted}" Text="Keeps deleted files" />
                        <TextBlock x:Name="NestKeeps" FontSize="15" FontWeight="Bold" />
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- Computers -->
              <StackPanel x:Name="DevicesPanel" Spacing="10" IsVisible="False">
                <Grid ColumnDefinitions="Auto,*,Auto" Height="32" Margin="4,0,0,0">
                  <TextBlock Classes="ctitle" Text="Computers" VerticalAlignment="Center" />
                  <TextBlock x:Name="DevicesSummaryText" Grid.Column="1" Classes="t3" VerticalAlignment="Center" Margin="12,0" />
                  <Button x:Name="JoinChip" Grid.Column="2" Height="32" MinHeight="32" Padding="12,0,8,0" CornerRadius="16" IsVisible="False" Click="OnReviewJoin"
                          Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" Foreground="{DynamicResource T.WarnText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <v:LineIcon Classes="icon ink-warn" Width="15" Height="15" Data="{StaticResource I.UserPlus}" />
                      <TextBlock x:Name="JoinChipText" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                      <TextBlock Text="Review" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" VerticalAlignment="Center" />
                      <v:LineIcon Classes="icon ink-soft" Width="13" Height="13" StrokeThickness="2.4" Data="{StaticResource I.ChevronRight}" />
                    </StackPanel>
                  </Button>
                </Grid>
                <ItemsControl x:Name="DevicesList" v:DeviceIconPencil.IconChosen="OnDeviceIconChosen">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="c:DeviceCard">
                      <v:DeviceCardView Margin="6" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" Spacing="10" Margin="0,24">
                <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Server}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DevicesEmptyText" Classes="t2" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340"
                           Text="Loading the computers that use your nest…" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,0">
                <v:LineIcon Classes="icon ink-soft" Width="16" Height="16" StrokeThickness="2" Data="{StaticResource I.InfoCircle}" VerticalAlignment="Top" Margin="0,1,8,0" />
                <TextBlock Grid.Column="1" Classes="t2" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="To remove a computer or turn off its access, use Manage computers on your nest. Its files stay where they are." />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ============ Needs you ============ -->
        <Grid x:Name="AttentionPage" RowDefinitions="Auto,*" Margin="28,40,28,24" IsVisible="False">
          <StackPanel>
            <TextBlock Classes="PageTitle" Text="Needs you" />
            <TextBlock x:Name="AttentionSubtitle" Classes="t2" Margin="0,2,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl x:Name="AttentionList">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="16" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="pcard enter" Padding="22,18">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="sq44" Margin="0,0,16,0" VerticalAlignment="Top"
                                Classes.tint-accent="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Join,Rename'}"
                                Classes.tint-warn="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Conflict,Warning'}">
                          <Panel>
                            <v:LineIcon Classes="icon ink-accent" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.JoinPc}"
                                        IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Join'}" />
                            <v:LineIcon Classes="icon ink-accent" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.Pencil}"
                                        IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Rename'}" />

                            <v:LineIcon Classes="icon ink-warn" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.Copy}"
                                        IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Conflict'}" />
                            <v:LineIcon Classes="icon ink-warn" Width="22" Height="22" StrokeThickness="1.9" Data="{StaticResource I.Warning}"
                                        IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Warning'}" />
                            <TextBlock Text="Aa" FontSize="16" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='NameClash'}" />
                          </Panel>
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="12">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="ExtraBold" TextWrapping="Wrap" />
                              <TextBlock Grid.Column="1" Classes="t3" VerticalAlignment="Top" Margin="12,3,0,0" Text="{Binding At, Converter={x:Static v:MomentText.Instance}}" />
                            </Grid>
                            <TextBlock Classes="t2" TextWrapping="Wrap" Text="{Binding Detail}" />
                          </StackPanel>
                          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Classes="codechip" IsVisible="{Binding Code, Converter={x:Static v:HasText.Instance}}">
                              <StackPanel Orientation="Horizontal" Spacing="14">
                                <TextBlock Text="{Binding Title, Converter={x:Static v:JoinComputer.Instance}}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource T.Muted}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Code}" FontSize="20" FontWeight="ExtraBold" LetterSpacing="2.4" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                            <Button Grid.Column="2" Content="{Binding SecondLabel}" Height="38" Padding="16,0" Margin="0,0,8,0" FontWeight="Bold" VerticalAlignment="Center"
                                    IsVisible="{Binding SecondLabel, Converter={x:Static v:HasText.Instance}}" Click="OnAttentionSecond" Tag="{Binding}" />
                            <Button Grid.Column="3" Content="{Binding ActionLabel}" Height="38" Padding="16,0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"
                                    Classes.accent="{Binding Kind, Converter={x:Static v:KindIs.Instance}, ConverterParameter='Join,Rename'}"
                                    Click="OnAttentionAction" Tag="{Binding}" />
                          </Grid>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border x:Name="AttentionEmpty" Classes="pcard" Padding="32,48" IsVisible="False">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                  <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Ellipse Fill="{DynamicResource T.OkPill}" />
                    <v:LineIcon Classes="icon ink-ok" Width="28" Height="28" StrokeThickness="2.2" Data="{StaticResource I.Check}" />
                  </Grid>
                  <TextBlock FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Text="Nothing needs you" />
                  <TextBlock Classes="t2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                             Text="Conflicts, computers asking to join and files Pairnets can't sync show up here. Everything is in order." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- ============ Account ============ -->
        <v:AccountPageView x:Name="AccountPage" Margin="28,40,28,24" IsVisible="False" />

        <!-- ============ Settings (the form is a SettingsView the controller provides) ============ -->
        <ContentControl x:Name="SettingsPage" Margin="28,40,28,24" IsVisible="False" />
      </Panel>
    </Grid>
  </Grid>
</Window>
