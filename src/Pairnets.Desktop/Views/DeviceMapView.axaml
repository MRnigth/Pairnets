<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:Pairnets.Desktop.Views"
             x:Class="Pairnets.Desktop.Views.DeviceMapView">
  <!--
    This computer ── server ── the other computer, on one line. Dots travel along the line while files move,
    and the speed sits above it. Compact (tray panel) uses smaller text.
  -->
  <UserControl.Styles>
    <Style Selector="v|LineIcon.glyph">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style Selector="Grid#Root.compact v|LineIcon.glyph">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,7,0" />
    </Style>
    <Style Selector="Ellipse.dot">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,1,0,0" />
    </Style>
    <Style Selector="Grid#Root.compact Ellipse.dot">
      <Setter Property="Width" Value="6" />
      <Setter Property="Height" Value="6" />
      <Setter Property="Margin" Value="5,1,0,0" />
    </Style>
    <Style Selector="TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="150" />
    </Style>
    <Style Selector="Grid#Root.compact TextBlock.name">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MaxWidth" Value="90" />
    </Style>
    <Style Selector="TextBlock.detail">
      <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="170" />
    </Style>
    <Style Selector="Grid#Root.compact TextBlock.detail">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="MaxWidth" Value="96" />
    </Style>
    <Style Selector="v|FlowLine">
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Grid#Root.compact v|FlowLine">
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="MinWidth" Value="18" />
    </Style>
    <Style Selector="StackPanel.label">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="4" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,26" />
    </Style>
    <Style Selector="StackPanel.label TextBlock">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Root" ColumnDefinitions="Auto,*,Auto,*,Auto">
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <v:LineIcon x:Name="HereIcon" Classes="glyph" Data="{StaticResource I.Laptop}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="HereName" Classes="name" />
          <Ellipse x:Name="HereDot" Classes="dot" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="HereDetail" Classes="detail" />
      </StackPanel>
    </StackPanel>

    <Panel Grid.Column="1">
      <v:FlowLine x:Name="HereLine" />
      <StackPanel x:Name="HereLabel" Classes="label" IsVisible="False">
        <v:LineIcon x:Name="HereArrow" Classes="icon" Width="12" Height="12" StrokeThickness="2.8"
                    Stroke="{DynamicResource S.Blue}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
        <TextBlock x:Name="HereSpeed" Foreground="{DynamicResource S.Blue}" />
      </StackPanel>
    </Panel>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <v:LineIcon x:Name="ServerIcon" Classes="glyph" Data="{StaticResource I.Server}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ServerName" Classes="name" />
          <Ellipse x:Name="ServerDot" Classes="dot" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="ServerDetail" Classes="detail" />
      </StackPanel>
    </StackPanel>

    <Panel Grid.Column="3">
      <v:FlowLine x:Name="OtherLine" ServerOnLeft="True" />
      <StackPanel x:Name="OtherLabel" Classes="label" IsVisible="False">
        <v:LineIcon Classes="icon muted" Width="12" Height="12" StrokeThickness="2.8" Data="{StaticResource I.Left}" VerticalAlignment="Center" />
        <TextBlock x:Name="OtherLabelText" Foreground="{DynamicResource T.Muted}" />
      </StackPanel>
    </Panel>

    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
      <v:LineIcon x:Name="OtherIcon" Classes="glyph" Data="{StaticResource I.Computer}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="OtherName" Classes="name" />
          <Ellipse x:Name="OtherDot" Classes="dot" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="OtherDetail" Classes="detail" />
        <TextBlock x:Name="OtherMore" Classes="detail" IsVisible="False" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
