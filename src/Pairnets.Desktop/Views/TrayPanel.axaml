<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views"
        xmlns:c="using:Pairnets.Core.Client"
        x:Class="Pairnets.Desktop.Views.TrayPanel"
        Title="Pairnets" Width="412" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Icon="avares://Pairnets/Assets/pairnets-icon-256.png">
  <Window.Resources>
    <v:ActivityIconConverter x:Key="KindIcon" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="v|LineIcon.tone[Tag=move]">
      <Setter Property="Stroke" Value="{DynamicResource S.Blue}" />
    </Style>
    <Style Selector="v|LineIcon.tone[Tag=warn]">
      <Setter Property="Stroke" Value="{DynamicResource T.WarnText}" />
    </Style>
    <Style Selector="v|LineIcon.tone[Tag=bad]">
      <Setter Property="Stroke" Value="{DynamicResource S.Red}" />
    </Style>
    <Style Selector="v|LineIcon.tone[Tag=muted]">
      <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
    </Style>
    <Style Selector="Border.mini-circle">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
  </Window.Styles>
  <Window.DataTemplates>
    <DataTemplate DataType="c:ActivityItem">
      <Grid Classes="enter" ColumnDefinitions="Auto,*,Auto" Height="34">
        <Border Classes="mini-circle">
          <v:LineIcon Classes="icon tone" Tag="{Binding Tone}" Width="12" Height="12" StrokeThickness="2.6"
                      Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Primary}" Classes="strong" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="c:ActivityFolder">
      <Grid Classes="enter" ColumnDefinitions="Auto,*,Auto" Height="34">
        <Border Classes="mini-circle">
          <v:LineIcon Classes="icon tone" Tag="{Binding Tone}" Width="12" Height="12" StrokeThickness="2.2" Data="{StaticResource I.Folder}" />
        </Border>
        <TextBlock Grid.Column="1" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
          <Run Text="{Binding Primary}" FontWeight="SemiBold" />
          <Run Text="{Binding Secondary, StringFormat=' · {0}'}" Foreground="{DynamicResource T.Muted}" />
        </TextBlock>
        <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <!-- The quick look that opens from the tray / menu bar icon. The margin leaves room for the shadow. -->
  <Border Classes="panel" Margin="10" BoxShadow="0 18 48 0 #38000000">
    <StackPanel Margin="18" Spacing="16">
      <!-- Status -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Panel x:Name="RingHost" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Center">
          <v:ProgressRing x:Name="Ring" Thickness="4" />
          <TextBlock x:Name="RingText" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <v:LineIcon x:Name="RingIcon" Classes="icon" Width="22" Height="22" StrokeThickness="2.4" IsVisible="False" />
        </Panel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Headline" FontSize="20" FontWeight="SemiBold" LetterSpacing="-0.4" Text="Starting…" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Detail" Classes="muted small" TextWrapping="Wrap" MaxHeight="40" />
          <TextBlock x:Name="SpeedLine" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource S.Blue}" Margin="0,1,0,0" IsVisible="False" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon" Width="32" Height="32" MinHeight="32" CornerRadius="9" VerticalAlignment="Top" ToolTip.Tip="More">
          <v:LineIcon Classes="icon" Width="16" Height="16" StrokeThickness="3.2" Data="{StaticResource I.More}" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed">
              <MenuItem Header="Sync now" Click="OnSyncNow" />
              <MenuItem Header="Settings…" Click="OnSettings" />
              <MenuItem Header="History…" Click="OnHistory" />
              <Separator />
              <MenuItem Header="View log" Click="OnViewLog" />
              <MenuItem Header="Report a bug…" Click="OnReportBug" />
              <Separator />
              <MenuItem Header="Quit Pairnets" Click="OnQuit" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>

      <Border Classes="hairline" BorderThickness="0,1,0,1" Padding="0,10">
        <v:DeviceMapView x:Name="Map" Compact="True" />
      </Border>

      <Button x:Name="FixButton" Classes="warn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" Click="OnFix" />

      <!-- Transfer in progress -->
      <StackPanel x:Name="TransferCard" Spacing="7" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:LineIcon x:Name="TransferArrow" Classes="icon rise" Width="13" Height="13" StrokeThickness="2.6"
                        Stroke="{DynamicResource S.Blue}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
            <TextBlock x:Name="TransferTitle" Classes="bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="TransferSpeed" Grid.Column="1" Classes="muted small" Margin="8,0,0,0" VerticalAlignment="Center" />
        </Grid>
        <ProgressBar x:Name="TransferProgress" Classes="thin" Minimum="0" Maximum="100" />
        <TextBlock x:Name="TransferOverall" Classes="muted" FontSize="12" />
      </StackPanel>

      <!-- Something needs a decision -->
      <Button x:Name="AttentionButton" Classes="flat" Padding="0" MinHeight="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="False" Click="OnAttention">
        <Border Classes="callout" Height="38">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Ellipse Width="7" Height="7" Fill="{DynamicResource T.WarnFill}" VerticalAlignment="Center" Margin="0,0,9,0" />
            <TextBlock x:Name="AttentionText" Grid.Column="1" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            <v:LineIcon Grid.Column="2" Classes="icon" Width="14" Height="14" StrokeThickness="2.4" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Chevron}" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Button>

      <!-- Recent activity -->
      <StackPanel>
        <TextBlock Classes="h2" FontSize="12.5" Text="Recent" Margin="0,0,0,4" />
        <ItemsControl x:Name="RecentList" />
        <TextBlock x:Name="RecentEmpty" Classes="muted small" Margin="0,2,0,4" Text="Nothing has synced yet." />
      </StackPanel>

      <!-- Actions -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <Button Classes="accent" MinHeight="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="13.5" Click="OnOpenApp">
          <TextBlock Text="Open Pairnets" />
        </Button>
        <Button Grid.Column="1" MinHeight="38" Margin="8,0,0,0" Click="OnOpenFolder" ToolTip.Tip="Open the synced folder">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <v:LineIcon Classes="icon" Width="15" Height="15" Data="{StaticResource I.Folder}" />
            <TextBlock Text="Folder" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" MinHeight="38" Margin="8,0,0,0" Click="OnPause">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <v:LineIcon x:Name="PauseGlyph" Classes="icon" Width="15" Height="15" Data="{StaticResource I.Pause}" />
            <TextBlock x:Name="PauseText" Text="Pause" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</Window>
