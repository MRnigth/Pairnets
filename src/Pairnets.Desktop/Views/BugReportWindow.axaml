<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Pairnets.Desktop.Views"
        x:Class="Pairnets.Desktop.Views.BugReportWindow"
        Title="Report a bug" Width="640" Height="560" MinWidth="480" MinHeight="360"
        Background="{DynamicResource T.Card}"
        WindowStartupLocation="CenterScreen" Icon="avares://Pairnets/Assets/pairnets-icon-256.png">
  <!-- The bug report window (new look): what happened, two reassurance chips, the report, then the buttons. -->
  <Grid Margin="24,20" RowDefinitions="Auto,Auto,Auto,*,Auto">
    <Grid ColumnDefinitions="Auto,*">
      <Border x:Name="StatusCircle" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource T.AccentSoft}">
        <v:LineIcon x:Name="StatusIcon" Width="20" Height="20" StrokeThickness="2.6" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.FileText}" />
      </Border>
      <StackPanel Grid.Column="1" Spacing="4">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="Building the bug report…" />
        <TextBlock x:Name="Explanation" Classes="muted" FontSize="13" TextWrapping="Wrap"
                   Text="It collects the versions, your settings (never the token), the sync status, the nest's update details, crash notes (cleaned of your files and names), recent activity and the last part of the log." />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
      <Border Classes="chip-ok" CornerRadius="13" Padding="10,0" Height="26">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <v:LineIcon Width="13" Height="13" StrokeThickness="2.2" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.Shield}" />
          <TextBlock x:Name="SentChipText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" Text="Nothing was sent anywhere" />
        </StackPanel>
      </Border>
      <Border Background="{DynamicResource T.Chip}" CornerRadius="13" Padding="10,0" Height="26">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <v:LineIcon Width="13" Height="13" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Lock}" />
          <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" Text="No passwords or keys inside" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Shown when crash cards were not sent yet: the only thing in this window that sends anything, and only when pressed. -->
    <Border x:Name="CrashBanner" Grid.Row="2" Margin="0,14,0,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource T.Border}"
            Background="{DynamicResource T.AccentSoft}" Padding="14,12" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <v:LineIcon Width="18" Height="18" StrokeThickness="2.2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Mail}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="CrashBannerTitle" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Text="Pairnets crashed. Help us fix it?" />
          <TextBlock x:Name="CrashBannerText" Classes="muted" FontSize="12" TextWrapping="Wrap" Text="Send the crash report to us. You see exactly what is sent first." />
        </StackPanel>
        <Button x:Name="SendCrashButton" Grid.Column="2" Classes="accent" Margin="12,0,0,0" Click="OnSendCrash">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <v:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{StaticResource I.Arrow}" />
            <TextBlock Text="Send crash report…" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="{DynamicResource T.Bg}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="14" Margin="0,14,0,0" ClipToBounds="True">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <SelectableTextBlock x:Name="ReportText" Margin="16,12" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12" LineHeight="18" />
      </ScrollViewer>
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="CopyButton" Classes="SecondaryButton" Background="{DynamicResource T.Chip}" IsEnabled="False" Click="OnCopy">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Copy}" />
          <TextBlock Text="Copy again" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="OpenButton" Classes="SecondaryButton" Background="{DynamicResource T.Chip}" IsEnabled="False" Click="OnOpenFile">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.FileText}" />
          <TextBlock Text="Open the saved file" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="accent" Padding="20,0" Content="Close" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
