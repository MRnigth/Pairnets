<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pairnets for macOS and Linux desktops (Avalonia). Windows uses src/Pairnets.Client (WPF). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pairnets.Desktop</RootNamespace>
    <AssemblyName>Pairnets</AssemblyName>
    <ApplicationIcon>..\..\assets\pairnets.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pairnets.Core\Pairnets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\pairnets-icon-256.png" Link="Assets\pairnets-icon-256.png" />
    <!-- The blue folder icon the file manager shows on the Pairnets folder (FolderIcon.Png). -->
    <EmbeddedResource Include="..\..\assets\pairnets-folder-256.png" LogicalName="Pairnets.FolderIcon.png" />
    <AvaloniaResource Include="..\..\assets\fonts\PlusJakartaSans-Regular.ttf" Link="Assets\Fonts\PlusJakartaSans-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\PlusJakartaSans-Medium.ttf" Link="Assets\Fonts\PlusJakartaSans-Medium.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\PlusJakartaSans-SemiBold.ttf" Link="Assets\Fonts\PlusJakartaSans-SemiBold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\PlusJakartaSans-Bold.ttf" Link="Assets\Fonts\PlusJakartaSans-Bold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\PlusJakartaSans-ExtraBold.ttf" Link="Assets\Fonts\PlusJakartaSans-ExtraBold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pairnets.Tests" />
  </ItemGroup>

</Project>
