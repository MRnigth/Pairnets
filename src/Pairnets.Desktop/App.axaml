<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pairnets.Desktop.App"
             Name="Pairnets"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Pairnets/Styles/Palette.axaml" />
        <ResourceInclude Source="avares://Pairnets/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Plus Jakarta Sans (bundled, OFL); system fonts only if it cannot load. -->
      <FontFamily x:Key="F.Sans">avares://Pairnets/Assets/Fonts#Plus Jakarta Sans, Segoe UI, Helvetica Neue, Inter, Noto Sans, sans-serif</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Pairnets/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
