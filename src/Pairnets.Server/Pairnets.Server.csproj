<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Pairnets.Server</RootNamespace>
    <AssemblyName>pairnets-server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pairnets.Core\Pairnets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pairnets.Tests" />
    <!-- Passkeys (WebAuthn): reads the authenticator's CBOR. Microsoft's own package, like every other dependency here. -->
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

  <ItemGroup>
    <!-- The nest's website, built into the program (served by Web/WebUi.cs). -->
    <EmbeddedResource Include="WebUi\**\*" LogicalName="WebUi/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\assets\pairnets-logo.svg" LogicalName="WebUi/assets/logo.svg" />
  </ItemGroup>

</Project>
