<Window x:Class="Tether.Client.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tether" Width="680" Height="540" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" FontSize="13" Background="#FAFAFA">
  <DockPanel>
    <!-- Header: status dot, headline, details, primary fix action -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="Gray" VerticalAlignment="Top" Margin="0,7,14,0" />
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="Headline" Text="Starting…" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="Detail" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0" />
          <TextBlock x:Name="LastSync" Foreground="#888" Margin="0,2,0,0" />
          <TextBlock x:Name="FolderText" Foreground="#888" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="FixButton" Grid.Column="2" Visibility="Collapsed" Padding="14,6" VerticalAlignment="Top"
                Background="#E66E14" Foreground="White" BorderThickness="0" Click="OnFix" />
      </Grid>
    </Border>

    <!-- Current transfer -->
    <Border x:Name="TransferPanel" DockPanel.Dock="Top" Padding="20,10" Background="#F0F6FD" Visibility="Collapsed">
      <StackPanel>
        <DockPanel>
          <TextBlock x:Name="TransferCount" DockPanel.Dock="Right" Foreground="#555" />
          <TextBlock x:Name="TransferFile" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <ProgressBar x:Name="TransferProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" />
      </StackPanel>
    </Border>

    <!-- Buttons -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="16,10">
      <StackPanel Orientation="Horizontal">
        <Button Content="Sync now" Padding="12,4" Margin="0,0,8,0" Click="OnSyncNow" />
        <Button x:Name="PauseButton" Content="Pause" Padding="12,4" Margin="0,0,8,0" Click="OnPause" />
        <Button Content="Open folder" Padding="12,4" Margin="0,0,8,0" Click="OnOpenFolder" />
        <Button Content="Settings…" Padding="12,4" Margin="0,0,8,0" Click="OnSettings" />
        <Button Content="View log" Padding="12,4" Click="OnViewLog" />
      </StackPanel>
    </Border>

    <TabControl Margin="12" BorderThickness="0" Background="Transparent">
      <TabItem Header="Activity">
        <Grid>
          <ListBox x:Name="ActivityList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TimeText}" Foreground="#888" />
                  <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="Bold" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ActivityEmpty" Text="Nothing has happened yet. Changes appear here as they sync."
                     Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
      <TabItem x:Name="AttentionTab" Header="Needs attention">
        <Grid>
          <ListBox x:Name="AttentionList" BorderThickness="0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="2,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Foreground="#555" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Padding="10,3" Margin="8,0,0,0"
                          VerticalAlignment="Center" Click="OnAttentionAction" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="AttentionEmpty" Text="Nothing needs your attention."
                     Foreground="#888" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
