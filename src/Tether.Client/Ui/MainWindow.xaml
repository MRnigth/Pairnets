<Window x:Class="Tether.Client.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Tether.Client.Ui"
        Title="Tether" Width="720" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ui:ActivityBrushConverter x:Key="KindBrush" />
    <ui:ActivityIconConverter x:Key="KindIcon" />
    <ui:DirectionBrushConverter x:Key="DirectionBrush" />
    <Style x:Key="ToolIcon" TargetType="ui:LineIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    </Style>
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- Update banner -->
    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Style="{StaticResource Banner}" Margin="0,0,0,12" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon x:Name="UpdateIcon" Width="20" Height="20" Stroke="{DynamicResource T.Accent}" Data="{StaticResource I.Download}" VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" />
          <TextBlock x:Name="UpdateDetail" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,1,0,0" />
          <ProgressBar x:Name="UpdateProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Margin="0,5,0,0" Visibility="Collapsed" />
        </StackPanel>
        <Button x:Name="UpdateLater" Grid.Column="2" Style="{StaticResource FlatButton}" Content="Later" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnUpdateLater" />
        <Button x:Name="UpdateButton" Grid.Column="3" Style="{StaticResource AccentButton}" Content="Update now" Margin="4,0,0,0" VerticalAlignment="Center" Click="OnUpdateNow" />
      </Grid>
    </Border>

    <!-- Status card -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="StatusBadgeHost" Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,16,0">
          <Ellipse x:Name="StatusBadge" Fill="{StaticResource S.Grey}" />
          <ui:LineIcon x:Name="StatusGlyph" Width="24" Height="24" StrokeThickness="2.6" Stroke="White"
                       Data="{StaticResource I.CloudOff}" />
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="Starting…" />
          <TextBlock x:Name="Detail" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="440"
                     HorizontalAlignment="Left" Margin="0,4,0,0" />
          <WrapPanel Margin="0,8,0,0">
            <Border Style="{StaticResource Pill}" Margin="0,0,8,4">
              <TextBlock x:Name="LastSync" FontSize="12" Text="Not synced yet" />
            </Border>
            <Border x:Name="FolderPill" Style="{StaticResource Pill}" Margin="0,0,8,4">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Width="15" Height="15" StrokeThickness="2.2" Margin="0,0,5,0"
                             Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Folder}" />
                <TextBlock x:Name="FolderText" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="320" />
              </StackPanel>
            </Border>
            <Border x:Name="ConnectionPill" Style="{StaticResource Pill}" Margin="0,0,8,4" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon x:Name="ConnectionIcon" Width="15" Height="15" StrokeThickness="2" Margin="0,0,5,0"
                             Stroke="{DynamicResource S.Green}" Data="{StaticResource I.CloudCheck}" />
                <TextBlock x:Name="ConnectionText" FontSize="12" />
              </StackPanel>
            </Border>
            <Border x:Name="ServerPill" Style="{StaticResource Pill}" Margin="0,0,8,4" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon x:Name="ServerIcon" Width="15" Height="15" StrokeThickness="2" Margin="0,0,5,0"
                             Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Disk}" />
                <TextBlock x:Name="ServerText" FontSize="12" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <StackPanel x:Name="WaitPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="WaitProgress" Style="{StaticResource RoundProgress}" Minimum="0" Maximum="100" />
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="WaitText" Style="{StaticResource MutedSmall}" />
              <TextBlock Grid.Column="1" Style="{StaticResource MutedSmall}" Text="Your own changes still upload" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Style="{StaticResource SubtleButton}" Content="Download now anyway" Click="OnDownloadNow" />
              <TextBlock Style="{StaticResource MutedSmall}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300" Margin="10,0,0,0"
                         Text="Stops waiting by itself if the other computer goes quiet for 2 minutes." />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Button x:Name="FixButton" Grid.Column="2" Style="{StaticResource WarnButton}" Visibility="Collapsed"
                VerticalAlignment="Center" Margin="12,0,0,0" Click="OnFix" />
      </Grid>
    </Border>

    <!-- Current transfer: the whole batch, speed, and the files in progress -->
    <Border x:Name="TransferCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14,18,16" Margin="0,12,0,0" Visibility="Collapsed">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon x:Name="TransferArrow" Width="16" Height="16" StrokeThickness="2.4" Margin="0,0,6,0"
                         Stroke="{StaticResource S.Green}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
            <TextBlock x:Name="TransferTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="TransferSpeed" Grid.Column="1" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" Margin="8,0,0,0" />
          <Border x:Name="LimitPill" Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed">
            <TextBlock x:Name="LimitText" FontSize="11.5" />
          </Border>
        </Grid>
        <ProgressBar x:Name="TransferProgress" Style="{StaticResource RoundProgress}" Minimum="0" Maximum="100" Margin="0,10,0,0" />
        <TextBlock x:Name="TransferOverall" Style="{StaticResource MutedSmall}" Margin="0,8,0,0" />
        <Border x:Name="ActiveDivider" Style="{StaticResource Divider}" Margin="0,10,0,2" />
        <ItemsControl x:Name="ActiveList" Style="{StaticResource PlainList}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,6,16,2" Loaded="OnRowLoaded">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource MutedSmall}" Margin="6,0,0,0" />
                </Grid>
                <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" ui:Motion.SmoothValue="{Binding PercentValue, Mode=OneWay}" Margin="0,4,0,0"
                             Foreground="{Binding IsUpload, Converter={StaticResource DirectionBrush}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
      <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OnSyncNow">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource ToolIcon}" Stroke="White" Data="{StaticResource I.Sync}" />
          <TextBlock Text="Sync now" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnPause">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon x:Name="PauseGlyph" Style="{StaticResource ToolIcon}" Data="{StaticResource I.Pause}" />
          <TextBlock x:Name="PauseText" Text="Pause" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnOpenFolder">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource ToolIcon}" Data="{StaticResource I.Folder}" />
          <TextBlock Text="Open folder" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnSettings">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource ToolIcon}" Data="{StaticResource I.Settings}" />
          <TextBlock Text="Settings" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource SubtleButton}" Click="OnViewLog">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource ToolIcon}" Data="{StaticResource I.Log}" />
          <TextBlock Text="Log" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Activity / Needs attention -->
    <Grid Margin="0,16,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Style="{StaticResource Segments}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ActivityTab" Style="{StaticResource Seg}" GroupName="view" IsChecked="True"
                       Content="Activity" Checked="OnTabChanged" />
          <RadioButton x:Name="AttentionTab" Style="{StaticResource Seg}" GroupName="view" Checked="OnTabChanged">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Needs attention" VerticalAlignment="Center" />
              <Border x:Name="AttentionBadge" Style="{StaticResource Badge}" Margin="7,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AttentionCount" Foreground="White" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8">
        <Grid>
          <ScrollViewer x:Name="ActivityPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActivityList" Style="{StaticResource PlainList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Row}" ToolTip="{Binding TimeText}" Loaded="OnRowLoaded">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
                        <ui:LineIcon Width="19" Height="19" StrokeThickness="2.6" Stroke="White"
                                     Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource MutedSmall}"
                                 VerticalAlignment="Center" Margin="12,0,4,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="ActivityEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}"
                         Data="{StaticResource I.Sync}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Muted}" Text="Nothing has happened yet. Changes appear here as they sync." />
          </StackPanel>

          <ScrollViewer x:Name="AttentionPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="AttentionList" Style="{StaticResource PlainList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Row}" Margin="0,2">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border Width="4" CornerRadius="2" Background="{StaticResource S.Orange}" />
                      <StackPanel Grid.Column="1" Margin="12,2,0,2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,2,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{Binding ActionLabel}" Margin="12,0,0,0"
                              VerticalAlignment="Center" Click="OnAttentionAction" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="AttentionEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <ui:LineIcon Width="30" Height="30" StrokeThickness="1.8" Stroke="{StaticResource S.Green}"
                         Data="{StaticResource I.Check}" HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource Muted}" Text="Nothing needs your attention." />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
