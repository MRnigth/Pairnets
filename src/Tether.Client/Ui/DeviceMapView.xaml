<UserControl x:Class="Tether.Client.Ui.DeviceMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Tether.Client.Ui">
  <!-- This computer ⇄ server ⇄ the other computer. Compact (tray panel) is sized in code. -->
  <UserControl.Resources>
    <Style x:Key="Ring" TargetType="Ellipse">
      <Setter Property="Fill" Value="{DynamicResource T.Node}" />
      <Setter Property="Stroke" Value="{DynamicResource T.NodeRing}" />
      <Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style x:Key="Dot" TargetType="Ellipse">
      <Setter Property="Stroke" Value="{DynamicResource T.Card}" />
      <Setter Property="StrokeThickness" Value="2.5" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>
    <Style x:Key="Glyph" TargetType="ui:LineIcon">
      <Setter Property="StrokeThickness" Value="1.9" />
      <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    </Style>
    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxHeight" Value="34" />
      <Setter Property="Margin" Value="4,1,4,0" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="Col0" Width="150" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition x:Name="Col2" Width="150" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition x:Name="Col4" Width="150" />
    </Grid.ColumnDefinitions>

    <!-- Lines first, so the circles sit on top of their ends. -->
    <ui:FlowLine x:Name="HereLine" Grid.Column="1" Height="14" VerticalAlignment="Top" Margin="-38,23,-38,0" />
    <ui:FlowLine x:Name="OtherLine" Grid.Column="3" Height="14" VerticalAlignment="Top" Margin="-38,23,-38,0" ServerOnLeft="True" />

    <StackPanel Grid.Column="0">
      <Grid x:Name="HereNode" Width="60" Height="60" HorizontalAlignment="Center">
        <Ellipse x:Name="HereRing" Style="{StaticResource Ring}" />
        <ui:LineIcon x:Name="HereIcon" Style="{StaticResource Glyph}" Width="26" Height="26" Data="{StaticResource I.Laptop}" />
        <Ellipse x:Name="HereDot" Style="{StaticResource Dot}" Width="15" Height="15" Fill="{StaticResource S.Green}" />
      </Grid>
      <TextBlock x:Name="HereName" Style="{StaticResource Name}" />
      <TextBlock x:Name="HereDetail" Style="{StaticResource Detail}" />
    </StackPanel>

    <StackPanel Grid.Column="2">
      <Grid x:Name="ServerNode" Width="68" Height="68" HorizontalAlignment="Center">
        <Ellipse x:Name="ServerRing" Style="{StaticResource Ring}" />
        <ui:LineIcon x:Name="ServerIcon" Style="{StaticResource Glyph}" Width="26" Height="26" Data="{StaticResource I.Server}" />
        <Ellipse x:Name="ServerDot" Style="{StaticResource Dot}" Width="15" Height="15" Fill="{StaticResource S.Green}" />
      </Grid>
      <TextBlock x:Name="ServerName" Style="{StaticResource Name}" />
      <TextBlock x:Name="ServerDetail" Style="{StaticResource Detail}" />
    </StackPanel>

    <StackPanel Grid.Column="4">
      <Grid x:Name="OtherNode" Width="60" Height="60" HorizontalAlignment="Center">
        <Ellipse x:Name="OtherRing" Style="{StaticResource Ring}" />
        <ui:LineIcon x:Name="OtherIcon" Style="{StaticResource Glyph}" Width="26" Height="26" Data="{StaticResource I.Computer}" />
        <Ellipse x:Name="OtherDot" Style="{StaticResource Dot}" Width="15" Height="15" Fill="{StaticResource S.Green}" />
      </Grid>
      <TextBlock x:Name="OtherName" Style="{StaticResource Name}" />
      <TextBlock x:Name="OtherDetail" Style="{StaticResource Detail}" />
      <TextBlock x:Name="OtherMore" Style="{StaticResource Detail}" Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
