<Window x:Class="Tether.Client.Ui.ServerUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Tether.Client.Ui"
        Title="Tether – update the server" Width="540" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="22">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="60" Height="60" Margin="0,0,12,0" VerticalAlignment="Top">
        <!-- Spinning ring while the server updates -->
        <Path x:Name="Ring" Width="60" Height="60" Stroke="{DynamicResource T.Accent}" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
              Data="M 30,1.5 A 28.5,28.5 0 0 1 56.8,20.3" />
        <!-- The server badge: bobs while it waits for an answer, pops when done -->
        <Grid x:Name="BadgeHost" Width="44" Height="44">
          <Ellipse x:Name="Badge" Fill="{StaticResource S.Orange}" />
          <ui:LineIcon x:Name="BadgeIcon" Width="22" Height="22" StrokeThickness="2.2" Stroke="White" Data="{StaticResource I.Server}" />
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="18" Text="Your server should be updated" />
        <TextBlock x:Name="Explanation" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>

    <!-- 1. Ask -->
    <StackPanel x:Name="AskPanel" Margin="0,14,0,0">
      <Border Style="{StaticResource CodeBox}" CornerRadius="10" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource MutedSmall}" Text="Server" />
          <TextBlock x:Name="VersionsText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
          <TextBlock Grid.Row="1" Style="{StaticResource MutedSmall}" Text="Takes" Margin="0,4,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12" Text="about 30 seconds" Margin="0,4,0,0" />
          <TextBlock Grid.Row="2" Style="{StaticResource MutedSmall}" Text="Your files" Margin="0,4,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Text="stay as they are; syncing pauses briefly" Margin="0,4,0,0" />
        </Grid>
      </Border>
      <CheckBox x:Name="AlwaysBox" Style="{StaticResource Switch}" Content="From now on, update the server automatically" Margin="0,14,0,0" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
        <Button x:Name="SkipButton" Style="{StaticResource FlatButton}" Content="Don't ask for this version" Click="OnSkip" />
        <Button Style="{StaticResource SubtleButton}" Content="Later" Margin="8,0,0,0" Click="OnLater" />
        <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="Update server" Margin="8,0,0,0" Click="OnUpdate" />
      </StackPanel>
    </StackPanel>

    <!-- 2. Updating -->
    <StackPanel x:Name="BusyPanel" Margin="0,14,0,0" Visibility="Collapsed">
      <TextBlock x:Name="StepText" FontSize="12" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource MutedSmall}" Text="You can close this window. Tether reconnects by itself." Margin="0,4,0,0" />
    </StackPanel>

    <!-- 3. Done or failed -->
    <StackPanel x:Name="ResultPanel" Margin="0,14,0,0" Visibility="Collapsed">
      <StackPanel x:Name="CommandPanel" Visibility="Collapsed">
        <Border Style="{StaticResource CodeBox}">
          <TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap"
                   Text="curl -fsSL https://raw.githubusercontent.com/MRnigth/Tether/main/deploy/get.sh | sudo bash" />
        </Border>
        <Button Style="{StaticResource SubtleButton}" Content="Copy command" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCopy" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
        <Button x:Name="RetryButton" Style="{StaticResource SubtleButton}" Content="Try again" Margin="0,0,8,0" Click="OnUpdate" Visibility="Collapsed" />
        <Button Style="{StaticResource AccentButton}" Content="Close" Click="OnLater" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
