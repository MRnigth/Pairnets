<Window x:Class="Tether.Client.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Tether.Client.Ui"
        Title="Tether" Width="620" Height="780" MinHeight="420" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="CardIcon" TargetType="ui:LineIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Field" TargetType="StackPanel">
      <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
  </Window.Resources>

  <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                PreviewMouseWheel="OnScrollWheel">
  <StackPanel Margin="20">
    <!-- Welcome header (first run only) -->
    <Grid x:Name="WelcomeHeader" Visibility="Collapsed" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image x:Name="AppIcon" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1">
        <TextBlock Style="{StaticResource H1}" Text="Welcome to Tether" />
        <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"
                   Text="Connect to your server, choose the folder to keep in sync, and you're done. The address and token were printed by install.sh on the server." />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="SettingsHeader" Style="{StaticResource H1}" Text="Settings" Margin="0,0,0,12" />

    <!-- Server -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource CardIcon}" Data="{StaticResource I.Server}" />
          <TextBlock Style="{StaticResource H2}" Text="Your server" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource Label}" Text="Server address" />
          <TextBox x:Name="ServerUrlBox" Style="{StaticResource Input}"
                   ToolTip="For example http://100.x.y.z:5075/ (get the IP on the server with: tailscale ip -4)" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource Label}" Text="Token" />
          <PasswordBox x:Name="TokenBox" Style="{StaticResource PasswordInput}" ToolTip="Leave empty to keep the saved token" />
        </StackPanel>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button x:Name="TestButton" Style="{StaticResource SubtleButton}" Content="Test connection" Click="OnTest" VerticalAlignment="Top" />
          <Border x:Name="TestChip" Grid.Column="1" Style="{StaticResource Chip}" Margin="10,0,0,0" Visibility="Collapsed" HorizontalAlignment="Left">
            <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Folder -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource CardIcon}" Data="{StaticResource I.Folder}" />
          <TextBlock Style="{StaticResource H2}" Text="Folder to keep in sync" />
        </StackPanel>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="FolderBox" Style="{StaticResource Input}" VerticalContentAlignment="Center" />
          <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- This computer -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource CardIcon}" Data="{StaticResource I.Computer}" />
          <TextBlock Style="{StaticResource H2}" Text="This computer" />
        </StackPanel>
        <StackPanel Style="{StaticResource Field}">
          <TextBlock Style="{StaticResource Label}" Text="Device name" />
          <TextBox x:Name="DeviceBox" Style="{StaticResource Input}" />
          <TextBlock Style="{StaticResource MutedSmall}" Margin="0,5,0,0" TextWrapping="Wrap"
                     Text="Shown in conflict file names. Use a different name on each computer." />
        </StackPanel>
        <CheckBox x:Name="AutoStartBox" Style="{StaticResource Switch}" Content="Start Tether when I sign in to Windows" Margin="0,14,0,0" />
        <Expander Style="{StaticResource Disclosure}" Header="Advanced: files to ignore" Margin="0,14,0,0">
          <StackPanel>
            <TextBox x:Name="IgnoreBox" Style="{StaticResource Input}" Height="76" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" ToolTip="One pattern per line, e.g. *.bak or node_modules/" />
            <TextBlock Style="{StaticResource MutedSmall}" Margin="0,5,0,0" TextWrapping="Wrap"
                       Text="One pattern per line, e.g. *.bak or node_modules/. Temporary and system files (~$*, *.tmp, Thumbs.db, .git/ …) are always ignored." />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- Updates and speed -->
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Style="{StaticResource CardIcon}" Data="{StaticResource I.Bolt}" />
          <TextBlock Style="{StaticResource H2}" Text="Updates and speed" />
        </StackPanel>

        <CheckBox x:Name="UpdateBox" Style="{StaticResource Switch}" Content="Check for updates when Tether starts" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="50,4,0,0"
                   Text="Looks for a new version on GitHub at start-up and once a day. Nothing is installed until you click Update." />
        <StackPanel Orientation="Horizontal" Margin="50,4,0,0">
          <TextBlock x:Name="VersionText" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" />
          <Button x:Name="CheckNowButton" Style="{StaticResource FlatButton}" Padding="6,3" FontSize="12" Margin="6,0,0,0"
                  Foreground="{DynamicResource T.Accent}" Content="Check now" Click="OnCheckNow" />
        </StackPanel>
        <TextBlock x:Name="ServerVersionText" Style="{StaticResource MutedSmall}" Margin="50,4,0,0" />
        <CheckBox x:Name="AutoServerBox" Style="{StaticResource Switch}" Content="Update the server automatically" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="50,4,0,0"
                   Text="When this app finds the server on an older version, it updates it without asking (about 30 seconds; your files are not touched)." />
        <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />

        <CheckBox x:Name="WaitBox" Style="{StaticResource Switch}" Content="Wait while my other computer uploads many files" Margin="0,12,0,0" />
        <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="50,4,0,0"
                   Text="When the other computer sends more than 100 files, download them in one go after it finishes instead of a few at a time." />
        <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />

        <TextBlock Style="{StaticResource Label}" Text="Files at the same time" Margin="0,12,0,6" />
        <Border Style="{StaticResource Segments}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Par1" Style="{StaticResource Seg}" GroupName="par" Content="1" />
            <RadioButton x:Name="Par2" Style="{StaticResource Seg}" GroupName="par" Content="2" />
            <RadioButton x:Name="Par4" Style="{StaticResource Seg}" GroupName="par" Content="4" />
            <RadioButton x:Name="Par8" Style="{StaticResource Seg}" GroupName="par" Content="8" />
          </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,5,0,0"
                   Text="4 is fastest for most connections. Use 1 on a very slow or metered connection." />
        <Border Style="{StaticResource Divider}" Margin="0,12,0,0" />

        <TextBlock Style="{StaticResource Label}" Text="Speed limits" Margin="0,12,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="90" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <CheckBox x:Name="UpLimitBox" Style="{StaticResource Switch}" Content="Limit upload to the server to" VerticalAlignment="Center" Margin="0,0,12,8" />
          <TextBox x:Name="UpLimitValue" Grid.Column="1" Style="{StaticResource Input}" Text="5" Margin="0,0,8,8" />
          <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="MB/s" VerticalAlignment="Center" Margin="0,0,0,8" />
          <CheckBox x:Name="DownLimitBox" Grid.Row="1" Style="{StaticResource Switch}" Content="Limit download from the server to" VerticalAlignment="Center" Margin="0,0,12,0" />
          <TextBox x:Name="DownLimitValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Text="10" Margin="0,0,8,0" />
          <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Muted}" Text="MB/s" VerticalAlignment="Center" />
        </Grid>
        <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Files from your other computers always come through the server, so the download limit covers them too. All files at once stay under the limit together." />
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Style="{StaticResource SubtleButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
      <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
