<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tether for macOS and Linux desktops (Avalonia). Windows uses src/Tether.Client (WPF). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Tether.Desktop</RootNamespace>
    <AssemblyName>Tether</AssemblyName>
    <ApplicationIcon>..\..\assets\tether.ico</ApplicationIcon>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tether.Core\Tether.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\tether-icon-256.png" Link="Assets\tether-icon-256.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tether.Tests" />
  </ItemGroup>

</Project>
