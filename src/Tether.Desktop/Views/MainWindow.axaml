<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Tether.Desktop.Views.MainWindow"
        Title="Tether" Width="680" Height="540" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterScreen" Icon="avares://Tether/Assets/tether-icon-256.png">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="20,16" BorderBrush="#22808080" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse x:Name="StatusDot" Width="16" Height="16" Fill="Gray" VerticalAlignment="Top" Margin="0,8,14,0" />
        <StackPanel Grid.Column="1" Spacing="2">
          <TextBlock x:Name="Headline" Text="Starting…" FontSize="22" FontWeight="SemiBold" />
          <TextBlock x:Name="Detail" Opacity="0.75" TextWrapping="Wrap" />
          <TextBlock x:Name="LastSync" Opacity="0.6" />
          <TextBlock x:Name="FolderText" Opacity="0.6" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button x:Name="FixButton" Grid.Column="2" IsVisible="False" VerticalAlignment="Top"
                Background="#E66E14" Foreground="White" Click="OnFix" />
      </Grid>
    </Border>

    <Border x:Name="TransferPanel" DockPanel.Dock="Top" Padding="20,10" Background="#1A2176D6" IsVisible="False">
      <StackPanel Spacing="6">
        <DockPanel>
          <TextBlock x:Name="TransferCount" DockPanel.Dock="Right" Opacity="0.75" />
          <TextBlock x:Name="TransferFile" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <ProgressBar x:Name="TransferProgress" Height="6" Minimum="0" Maximum="100" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,10" BorderBrush="#22808080" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Sync now" Click="OnSyncNow" />
        <Button x:Name="PauseButton" Content="Pause" Click="OnPause" />
        <Button Content="Open folder" Click="OnOpenFolder" />
        <Button Content="Settings…" Click="OnSettings" />
        <Button Content="View log" Click="OnViewLog" />
      </StackPanel>
    </Border>

    <TabControl Margin="8">
      <TabItem Header="Activity">
        <Grid>
          <ListBox x:Name="ActivityList" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="70,24,*">
                  <TextBlock Text="{Binding TimeText}" Opacity="0.6" />
                  <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="Bold" />
                  <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="ActivityEmpty" Text="Nothing has happened yet. Changes appear here as they sync."
                     Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
      <TabItem x:Name="AttentionTab" Header="Needs attention">
        <Grid>
          <ListBox x:Name="AttentionList" Background="Transparent">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="{Binding ActionLabel}" Margin="8,0,0,0" VerticalAlignment="Center"
                          Click="OnAttentionAction" Tag="{Binding}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="AttentionEmpty" Text="Nothing needs your attention."
                     Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
