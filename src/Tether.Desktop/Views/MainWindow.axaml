<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tether.Desktop.Views"
        x:Class="Tether.Desktop.Views.MainWindow"
        Title="Tether" Width="720" Height="700" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen" Icon="avares://Tether/Assets/tether-icon-256.png">
  <Window.Resources>
    <v:ActivityBrushConverter x:Key="KindBrush" />
    <v:ActivityIconConverter x:Key="KindIcon" />
  </Window.Resources>

  <DockPanel Margin="16">
    <!-- Update banner -->
    <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Classes="banner" Margin="0,0,0,12" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <v:LineIcon Classes="icon bob" Width="20" Height="20" Stroke="{DynamicResource T.Accent}" Data="{StaticResource I.Download}"
                    VerticalAlignment="Center" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
          <TextBlock x:Name="UpdateTitle" Classes="strong" />
          <TextBlock x:Name="UpdateDetail" Classes="muted small" TextWrapping="Wrap" />
          <ProgressBar x:Name="UpdateProgress" Classes="thin" Minimum="0" Maximum="100" Margin="0,4,0,0" IsVisible="False" />
        </StackPanel>
        <Button x:Name="UpdateLater" Grid.Column="2" Classes="flat" Content="Later" Margin="8,0,0,0" VerticalAlignment="Center" Click="OnUpdateLater" />
        <Button x:Name="UpdateButton" Grid.Column="3" Classes="accent" Content="Update now" Margin="4,0,0,0" VerticalAlignment="Center" Click="OnUpdateNow" />
      </Grid>
    </Border>

    <!-- Status card -->
    <Border DockPanel.Dock="Top" Classes="card">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Grid x:Name="StatusBadgeHost" Width="52" Height="52" VerticalAlignment="Top" Margin="0,0,16,0">
          <Ellipse x:Name="StatusBadge" Fill="{StaticResource S.Grey}" />
          <v:LineIcon x:Name="StatusGlyph" Classes="icon white" Width="24" Height="24" StrokeThickness="2.6"
                Data="{StaticResource I.CloudOff}" />
        </Grid>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="Headline" Classes="h1" Text="Starting…" />
          <TextBlock x:Name="Detail" Classes="muted" TextWrapping="Wrap" MaxWidth="440" HorizontalAlignment="Left" />
          <WrapPanel Margin="0,4,0,0">
            <Border Classes="pill" Margin="0,0,8,4">
              <TextBlock x:Name="LastSync" Classes="small" Text="Not synced yet" />
            </Border>
            <Border x:Name="FolderPill" Classes="pill" Margin="0,0,8,4">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <v:LineIcon Classes="icon muted" Width="15" Height="15" StrokeThickness="2.2" Data="{StaticResource I.Folder}" />
                <TextBlock x:Name="FolderText" Classes="small" TextTrimming="CharacterEllipsis" MaxWidth="320" />
              </StackPanel>
            </Border>
            <Border x:Name="ConnectionPill" Classes="pill" Margin="0,0,8,4" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <v:LineIcon x:Name="ConnectionIcon" Classes="icon" Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.CloudCheck}" />
                <TextBlock x:Name="ConnectionText" Classes="small" />
              </StackPanel>
            </Border>
            <Border x:Name="VersionPill" Classes="pill" Margin="0,0,8,4" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <v:LineIcon Classes="icon muted" Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.Server}" />
                <TextBlock x:Name="VersionText" Classes="small" VerticalAlignment="Center" />
                <Button x:Name="VersionButton" Classes="subtle" Padding="8,1" FontSize="12" Click="OnUpdateServer" />
              </StackPanel>
            </Border>
            <Border x:Name="ServerPill" Classes="pill" Margin="0,0,8,4" IsVisible="False">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <v:LineIcon x:Name="ServerIcon" Classes="icon muted" Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.Disk}" />
                <TextBlock x:Name="ServerText" Classes="small" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <StackPanel x:Name="WaitPanel" Spacing="6" Margin="0,8,0,0" IsVisible="False">
            <ProgressBar x:Name="WaitProgress" Minimum="0" Maximum="100" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock x:Name="WaitText" Classes="muted small" />
              <TextBlock Grid.Column="1" Classes="muted small" Text="Your own changes still upload" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
              <Button Classes="subtle" Content="Download now anyway" Click="OnDownloadNow" />
              <TextBlock Classes="muted small" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"
                         Text="Stops waiting by itself if the other computer goes quiet for 2 minutes." />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Button x:Name="FixButton" Grid.Column="2" Classes="warn" IsVisible="False" VerticalAlignment="Center"
                Margin="12,0,0,0" Click="OnFix" />
      </Grid>
    </Border>

    <!-- Current transfer: the whole batch, speed, and the files in progress -->
    <Border x:Name="TransferCard" DockPanel.Dock="Top" Classes="card" Margin="0,12,0,0" Padding="18,14,18,16" IsVisible="False">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <v:LineIcon x:Name="TransferArrow" Classes="icon rise" Width="16" Height="16" StrokeThickness="2.4"
                        Stroke="{StaticResource S.Green}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
            <TextBlock x:Name="TransferTitle" Classes="strong" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock x:Name="TransferSpeed" Grid.Column="1" Classes="muted small" VerticalAlignment="Center" Margin="8,0,0,0" />
          <Border x:Name="LimitPill" Grid.Column="2" Classes="pill" Margin="8,0,0,0" IsVisible="False">
            <TextBlock x:Name="LimitText" FontSize="11.5" />
          </Border>
        </Grid>
        <ProgressBar x:Name="TransferProgress" Minimum="0" Maximum="100" />
        <TextBlock x:Name="TransferOverall" Classes="muted small" />
        <Border x:Name="ActiveDivider" Classes="divider" Margin="0,2,0,0" />
        <ItemsControl x:Name="ActiveList">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Classes="enter" Spacing="4" Margin="0,4,16,4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding FileName}" Classes="strong" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding PercentText}" Classes="muted small" Margin="6,0,0,0" />
                </Grid>
                <ProgressBar Classes="thin" Classes.up="{Binding IsUpload}" Classes.down="{Binding !IsUpload}"
                             Minimum="0" Maximum="100" Value="{Binding PercentValue}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
      <Button Classes="accent" Click="OnSyncNow">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon Classes="icon white" Width="17" Height="17" Data="{StaticResource I.Sync}" />
          <TextBlock Text="Sync now" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Click="OnPause">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon x:Name="PauseGlyph" Classes="icon" Width="17" Height="17" Data="{StaticResource I.Pause}" />
          <TextBlock x:Name="PauseText" Text="Pause" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Click="OnOpenFolder">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Folder}" />
          <TextBlock Text="Open folder" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Click="OnSettings">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Settings}" />
          <TextBlock Text="Settings" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Click="OnViewLog">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Log}" />
          <TextBlock Text="Log" />
        </StackPanel>
      </Button>
      <Button Classes="subtle" Click="OnReportBug" ToolTip.Tip="Copies a report for troubleshooting (never the token)">
        <StackPanel Orientation="Horizontal" Spacing="7">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Warning}" />
          <TextBlock Text="Report a bug" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Activity / Needs attention -->
    <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
      <Border Classes="segments" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="ActivityTab" Classes="seg" GroupName="view" IsChecked="True" Content="Activity" IsCheckedChanged="OnTabChanged" />
          <RadioButton x:Name="AttentionTab" Classes="seg" GroupName="view" IsCheckedChanged="OnTabChanged">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="Needs attention" />
              <Border x:Name="AttentionBadge" Classes="badge" IsVisible="False">
                <TextBlock x:Name="AttentionCount" Foreground="White" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <Border Grid.Row="1" Classes="card" Margin="0,10,0,0" Padding="8">
        <Grid>
          <ScrollViewer x:Name="ActivityPanel">
            <ItemsControl x:Name="ActivityList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row enter" ToolTip.Tip="{Binding TimeText}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Grid Width="30" Height="30" Margin="0,0,12,0">
                        <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
                        <v:LineIcon Classes="icon white" Width="19" Height="19" StrokeThickness="2.6"
                              Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
                      </Grid>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Primary}" Classes="strong" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Secondary}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted small" VerticalAlignment="Center" Margin="12,0,4,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="ActivityEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <v:LineIcon Classes="icon muted" Width="30" Height="30" StrokeThickness="1.6" Data="{StaticResource I.Sync}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="Nothing has happened yet. Changes appear here as they sync." />
          </StackPanel>

          <ScrollViewer x:Name="AttentionPanel" IsVisible="False">
            <ItemsControl x:Name="AttentionList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row" Margin="0,2">
                    <Grid ColumnDefinitions="4,*,Auto">
                      <Border Width="4" CornerRadius="2" Background="{StaticResource S.Orange}" />
                      <StackPanel Grid.Column="1" Margin="12,2,0,2" Spacing="2">
                        <TextBlock Text="{Binding Title}" Classes="strong" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Classes="muted small" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="2" Classes="subtle" Content="{Binding ActionLabel}" Margin="12,0,0,0"
                              VerticalAlignment="Center" Click="OnAttentionAction" Tag="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <StackPanel x:Name="AttentionEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="False">
            <v:LineIcon Classes="icon" Width="30" Height="30" StrokeThickness="1.8" Stroke="{StaticResource S.Green}" Data="{StaticResource I.Check}" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" Text="Nothing needs your attention." />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
