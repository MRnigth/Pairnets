<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tether.Desktop.Views"
        xmlns:c="using:Tether.Core.Client"
        x:Class="Tether.Desktop.Views.TrayPanel"
        Title="Tether" Width="392" SizeToContent="Height" CanResize="False"
        SystemDecorations="None" ShowInTaskbar="False" Topmost="True"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Icon="avares://Tether/Assets/tether-icon-256.png">
  <Window.Resources>
    <v:ActivityBrushConverter x:Key="KindBrush" />
    <v:ActivityIconConverter x:Key="KindIcon" />
  </Window.Resources>

  <!-- The quick look that opens from the tray / menu bar icon. The margin leaves room for the shadow. -->
  <Border Classes="panel" Margin="10" BoxShadow="0 8 28 0 #38000000">
    <StackPanel>
      <!-- Status -->
      <Border x:Name="Head" CornerRadius="14,14,0,0" Padding="16,16,10,8">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Grid x:Name="StatusBadgeHost" Width="38" Height="38" VerticalAlignment="Top" Margin="0,0,12,0">
            <Ellipse x:Name="StatusBadge" Fill="{StaticResource S.Grey}" />
            <v:LineIcon x:Name="StatusGlyph" Classes="icon white" Width="19" Height="19" StrokeThickness="2.6" Data="{StaticResource I.CloudOff}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
            <TextBlock x:Name="Headline" Classes="h2" FontSize="16" Text="Starting…" />
            <TextBlock x:Name="Detail" Classes="muted small" TextWrapping="Wrap" MaxHeight="48" />
          </StackPanel>
          <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Top" ToolTip.Tip="More">
            <v:LineIcon Classes="icon" Width="18" Height="18" StrokeThickness="3.2" Data="{StaticResource I.More}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight" Opened="OnMenuOpened" Closed="OnMenuClosed">
                <MenuItem Header="Sync now" Click="OnSyncNow" />
                <MenuItem Header="Settings…" Click="OnSettings" />
                <MenuItem Header="History…" Click="OnHistory" />
                <Separator />
                <MenuItem Header="View log" Click="OnViewLog" />
                <MenuItem Header="Report a bug…" Click="OnReportBug" />
                <Separator />
                <MenuItem Header="Quit Tether" Click="OnQuit" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <StackPanel Margin="14,4,14,14" Spacing="12">
        <v:DeviceMapView x:Name="Map" Compact="True" Margin="0,6,0,0" />

        <Button x:Name="FixButton" Classes="warn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="False" Click="OnFix" />

        <!-- Transfer in progress -->
        <Border x:Name="TransferCard" Classes="card" Padding="12,10" IsVisible="False">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Orientation="Horizontal" Spacing="5">
                <v:LineIcon x:Name="TransferArrow" Classes="icon rise" Width="14" Height="14" StrokeThickness="2.4"
                            Stroke="{StaticResource S.Green}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
                <TextBlock x:Name="TransferTitle" Classes="strong small" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="TransferSpeed" Grid.Column="1" Classes="muted small" Margin="8,0,0,0" />
            </Grid>
            <ProgressBar x:Name="TransferProgress" Classes="thin" Minimum="0" Maximum="100" />
            <TextBlock x:Name="TransferOverall" Classes="muted small" FontSize="11.5" />
          </StackPanel>
        </Border>

        <!-- Something needs a decision -->
        <Button x:Name="AttentionButton" Classes="flat" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="False" Click="OnAttention">
          <Border Classes="callout" Padding="12,9">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <v:LineIcon Classes="icon" Width="16" Height="16" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" Margin="0,0,9,0" />
              <TextBlock x:Name="AttentionText" Grid.Column="1" Classes="strong small" VerticalAlignment="Center" />
              <v:LineIcon Grid.Column="2" Classes="icon" Width="14" Height="14" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Chevron}" />
            </Grid>
          </Border>
        </Button>

        <!-- Recent activity -->
        <Border Classes="card" Padding="6,8,6,6">
          <StackPanel>
            <TextBlock Classes="caps" Text="RECENT" Margin="8,0,0,4" />
            <ItemsControl x:Name="RecentList">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="c:ActivityItem">
                  <Border Classes="row enter" Padding="6,5">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Grid Width="24" Height="24" Margin="0,0,10,0">
                        <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
                        <v:LineIcon Classes="icon white" Width="15" Height="15" StrokeThickness="2.6"
                                    Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding Primary}" Classes="small" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding WhenText}" Classes="muted small" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,2,0" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="RecentEmpty" Classes="muted small" Margin="8,2,8,4" Text="Nothing has synced yet." />
          </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid ColumnDefinitions="*,Auto,Auto">
          <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnOpenApp">
            <TextBlock Text="Open Tether" />
          </Button>
          <Button Grid.Column="1" Classes="subtle" Margin="8,0,0,0" Click="OnOpenFolder" ToolTip.Tip="Open the synced folder">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:LineIcon Classes="icon" Width="16" Height="16" Data="{StaticResource I.Folder}" />
              <TextBlock Text="Folder" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="subtle" Margin="8,0,0,0" Click="OnPause">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <v:LineIcon x:Name="PauseGlyph" Classes="icon" Width="16" Height="16" Data="{StaticResource I.Pause}" />
              <TextBlock x:Name="PauseText" Text="Pause" />
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
