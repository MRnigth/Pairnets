<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tether.Desktop.Views"
        x:Class="Tether.Desktop.Views.SettingsWindow"
        Title="Tether" Width="620" Height="780" MinHeight="420" CanResize="True"
        WindowStartupLocation="CenterScreen" Icon="avares://Tether/Assets/tether-icon-256.png">
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" PointerWheelChanged="OnScrollWheel">
  <StackPanel Margin="20" Spacing="12">
    <!-- Welcome header (first run only) -->
    <Grid x:Name="WelcomeHeader" ColumnDefinitions="Auto,*" IsVisible="False" Margin="0,0,0,4">
      <Image Source="avares://Tether/Assets/tether-icon-256.png" Width="52" Height="52" Margin="0,0,14,0" VerticalAlignment="Top" />
      <StackPanel Grid.Column="1" Spacing="3">
        <TextBlock Classes="h1" Text="Welcome to Tether" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Connect to your server, choose the folder to keep in sync, and you're done. The address and token were printed by install.sh on the server." />
      </StackPanel>
    </Grid>
    <TextBlock x:Name="SettingsHeader" Classes="h1" Text="Settings" />

    <!-- Server -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Server}" />
          <TextBlock Classes="h2" Text="Your server" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Server address" />
          <TextBox x:Name="ServerUrlBox" Watermark="http://100.x.y.z:5075/" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Token" />
          <TextBox x:Name="TokenBox" PasswordChar="•" />
        </StackPanel>
        <Grid ColumnDefinitions="Auto,*">
          <Button x:Name="TestButton" Classes="subtle" Content="Test connection" Click="OnTest" VerticalAlignment="Top" />
          <Border x:Name="TestChip" Grid.Column="1" Margin="10,0,0,0" IsVisible="False" HorizontalAlignment="Left">
            <TextBlock x:Name="TestResult" TextWrapping="Wrap" />
          </Border>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Folder -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Folder}" />
          <TextBlock Classes="h2" Text="Folder to keep in sync" />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox x:Name="FolderBox" Watermark="Choose a folder…" />
          <Button Grid.Column="1" Classes="subtle" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- This computer -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Computer}" />
          <TextBlock Classes="h2" Text="This computer" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label" Text="Device name" />
          <TextBox x:Name="DeviceBox" />
          <TextBlock Classes="muted small" Margin="0,4,0,0" Text="Shown in conflict file names. Use a different name on each computer." />
        </StackPanel>
        <ToggleSwitch x:Name="AutoStartBox" OnContent="Start Tether when I log in" OffContent="Start Tether when I log in" />
        <Expander Header="Advanced: files to ignore" HorizontalAlignment="Stretch">
          <StackPanel Spacing="4">
            <TextBox x:Name="IgnoreBox" Height="76" AcceptsReturn="True" Watermark="One pattern per line, e.g. *.bak or node_modules/" />
            <TextBlock Classes="muted small" Text="Temporary and system files (~$*, *.tmp, Thumbs.db, .git/ …) are always ignored." TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>

    <!-- Updates and speed -->
    <Border Classes="card">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <v:LineIcon Classes="icon" Width="17" Height="17" Data="{StaticResource I.Bolt}" />
          <TextBlock Classes="h2" Text="Updates and speed" />
        </StackPanel>

        <StackPanel Spacing="3">
          <ToggleSwitch x:Name="UpdateBox" OnContent="Check for updates when Tether starts" OffContent="Check for updates when Tether starts" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Looks for a new version on GitHub at start-up and once a day. Nothing is installed until you click Update." />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="VersionText" Classes="muted small" VerticalAlignment="Center" />
            <Button x:Name="CheckNowButton" Classes="flat" Padding="6,3" FontSize="12" Content="Check now" Foreground="{DynamicResource T.Accent}" Click="OnCheckNow" />
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="3">
          <ToggleSwitch x:Name="AutoServerBox" OnContent="Update the server automatically" OffContent="Update the server automatically" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="When this app finds the server on an older version, it updates it without asking (about 30 seconds; your files are not touched)." />
        </StackPanel>
        <Border Classes="divider" />

        <StackPanel Spacing="3">
          <ToggleSwitch x:Name="WaitBox" OnContent="Wait while my other computer uploads many files" OffContent="Wait while my other computer uploads many files" />
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="When the other computer sends more than 100 files, download them in one go after it finishes instead of a few at a time." />
        </StackPanel>
        <Border Classes="divider" />

        <StackPanel Spacing="6">
          <TextBlock Classes="strong" Text="Files at the same time" />
          <Border Classes="segments" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="Par1" Classes="seg" GroupName="par" Content="1" />
              <RadioButton x:Name="Par2" Classes="seg" GroupName="par" Content="2" />
              <RadioButton x:Name="Par4" Classes="seg" GroupName="par" Content="4" />
              <RadioButton x:Name="Par8" Classes="seg" GroupName="par" Content="8" />
            </StackPanel>
          </Border>
          <TextBlock Classes="muted small" TextWrapping="Wrap" Text="4 is fastest for most connections. Use 1 on a very slow or metered connection." />
        </StackPanel>
        <Border Classes="divider" />

        <StackPanel Spacing="8">
          <TextBlock Classes="strong" Text="Speed limits" />
          <Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto" >
            <CheckBox x:Name="UpLimitBox" Content="Limit upload to the server to" Margin="0,0,10,6" />
            <NumericUpDown x:Name="UpLimitValue" Grid.Column="1" Minimum="0.1" Maximum="10000" Increment="1" Value="5" FormatString="0.##" Width="120" Margin="0,0,8,6" />
            <TextBlock Grid.Column="2" Classes="muted" Text="MB/s" VerticalAlignment="Center" Margin="0,0,0,6" />
            <CheckBox x:Name="DownLimitBox" Grid.Row="1" Content="Limit download from the server to" Margin="0,0,10,0" />
            <NumericUpDown x:Name="DownLimitValue" Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="10000" Increment="1" Value="10" FormatString="0.##" Width="120" Margin="0,0,8,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" Text="MB/s" VerticalAlignment="Center" />
          </Grid>
          <TextBlock Classes="muted small" TextWrapping="Wrap"
                     Text="Files from your other computers always come through the server, so the download limit covers them too. All files at once stay under the limit together." />
        </StackPanel>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Classes="subtle" Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="SaveButton" Classes="accent" Content="Save" IsDefault="True" Click="OnSave" />
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</Window>
