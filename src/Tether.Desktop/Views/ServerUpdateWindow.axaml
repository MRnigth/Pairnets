<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Tether.Desktop.Views"
        x:Class="Tether.Desktop.Views.ServerUpdateWindow"
        Title="Tether – update the server" Width="540" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Icon="avares://Tether/Assets/tether-icon-256.png">
  <StackPanel Margin="22" Spacing="14">
    <Grid ColumnDefinitions="Auto,*">
      <Grid Width="60" Height="60" Margin="0,0,12,0" VerticalAlignment="Top">
        <!-- Spinning ring while the server updates -->
        <Arc x:Name="Ring" Classes="spin" Width="60" Height="60" StartAngle="0" SweepAngle="110" StrokeThickness="3"
             Stroke="{DynamicResource T.Accent}" StrokeLineCap="Round" IsVisible="False" />
        <!-- The server badge: bobs while it waits for an answer, pops when done -->
        <Grid x:Name="BadgeHost" Classes="bob" Width="44" Height="44">
          <Ellipse x:Name="Badge" Fill="{StaticResource S.Orange}" />
          <v:LineIcon x:Name="BadgeIcon" Classes="icon white" Width="22" Height="22" StrokeThickness="2.2" Data="{StaticResource I.Server}" />
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Classes="h2" FontSize="18" Text="Your server should be updated" />
        <TextBlock x:Name="Explanation" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <!-- 1. Ask -->
    <StackPanel x:Name="AskPanel" Spacing="14">
      <Border Classes="pill" CornerRadius="10" Padding="12,10">
        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Classes="muted small" Text="Server" />
          <TextBlock x:Name="VersionsText" Grid.Column="1" Classes="strong small" />
          <TextBlock Grid.Row="1" Classes="muted small" Text="Takes" Margin="0,4,0,0" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="small" Text="about 30 seconds" Margin="0,4,0,0" />
          <TextBlock Grid.Row="2" Classes="muted small" Text="Your files" Margin="0,4,0,0" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="small" Text="stay as they are; syncing pauses briefly" Margin="0,4,0,0" />
        </Grid>
      </Border>
      <CheckBox x:Name="AlwaysBox" Content="From now on, update the server automatically" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Classes="flat" Content="Don't ask for this version" Click="OnSkip" />
        <Button Classes="subtle" Content="Later" Click="OnLater" />
        <Button Classes="accent" Content="Update server" Click="OnUpdate" />
      </StackPanel>
    </StackPanel>

    <!-- 2. Updating -->
    <StackPanel x:Name="BusyPanel" Spacing="6" IsVisible="False">
      <TextBlock x:Name="StepText" Classes="strong small" />
      <TextBlock Classes="muted small" Text="You can close this window. Tether reconnects by itself." />
    </StackPanel>

    <!-- 3. Done, one-time setup, or not updated -->
    <StackPanel x:Name="ResultPanel" Spacing="10" IsVisible="False">
      <StackPanel x:Name="CommandPanel" Spacing="8" IsVisible="False">
        <Border Classes="pill" CornerRadius="8" Padding="10,8">
          <SelectableTextBlock x:Name="CommandText" FontFamily="Menlo, Consolas, DejaVu Sans Mono, monospace" FontSize="12" TextWrapping="Wrap"
                               Text="curl -fsSL https://raw.githubusercontent.com/MRnigth/Tether/main/deploy/get.sh | sudo bash" />
        </Border>
        <Button Classes="subtle" Content="Copy command" HorizontalAlignment="Left" Click="OnCopy" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="RetryButton" Classes="subtle" Content="Try again" Click="OnUpdate" IsVisible="False" />
        <Button Classes="accent" Content="Close" Click="OnLater" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</Window>
