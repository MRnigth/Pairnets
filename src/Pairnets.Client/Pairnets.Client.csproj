<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Pairnets.Client</RootNamespace>
    <AssemblyName>Pairnets</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Pairnets.Client.Program</StartupObject>
    <ApplicationIcon>..\..\assets\pairnets.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; avoid ambiguous names with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="Pairnets.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window and header icon (AppIcons): read from here, not from the exe, so an update shows the new logo at once. -->
    <Resource Include="..\..\assets\pairnets.ico" Link="pairnets.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pairnets.Core\Pairnets.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
