<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Pairnets;component/Themes/Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    The "Quiet" look (same design as the Mac/Linux app): paper and ink, hairlines instead of cards, one
    typeface, colour only where it means something. Colours come from Light.xaml / Dark.xaml, which
    ThemeManager swaps, so every colour here is a DynamicResource.
  -->

  <!-- One typeface everywhere (Instrument Sans, built into the app, so it looks the same on every computer). -->
  <FontFamily x:Key="F.Ui">pack://application:,,,/Pairnets;component/Fonts/#Instrument Sans</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- Keyboard focus: a ring around the control (not shown for mouse clicks). -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource T.Accent}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window -->
  <Style x:Key="PairnetsWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <!-- ================= Text ================= -->
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style x:Key="MutedSmall" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style x:Key="Small" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <!-- The overview's big status ("Up to date"). -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="46" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Page titles. -->
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Section headings ("In progress", "Recent"). -->
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style x:Key="Lead" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="Strong" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="Bold" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- Small labels over facts ("Folder", "Last synced"). -->
  <Style x:Key="Caps" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Day headings in the activity list. -->
  <Style x:Key="Day" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <!-- Settings form -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="Help" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>
  <Style x:Key="SettingLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Margin" Value="0,2,24,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ================= Sections and small shapes ================= -->
  <!-- Sections: a hairline above, no box. ("Card" keeps its name from the old look.) -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,14,0,0" />
  </Style>
  <Style x:Key="Hairline" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style x:Key="HairlineBottom" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <!-- A row in a hairline list: a line under it, no box. -->
  <Style x:Key="LineRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Border}" />
  </Style>
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="WarnPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="OkPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.OkText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="BadPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,3" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Banner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.BannerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <!-- Monospaced text (commands, logs, the bug report) in an input-coloured box. -->
  <Style x:Key="CodeBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <!-- Menus and notices that float over the window. -->
  <Style x:Key="Popover" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Popover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="32" ShadowDepth="10" Direction="270" Opacity="0.16" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>
  <!-- The small outlined circle in front of an activity row, the glyph in the row's colour. -->
  <Style x:Key="GlyphCircle" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <!-- Count badge -->
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnFill}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinWidth" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Padding" Value="4,0" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.BadgeInk}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style.Resources>
  </Style>
  <!-- The round account letter. -->
  <Style x:Key="Avatar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Accent}" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="AvatarLarge" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Accent}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
    </Style.Resources>
  </Style>
  <!-- "2 things need your attention" and other notes that need a decision. -->
  <Style x:Key="Callout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12,0" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
      </Style>
    </Style.Resources>
  </Style>
  <!-- Facts under the overview ("Folder", "Last synced", "Server", "Free space") -->
  <Style x:Key="Tile" TargetType="Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Coloured message chips (History: restored / failed) -->
  <Style x:Key="OkChip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.OkText}" />
      </Style>
    </Style.Resources>
  </Style>
  <Style x:Key="BadChip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,7" />
    <Style.Resources>
      <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
      </Style>
    </Style.Resources>
  </Style>
  <!-- The connection test's result (Settings) -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,6" />
  </Style>
  <Style x:Key="ChipOk" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
  </Style>
  <Style x:Key="ChipBad" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
  </Style>
  <!-- The icon rail -->
  <Style x:Key="Sidebar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <!-- The tray panel: a card that floats next to the taskbar -->
  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <!-- List rows that light up under the mouse -->
  <Style x:Key="Row" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource T.Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <!-- Status dots on a computer (Devices) -->
  <Style x:Key="Dot" TargetType="Ellipse">
    <Setter Property="Stroke" Value="{DynamicResource T.Bg}" />
    <Setter Property="StrokeThickness" Value="2" />
  </Style>
  <!-- Glyph colours by meaning (activity rows): Tag is the row's tone. -->
  <Style x:Key="ToneIcon" TargetType="ui:LineIcon">
    <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="move">
        <Setter Property="Stroke" Value="{DynamicResource S.Blue}" />
      </Trigger>
      <Trigger Property="Tag" Value="warn">
        <Setter Property="Stroke" Value="{DynamicResource T.WarnText}" />
      </Trigger>
      <Trigger Property="Tag" Value="bad">
        <Setter Property="Stroke" Value="{DynamicResource S.Red}" />
      </Trigger>
      <Trigger Property="Tag" Value="muted">
        <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================= Buttons: outlined by default, ink-filled for the one main action ================= -->
  <!-- One template; the styles set the colours (Look.HoverBackground and friends carry the hover colours). -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
            CornerRadius="{Binding (ui:Look.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{Binding (ui:Look.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
        <Setter TargetName="bd" Property="BorderBrush" Value="{Binding (ui:Look.HoverBorderBrush), RelativeSource={RelativeSource TemplatedParent}}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{Binding (ui:Look.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
      </Trigger>
      <Trigger Property="ui:Look.IsOpen" Value="True">
        <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NavSelected}" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="bd" Property="Opacity" Value="0.5" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ui:Look.CornerRadius" Value="10" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.Hover}" />
    <Setter Property="ui:Look.HoverBorderBrush" Value="{DynamicResource T.Line}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.SubtleHover}" />
  </Style>
  <!-- The everyday button: outlined. -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}" />
  <Style TargetType="Button" BasedOn="{StaticResource SubtleButton}" />
  <!-- The one main action: filled with ink. -->
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource T.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource T.PrimaryInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.PrimaryHover}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.PrimaryHover}" />
  </Style>
  <!-- The way out of a decision ("Allow these deletions"). -->
  <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource T.WarnFill}" />
    <Setter Property="Foreground" Value="{DynamicResource T.BadgeInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.WarnFill}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.WarnFill}" />
  </Style>
  <!-- For actions that cannot be undone (Reset this app, sign out): outlined, in the problem colour. -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.BadPill}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.BadPill}" />
  </Style>
  <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Square icon-only buttons ("…", reload) -->
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <!-- Rail buttons that open a small menu (the update notice, the account). -->
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="ui:Look.CornerRadius" Value="12" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.NavHover}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.NavSelected}" />
  </Style>
  <!-- Rows of a menu inside a popover. -->
  <Style x:Key="MenuItemButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="ui:Look.CornerRadius" Value="8" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.Selected}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.Selected}" />
  </Style>
  <Style x:Key="MenuItemDangerButton" TargetType="Button" BasedOn="{StaticResource MenuItemButton}">
    <Setter Property="Foreground" Value="{DynamicResource T.BadText}" />
  </Style>
  <!-- "2 things need your attention · Review": a soft pill in the header. -->
  <Style x:Key="CalloutButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="ui:Look.CornerRadius" Value="15" />
    <Setter Property="ui:Look.HoverBackground" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="ui:Look.PressedBackground" Value="{DynamicResource T.WarnPill}" />
  </Style>
  <!-- Buttons that look like links -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A whole row that can be clicked (a folder that opens). -->
  <Style x:Key="RowToggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Segmented control (RadioButtons inside a Segments border) ================= -->
  <Style x:Key="Segments" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Margin" Value="0,0,2,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="13,6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Popover}" />
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.12" Color="Black" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= The icon rail (RadioButtons): 44 × 44 squares, the chosen one filled ================= -->
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="12">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NavHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NavSelected}" />
              <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="ui:LineIcon">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="StrokeThickness" Value="1.8" />
      </Style>
    </Style.Resources>
  </Style>

  <!-- ================= Progress: thin bars, one accent colour for both directions ================= -->
  <Style x:Key="RoundProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
    <Setter Property="Background" Value="{DynamicResource T.Track}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid ClipToBounds="True">
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" />
            <!-- No number yet: a short piece that keeps travelling. -->
            <Border x:Name="Travel" Background="{TemplateBinding Foreground}" CornerRadius="2" Width="140" HorizontalAlignment="Left" Visibility="Collapsed">
              <Border.RenderTransform>
                <TranslateTransform x:Name="TravelMove" X="-140" />
              </Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
              <Setter TargetName="Travel" Property="Visibility" Value="Visible" />
              <Trigger.EnterActions>
                <BeginStoryboard x:Name="Travelling">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="TravelMove" Storyboard.TargetProperty="X" From="-140" To="620" Duration="0:0:1.6" />
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <StopStoryboard BeginStoryboardName="Travelling" />
              </Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ThinProgress" TargetType="ProgressBar" BasedOn="{StaticResource RoundProgress}" />

  <!-- ================= Inputs ================= -->
  <Style x:Key="InputBase" TargetType="Control">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource InputBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource T.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="hint" Text="{Binding (ui:Look.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource T.Placeholder}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False" Visibility="Collapsed" />
              <!-- The text box puts its own Padding around the text inside this host. -->
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.InputBorderHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Text}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource T.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" SnapsToDevicePixels="True">
            <Grid>
              <TextBlock x:Name="hint" Text="{Binding (ui:Look.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource T.Placeholder}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                         VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis"
                         IsHitTestVisible="False" Visibility="Collapsed" />
              <!-- The text box puts its own Padding around the text inside this host. -->
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ui:Look.IsEmpty" Value="True">
              <Setter TargetName="hint" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.InputBorderHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Read-only text that can be selected and copied (commands, logs), in a CodeBox. -->
  <Style x:Key="CodeText" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource T.Accent}" />
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch (CheckBox): ink when on -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="40" Height="20" VerticalAlignment="Center">
              <Border x:Name="track" CornerRadius="10" Background="{DynamicResource T.SwitchOff}" />
              <Ellipse x:Name="knob" Width="12" Height="12" Fill="{DynamicResource T.PrimaryInk}" HorizontalAlignment="Left" Margin="4,0,0,0" />
            </Grid>
            <ContentPresenter x:Name="cp" Margin="24,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource T.SwitchOffHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource T.Primary}" />
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="knob" Property="Margin" Value="0,0,4,0" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsChecked" Value="True" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="track" Property="Background" Value="{DynamicResource T.PrimaryHover}" />
            </MultiTrigger>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Check box: a round box, filled with ink and a tick when on -->
  <Style x:Key="Check" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="20" Height="20" VerticalAlignment="Center">
              <Ellipse x:Name="box" Stroke="{DynamicResource T.InputBorderHover}" StrokeThickness="1" Fill="Transparent" />
              <ui:LineIcon x:Name="tick" Width="12" Height="12" StrokeThickness="2.6" Stroke="{DynamicResource T.PrimaryInk}" Data="{StaticResource I.Check}" Visibility="Collapsed" />
            </Grid>
            <ContentPresenter x:Name="cp" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="Stroke" Value="{DynamicResource T.Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Fill" Value="{DynamicResource T.Primary}" />
              <Setter TargetName="box" Property="Stroke" Value="{DynamicResource T.Primary}" />
              <Setter TargetName="tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasContent" Value="False">
              <Setter TargetName="cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Plain look for lists -->
  <Style x:Key="PlainList" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- Selectable rows (History) -->
  <Style x:Key="RowItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="10,9">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Selected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Rows" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsPresenter />
          </ScrollViewer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Scroll bars: thin, over the content, like the Mac/Linux app ================= -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="bar" Background="{DynamicResource T.Line}" CornerRadius="3" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource T.Muted}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource T.Muted}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2,3,2">
            <Track.DecreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Style="{StaticResource ScrollThumb}" />
            </Track.Thumb>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" Margin="2,2,2,3">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                    CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False"
                                    Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Orientation="Vertical" Cursor="Arrow"
                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar x:Name="PART_HorizontalScrollBar" VerticalAlignment="Bottom" Orientation="Horizontal" Cursor="Arrow"
                       Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Menus and tooltips (they float, so they set the typeface themselves) ================= -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="0,0,10,12" Background="{DynamicResource T.Popover}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="190">
            <Border.Effect>
              <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.14" Color="Black" />
            </Border.Effect>
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,7">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter x:Name="icon" ContentSource="Icon" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" />
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
              <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{DynamicResource T.Border}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource T.Popover}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="8" Padding="9,5">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
