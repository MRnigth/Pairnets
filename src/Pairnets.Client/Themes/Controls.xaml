<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/Pairnets;component/Themes/Icons.xaml" />
    <ResourceDictionary Source="pack://application:,,,/Pairnets;component/Themes/Pages.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- The bundled font (Plus Jakarta Sans, 5 static faces linked as Resources). Segoe UI is the fallback. -->
  <FontFamily x:Key="F.Sans">pack://application:,,,/Pairnets;component/Fonts/#Plus Jakarta Sans, Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Window -->
  <Style x:Key="PairnetsWindow" TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <!-- Text -->
  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style x:Key="MutedSmall" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style x:Key="H2" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,5" />
  </Style>

  <!-- Containers -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="22,24" />
  </Style>
  <Style x:Key="Pill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="100" />
    <Setter Property="Padding" Value="11,4" />
  </Style>
  <Style x:Key="Row" TargetType="Border">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Background" Value="Transparent" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource T.Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource S.Orange}" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="5,0" />
  </Style>

  <Style x:Key="WarnPill" TargetType="Border" BasedOn="{StaticResource Pill}">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="Banner" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Banner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.BannerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style x:Key="Divider" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Border}" />
  </Style>
  <Style x:Key="CodeBox" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Pill}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- Buttons: one template, three colour styles -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Tag carries the hover colour. -->
  <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Tag" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>
  <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
    <Setter Property="Tag" Value="{DynamicResource T.AccentButtonHover}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- The tray's "Fix" button: a darker orange than the badge, so the white words read well. -->
  <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource S.OrangeButton}" />
    <Setter Property="Tag" Value="{StaticResource S.OrangeButtonHover}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- For actions that cannot be undone (Reset this app). -->
  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{StaticResource S.Red}" />
    <Setter Property="Tag" Value="{StaticResource S.RedHover}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Tag" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>

  <!-- Segmented control -->
  <Style x:Key="Segments" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="Padding" Value="3" />
  </Style>
  <Style x:Key="Seg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="ring" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent" Margin="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Card}" />
              <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Rounded progress bar -->
  <Style x:Key="RoundProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
    <Setter Property="Background" Value="{DynamicResource T.Track}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="4" HorizontalAlignment="Left" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThinProgress" TargetType="ProgressBar" BasedOn="{StaticResource RoundProgress}">
    <Setter Property="Height" Value="4" />
  </Style>

  <!-- Inputs -->
  <Style x:Key="InputBase" TargetType="Control">
    <Setter Property="Background" Value="{DynamicResource T.Input}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.InputBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="Input" TargetType="TextBox" BasedOn="{StaticResource InputBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
              <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PasswordInput" TargetType="PasswordBox" BasedOn="{StaticResource InputBase}">
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
              <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch (CheckBox) -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="42" Height="24" VerticalAlignment="Center">
              <Border x:Name="ring" CornerRadius="15" BorderThickness="1.5" BorderBrush="Transparent" Margin="-3" IsHitTestVisible="False" />
              <Border x:Name="track" CornerRadius="12" Background="{DynamicResource T.SwitchOff}" />
              <Ellipse x:Name="knob" Width="20" Height="20" Fill="{DynamicResource T.KnobOff}" HorizontalAlignment="Left" Margin="2,0,0,0" />
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource T.AccentButton}" />
              <Setter TargetName="knob" Property="Fill" Value="White" />
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chips for the connection test -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="100" />
    <Setter Property="Padding" Value="11,5" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
  </Style>

  <!-- Plain scroll viewer look for lists -->
  <Style x:Key="PlainList" TargetType="ItemsControl">
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- Expander: a chevron and the header, no system chrome -->
  <Style x:Key="Disclosure" TargetType="Expander">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Foreground="{TemplateBinding Foreground}" Cursor="Hand" FocusVisualStyle="{x:Null}"
                          HorizontalAlignment="Left">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid>
                  <Border x:Name="ring" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent" Margin="-4,-2" IsHitTestVisible="False" />
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <Path x:Name="chev" Data="M2,1 L6,5 L2,9" Stroke="{DynamicResource T.Muted}" StrokeThickness="1.8"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="10" Height="10" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                      <Path.RenderTransform>
                        <RotateTransform x:Name="rot" Angle="0" />
                      </Path.RenderTransform>
                    </Path>
                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                  </Grid>
                  <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="chev" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90" />
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" />
            </ToggleButton>
            <ContentPresenter x:Name="body" Margin="0,10,0,0" Visibility="Collapsed" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="body" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- ================= Main window: sidebar, pages, tiles (same design as the Mac/Linux app) ================= -->
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style x:Key="Caps" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
  </Style>
  <Style x:Key="Value" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Day" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Margin" Value="8,12,0,4" />
  </Style>

  <Style x:Key="Sidebar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Sidebar}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <!-- Sidebar entries: RadioButtons; the icon turns accent when chosen -->
  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,3" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="11,9">
              <ContentPresenter />
            </Border>
            <Border x:Name="ring" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent" Margin="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NavHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NavSelected}" />
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.08" />
                </Setter.Value>
              </Setter>
              <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="ui:LineIcon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="StrokeThickness" Value="2.3" />
        <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
            <Setter Property="Stroke" Value="{DynamicResource T.Accent}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
  </Style>

  <Style x:Key="Hero" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style x:Key="Tile" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Tile}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="5,0" />
  </Style>
  <Style x:Key="Callout" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="14,10,10,10" />
  </Style>
  <Style x:Key="OkChip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.OkPill}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style x:Key="BadChip" TargetType="Border" BasedOn="{StaticResource OkChip}">
    <Setter Property="Background" Value="{DynamicResource T.BadPill}" />
  </Style>
  <Style x:Key="Panel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>

  <!-- A button that looks like a link, and plain icon buttons -->
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Tag" Value="{DynamicResource T.Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Accent}" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Tag" Value="{DynamicResource T.SubtleHover}" />
  </Style>
  <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
    <Setter Property="Padding" Value="6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- Selectable rows (History) -->
  <Style x:Key="RowItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="bd" Background="Transparent" CornerRadius="12" Padding="10,9">
              <ContentPresenter />
            </Border>
            <Border x:Name="ring" CornerRadius="12" BorderThickness="1.5" BorderBrush="Transparent" Margin="0" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Selected}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Rows" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource RowItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <!-- Menus (the window's "…" button, right-click on a file) in the app's colours -->
  <Style TargetType="ContextMenu">
    <Setter Property="FontFamily" Value="{StaticResource F.Sans}" />
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="14" Padding="6" MinWidth="170">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="9" Padding="10,7">
            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="6,4" Background="{DynamicResource T.Border}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= New look (stage 1) ================= -->
  <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource Title}" />
  <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource H2}" />
  <!-- 11 px bold small label (WPF has no letter spacing; write the text in capitals where the design does). -->
  <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource Caps}" />
  <Style x:Key="SoftText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}" />

  <!-- Round icon-only button (34 px circle). -->
  <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="100" Padding="{TemplateBinding Padding}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The attention strip (warm). -->
  <Style x:Key="Attention" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.WarnPill}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.WarnBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="16,12" />
  </Style>

  <!-- The soft square behind an icon (34 px, radius 11). -->
  <Style x:Key="IconSquare" TargetType="Border">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
  </Style>

  <!-- ================= New look (stage 2): the left side and the dock ================= -->
  <!-- The open panel: radius 24 -->
  <Style x:Key="SidePanel" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
  </Style>

  <!-- A flat clickable row (this computer, the nest): the background is the state colour -->
  <Style x:Key="SideRow" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" />
            <Border x:Name="hv" Background="{DynamicResource T.Hover}" CornerRadius="16" Opacity="0" IsHitTestVisible="False" />
            <ContentPresenter Margin="12,10" HorizontalAlignment="Stretch" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="hv" Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="hv" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A computer cell in the group: no chrome -->
  <Style x:Key="SideCell" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="0,2">
            <ContentPresenter HorizontalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Page tiles (2x3, 72 high, radius 18). Blue when chosen, with white text. -->
  <Style x:Key="SideTile" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Height" Value="72" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="4" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{DynamicResource T.Tile}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="18" Padding="12,11">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentButton}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.AccentButton}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="ui:LineIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
            <Setter Property="Stroke" Value="White" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
  </Style>
  <!-- The Needs-you tile: amber, and solid amber when chosen -->
  <Style x:Key="SideTileAmber" TargetType="RadioButton" BasedOn="{StaticResource SideTile}">
    <Setter Property="Foreground" Value="{DynamicResource T.WarnText}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" BorderThickness="1" CornerRadius="18" Padding="12,11">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.NeedsActive}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.NeedsActive}" />
              <Setter Property="Foreground" Value="{DynamicResource T.NeedsActiveText}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="ui:LineIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource T.WarnText}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
            <Setter Property="Stroke" Value="{DynamicResource T.NeedsActiveText}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
  </Style>

  <!-- The folded dock: pills of round 44 px buttons -->
  <Style x:Key="DockPill" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Padding" Value="7,5" />
    <Setter Property="Width" Value="60" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="0.25" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DockButton" TargetType="Button">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DockPage" TargetType="RadioButton">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="22">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentButton}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <Style TargetType="ui:LineIcon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
            <Setter Property="Stroke" Value="White" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </Style.Resources>
  </Style>
</ResourceDictionary>
