  <!-- Text -->
  <Style x:Key="PgTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style x:Key="PgSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="Margin" Value="0,2,0,0" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- 11 px bold label: write the text in capitals (WPF has no letter spacing or text-transform). -->
  <Style x:Key="PgCaps" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style x:Key="PgSmall" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
  </Style>
  <Style x:Key="PgName" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="PgCardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
  </Style>

  <!-- Containers -->
  <Style x:Key="PgCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <Style x:Key="PgChipSquare" TargetType="Border">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
  </Style>
  <Style x:Key="PgHair" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource T.Border}" />
  </Style>

  <!-- Buttons: one template with its own corner radius (Pg.Radius) and hover colour (Tag) -->
  <Style x:Key="PgButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource T.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Tag" Value="{DynamicResource T.Hover}" />
    <Setter Property="Height" Value="38" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                  CornerRadius="{Binding (ui:Pg.Radius), RelativeSource={RelativeSource TemplatedParent}}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PgPrimary" TargetType="Button" BasedOn="{StaticResource PgButton}">
    <Setter Property="Background" Value="{DynamicResource T.AccentButton}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Tag" Value="{DynamicResource T.AccentButtonHover}" />
  </Style>
  <Style x:Key="PgDanger" TargetType="Button" BasedOn="{StaticResource PgButton}">
    <Setter Property="Background" Value="{DynamicResource T.DangerBtn}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Tag" Value="#A61B25" />
  </Style>
  <!-- Grey chip fill, round 11 (Sign in again, Sign out, Change...) -->
  <Style x:Key="PgChipButton" TargetType="Button" BasedOn="{StaticResource PgButton}">
    <Setter Property="Background" Value="{DynamicResource T.Chip}" />
    <Setter Property="Tag" Value="{DynamicResource T.SubtleHover}" />
    <Setter Property="ui:Pg.Radius" Value="11" />
  </Style>
  <!-- 32 high, round 10, 12 bold (Restore) -->
  <Style x:Key="PgSmallButton" TargetType="Button" BasedOn="{StaticResource PgButton}">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="ui:Pg.Radius" Value="10" />
  </Style>
  <!-- Text that looks like a link (accent ink, 12 bold) -->
  <Style x:Key="PgLink" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A square icon button: Refresh (42) -->
  <Style x:Key="PgIconButton" TargetType="Button" BasedOn="{StaticResource PgButton}">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ui:Pg.Radius" Value="14" />
  </Style>

  <!-- A flat row you can press (the Help card): transparent, soft hover on its rounded left side -->
  <Style x:Key="PgFlat" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="20,0,0,20">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Filter pills (Activity): a round 36 high toggle; the chosen one is soft blue -->
  <Style x:Key="PgPill" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRingRound}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Height="36" Padding="14,0" CornerRadius="18" BorderThickness="1"
                  Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentSoft}" />
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The count in a filter pill: soft, and accent ink in the chosen pill (no see-through text) -->
  <Style x:Key="PgCount" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- History's two tabs -->
  <Style x:Key="PgTabs" TargetType="Border" BasedOn="{StaticResource PgCard}">
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style x:Key="PgTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Height="32" Padding="14,0" CornerRadius="10" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentSoft}" />
              <Setter Property="Foreground" Value="{DynamicResource T.AccentInk}" />
              <Setter Property="FontWeight" Value="Bold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The 1 / 2 / 4 / 8 segments in Settings -->
  <Style x:Key="PgSeg" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" CornerRadius="8" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentButton}" />
              <Setter Property="Foreground" Value="White" />
              <Setter Property="FontWeight" Value="ExtraBold" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text fields on the pages -->
  <Style x:Key="PgInput" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource T.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PgPassword" TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource T.Field}" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="{DynamicResource T.Text}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource T.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The switch of the new look: 42 x 24, the knob 20 -->
  <Style x:Key="PgSwitch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="42" Height="24" VerticalAlignment="Center">
              <Border x:Name="track" CornerRadius="12" Background="{DynamicResource T.SwitchOff}" />
              <Ellipse x:Name="knob" Width="20" Height="20" Fill="{DynamicResource T.KnobOff}" HorizontalAlignment="Left" Margin="2,0,0,0" />
            </Grid>
            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource T.AccentButton}" />
              <Setter TargetName="knob" Property="Fill" Value="White" />
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="knob" Property="Margin" Value="0,0,2,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The selectable file rows of History's All files list -->
  <Style x:Key="PgFileItem" TargetType="ListBoxItem">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusRing}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="14" Padding="10,8">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource T.AccentSoft}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PgFileList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource PgFileItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
</ResourceDictionary>
