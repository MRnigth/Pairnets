<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The "Quiet" palette (same values as the Mac/Linux app): warm paper and ink, hairlines instead of cards.
    T.* are surfaces and text; S.* carry meaning (green up to date, blue syncing and uploads, grey waiting or
    offline, orange needs a decision, red a problem) and differ per theme so they stay readable.
  -->
  <SolidColorBrush x:Key="T.Bg" Color="#F7F6F3" />
  <SolidColorBrush x:Key="T.Card" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.Popover" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.Text" Color="#1B1A17" />
  <SolidColorBrush x:Key="T.Muted" Color="#69655D" />
  <SolidColorBrush x:Key="T.Border" Color="#E3E0D9" />
  <SolidColorBrush x:Key="T.Hover" Color="#EFEDE8" />
  <SolidColorBrush x:Key="T.Subtle" Color="#ECE9E3" />
  <SolidColorBrush x:Key="T.SubtleHover" Color="#E2DED6" />
  <SolidColorBrush x:Key="T.Accent" Color="#2F47C4" />
  <SolidColorBrush x:Key="T.AccentHover" Color="#263BA6" />
  <SolidColorBrush x:Key="T.AccentInk" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.AccentSoft" Color="#E7EAF9" />
  <SolidColorBrush x:Key="T.Primary" Color="#1B1A17" />
  <SolidColorBrush x:Key="T.PrimaryHover" Color="#37342F" />
  <SolidColorBrush x:Key="T.PrimaryInk" Color="#F7F6F3" />
  <SolidColorBrush x:Key="T.Track" Color="#E6E3DC" />
  <SolidColorBrush x:Key="T.Pill" Color="#ECE9E3" />
  <SolidColorBrush x:Key="T.Banner" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.BannerBorder" Color="#E3E0D9" />
  <SolidColorBrush x:Key="T.WarnPill" Color="#F5E9D6" />
  <SolidColorBrush x:Key="T.WarnText" Color="#8A4B00" />
  <SolidColorBrush x:Key="T.WarnFill" Color="#A35400" />
  <SolidColorBrush x:Key="T.BadgeInk" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.Sidebar" Color="#EFEDE8" />
  <SolidColorBrush x:Key="T.NavHover" Color="#E7E4DE" />
  <SolidColorBrush x:Key="T.NavSelected" Color="#E2DED6" />
  <SolidColorBrush x:Key="T.Node" Color="#F7F6F3" />
  <SolidColorBrush x:Key="T.NodeRing" Color="#E3E0D9" />
  <SolidColorBrush x:Key="T.Line" Color="#D6D2CA" />
  <SolidColorBrush x:Key="T.Selected" Color="#E2DED6" />
  <SolidColorBrush x:Key="T.OkPill" Color="#E2EFE6" />
  <SolidColorBrush x:Key="T.OkText" Color="#2D7A4B" />
  <SolidColorBrush x:Key="T.BadPill" Color="#F7E2DF" />
  <SolidColorBrush x:Key="T.BadText" Color="#B42318" />
  <SolidColorBrush x:Key="T.Panel" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.Input" Color="#FFFFFF" />
  <SolidColorBrush x:Key="T.InputBorder" Color="#D6D2CA" />
  <SolidColorBrush x:Key="T.InputBorderHover" Color="#BDB8AE" />
  <SolidColorBrush x:Key="T.SwitchOff" Color="#CFCBC2" />
  <SolidColorBrush x:Key="T.SwitchOffHover" Color="#C4BFB5" />
  <SolidColorBrush x:Key="T.Placeholder" Color="#8A857C" />
  <SolidColorBrush x:Key="T.Shadow" Color="#2E281C" />

  <SolidColorBrush x:Key="S.Green" Color="#2D7A4B" />
