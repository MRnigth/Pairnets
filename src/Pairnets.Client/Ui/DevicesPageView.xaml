<UserControl x:Class="Pairnets.Client.Ui.DevicesPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,8,28,24">
      <!-- Header -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource PgTitle}" Text="Computers" />
          <TextBlock Style="{StaticResource PgSub}" Text="Every computer on your nest, and the nest itself." />
        </StackPanel>
        <Button Grid.Column="1" Style="{StaticResource PgButton}" VerticalAlignment="Center" Margin="8,0,0,0" Click="OnManageDevices">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" StrokeThickness="1.9" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.External}" />
            <TextBlock Text="Manage computers on your nest" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Style="{StaticResource PgPrimary}" VerticalAlignment="Center" Margin="8,0,0,0" Padding="16,0" Click="OnAddComputer">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" StrokeThickness="2.4" Stroke="White" Data="{StaticResource I.Plus}" />
            <TextBlock Text="Add a computer…" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- The nest -->
      <Border Style="{StaticResource PgCard}" Padding="24,22" Margin="0,16,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="52" Height="52" CornerRadius="16" Margin="0,0,16,0" Background="{DynamicResource T.AccentSoft}">
              <ui:LineIcon Width="26" Height="26" StrokeThickness="1.8" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Nest}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="NestHeading" Text="Your nest" FontSize="20" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource PgSub}" Margin="0" Text="The home server that keeps your files and their history." />
            </StackPanel>
            <Border x:Name="NestPill" Grid.Column="2" Height="28" CornerRadius="14" Padding="12,0" VerticalAlignment="Center" Background="{DynamicResource T.OkPill}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="NestPillDot" Width="7" Height="7" Margin="0,0,7,0" Fill="{DynamicResource T.Ok}" />
                <TextBlock x:Name="NestPillText" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource PgHair}" Margin="0,18" />
          <UniformGrid x:Name="NestChips" Columns="4" Margin="-5">
            <Border Background="{DynamicResource T.Chip}" CornerRadius="14" Padding="14,12" Margin="5">
              <StackPanel>
                <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="12" Text="Address" />
                <TextBlock x:Name="NestAddress" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource T.Chip}" CornerRadius="14" Padding="14,12" Margin="5">
              <StackPanel>
                <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="12" Text="Version" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock x:Name="NestVersion" FontSize="15" FontWeight="Bold" />
                  <TextBlock x:Name="NestVersionNote" FontSize="12" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource T.OkText}" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource T.Chip}" CornerRadius="14" Padding="14,12" Margin="5">
              <StackPanel>
                <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="12" Text="Free space" />
                <TextBlock x:Name="NestSpace" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource T.Chip}" CornerRadius="14" Padding="14,12" Margin="5">
              <StackPanel>
                <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="12" Text="Keeps deleted files" />
                <TextBlock x:Name="NestKeeps" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
              </StackPanel>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- Downloads on the nest (1.0.61.8): links the nest downloads by itself, so this computer may be off meanwhile.
           Only on the owner's computers; see NestDownloadsSection. -->
      <StackPanel x:Name="DownloadsPanel" Visibility="Collapsed">
        <Grid Margin="4,22,0,0" Height="38">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="Downloads on the nest" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock x:Name="DownloadsSummary" Grid.Column="1" Style="{StaticResource PgSmall}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button x:Name="AddLinkButton" Grid.Column="2" Style="{StaticResource PgButton}" VerticalAlignment="Center" Foreground="{DynamicResource T.AccentInk}" Click="OnAddDownload">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" StrokeThickness="2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Download}" />
              <TextBlock Text="Add a link…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <Border x:Name="DownloadsCard" Style="{StaticResource PgCard}" Margin="0,10,0,0" ClipToBounds="True">
          <ItemsControl x:Name="DownloadsList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource T.Border}" Padding="20,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Circle" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Top" Background="{DynamicResource T.AccentSoft}">
                      <ui:LineIcon x:Name="RowIcon" Width="19" Height="19" StrokeThickness="2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Download}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource PgSmall}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <ProgressBar x:Name="Bar" Style="{StaticResource RoundProgress}" Height="6" Minimum="0" Maximum="100" Margin="0,8,0,6"
                                   Value="{Binding PercentValue, Mode=OneWay}" Visibility="Collapsed" />
                      <TextBlock x:Name="LineText" Text="{Binding Line}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Line}" />
                    </StackPanel>
                    <StackPanel x:Name="BusyButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                      <Button Style="{StaticResource PgButton}" Height="34" Content="Cancel" ToolTip="Stops it and deletes the half-done file"
                              AutomationProperties.Name="{Binding CancelLabel}" Click="OnCancelDownload" />
                    </StackPanel>
                    <StackPanel x:Name="DoneButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                      <Button Style="{StaticResource PgChipButton}" Height="34" Content="Show in Files" AutomationProperties.Name="{Binding ShowLabel}" Click="OnShowDownload" />
                      <Button Style="{StaticResource PgLink}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Content="Clear" ToolTip="Takes it off this list; the file stays"
                              AutomationProperties.Name="{Binding ClearLabel}" Click="OnClearDownload" />
                    </StackPanel>
                    <StackPanel x:Name="HeldButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                      <Button Style="{StaticResource PgLink}" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource T.BadText}" Content="Remove"
                              ToolTip="Deletes it from the nest's holding spot" AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemoveDownload" />
                    </StackPanel>
                    <StackPanel x:Name="FailedButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Visibility="Collapsed">
                      <Button Style="{StaticResource PgChipButton}" Height="34" Content="Try again" AutomationProperties.Name="{Binding RetryLabel}" Click="OnRetryDownload" />
                      <Button Style="{StaticResource PgLink}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource T.BadText}" Content="Remove"
                              AutomationProperties.Name="{Binding RemoveLabel}" Click="OnRemoveDownload" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding HasPercent}" Value="True">
                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CanCancel}" Value="True">
                    <Setter TargetName="BusyButtons" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource T.Chip}" />
                    <Setter TargetName="RowIcon" Property="Stroke" Value="{DynamicResource T.Muted}" />
                    <Setter TargetName="RowIcon" Property="Data" Value="{StaticResource I.Clock}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsDone}" Value="True">
                    <Setter TargetName="DoneButtons" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource T.OkPill}" />
                    <Setter TargetName="RowIcon" Property="Stroke" Value="{DynamicResource T.OkText}" />
                    <Setter TargetName="RowIcon" Property="Data" Value="{StaticResource I.Check}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource T.OkText}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsHeld}" Value="True">
                    <Setter TargetName="HeldButtons" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource T.WarnPill}" />
                    <Setter TargetName="RowIcon" Property="Stroke" Value="{DynamicResource T.WarnText}" />
                    <Setter TargetName="RowIcon" Property="Data" Value="{StaticResource I.Shield}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource T.WarnText}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsFailed}" Value="True">
                    <Setter TargetName="FailedButtons" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Circle" Property="Background" Value="{DynamicResource T.BadPill}" />
                    <Setter TargetName="RowIcon" Property="Stroke" Value="{DynamicResource T.BadText}" />
                    <Setter TargetName="RowIcon" Property="Data" Value="{StaticResource I.Warning}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource T.BadText}" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <Grid x:Name="DownloadsNoteRow" Margin="4,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:LineIcon Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
          <TextBlock x:Name="DownloadsNote" Grid.Column="1" Style="{StaticResource PgSub}" Margin="0" FontSize="13" TextWrapping="Wrap" />
        </Grid>
      </StackPanel>

      <!-- Computers -->
      <Grid Margin="4,16,0,0" Height="32">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Computers" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
        <TextBlock x:Name="Summary" Grid.Column="1" Style="{StaticResource PgSmall}" Margin="12,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="JoinChip" Grid.Column="2" Style="{StaticResource PgButton}" Height="32" Padding="12,0,8,0" FontSize="12" FontWeight="Bold" ui:Pg.Radius="16"
                Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" Foreground="{DynamicResource T.WarnText}"
                Visibility="Collapsed" Click="OnReviewJoin">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="15" Height="15" Margin="0,0,8,0" StrokeThickness="2" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" />
            <TextBlock x:Name="JoinText" VerticalAlignment="Center" />
            <TextBlock Text="Review" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource T.Muted}" />
            <ui:LineIcon Width="14" Height="14" Margin="2,0,0,0" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.ChevronRight}" />
          </StackPanel>
        </Button>
      </Grid>

      <UniformGrid x:Name="CardGrid" Columns="3" Margin="-6,10,-6,0" />

      <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" Margin="0,50,0,30">
        <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.TextSoft}" Data="{StaticResource I.Server}" HorizontalAlignment="Center" />
        <TextBlock x:Name="DevicesEmptyText" Style="{StaticResource PgSub}" TextAlignment="Center" MaxWidth="340" Margin="0,10,0,0"
                   Text="Loading the computers that use your nest…" />
      </StackPanel>

      <!-- People: the friends the nest is shared with, and those waiting to be let in (the owner's computers, nests reached
           through Pairnets). Every button but "Invite a friend…" opens the account page at this nest's People. -->
      <StackPanel x:Name="PeoplePanel" Visibility="Collapsed">
        <Grid Margin="4,22,0,0" Height="38">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="People" FontSize="16" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock x:Name="PeopleSummary" Grid.Column="1" Style="{StaticResource PgSmall}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Button Grid.Column="2" Style="{StaticResource PgButton}" VerticalAlignment="Center" Foreground="{DynamicResource T.AccentInk}" Click="OnInviteFriend">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" StrokeThickness="2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.UserPlus}" />
              <TextBlock Text="Invite a friend…" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
        <Border x:Name="PeopleCard" Style="{StaticResource PgCard}" Margin="0,10,0,0" ClipToBounds="True">
          <ItemsControl x:Name="PeopleList" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource T.Border}" Padding="20,14">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" Background="{DynamicResource T.WarnPill}">
                      <TextBlock Text="{Binding Letter}" FontWeight="ExtraBold" FontSize="15" Foreground="{DynamicResource T.WarnText}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Line}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Line}" />
                    </StackPanel>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" VerticalAlignment="Center" Focusable="False" Margin="10,0,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource T.Chip}" CornerRadius="13" Padding="10,4" Margin="0,0,6,0">
                            <TextBlock Text="{Binding}" FontSize="12" FontWeight="Bold" />
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="Pill" Grid.Column="3" CornerRadius="13" Padding="10,4" MinWidth="92" Margin="4,0,10,0" VerticalAlignment="Center" Background="{DynamicResource T.OkPill}">
                      <TextBlock x:Name="PillText" Text="{Binding Pill}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource T.OkText}" />
                    </Border>
                    <StackPanel x:Name="FriendButtons" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Style="{StaticResource PgChipButton}" Height="34" Content="Change…" ToolTip="{Binding ChangeLabel}"
                              AutomationProperties.Name="{Binding ChangeLabel}" Click="OnPersonChange" />
                      <Button Style="{StaticResource PgLink}" Margin="12,0,0,0" FontSize="13" Foreground="{DynamicResource T.BadText}" Content="Remove"
                              ToolTip="Opens your account page" AutomationProperties.Name="{Binding RemoveLabel}" Click="OnPersonRemove" />
                    </StackPanel>
                    <StackPanel x:Name="WaitingButtons" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                      <Button Style="{StaticResource PgButton}" Height="34" Foreground="{DynamicResource T.BadText}" Content="Decline"
                              ToolTip="Opens your account page" AutomationProperties.Name="{Binding DeclineLabel}" Click="OnPersonDecline" />
                      <Button Style="{StaticResource PgPrimary}" Height="34" Margin="8,0,0,0" Content="{Binding LetInLabel}"
                              ToolTip="Opens your account page" AutomationProperties.Name="{Binding LetInLabel}" Click="OnPersonLetIn" />
                    </StackPanel>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding ViewOnly}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource T.Chip}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource T.Muted}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Waiting}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource T.WarnPill}" />
                    <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FriendButtons" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="WaitingButtons" Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
        <TextBlock x:Name="PeopleEmpty" Style="{StaticResource PgSub}" Margin="4,10,0,0" FontSize="13"
                   Text="Nobody else uses this nest yet. Invite a friend to share all of it, or just some folders." />
        <Grid Margin="4,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:LineIcon Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
          <TextBlock Grid.Column="1" Style="{StaticResource PgSub}" Margin="0" FontSize="13" TextWrapping="Wrap"
                     Text="Nobody gets in from a link alone: you let each person in. Friends only see the folders you share with them, and can't invite others, remove computers or update your nest. Change…, Remove and Let in open your account page." />
        </Grid>
      </StackPanel>

      <!-- Removing and renaming happens on the nest's website -->
      <Grid Margin="4,16,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
        <TextBlock Grid.Column="1" Style="{StaticResource PgSub}" Margin="0" FontSize="13" TextWrapping="Wrap"
                   Text="To remove a computer or turn off its access, use Manage computers on your nest. Its files stay where they are." />
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
