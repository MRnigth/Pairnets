<UserControl x:Class="Pairnets.Client.Ui.DeviceMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <!--
    This computer ── server ── the other computer, on one line (same as the Mac/Linux app). Dots travel
    along the line while files move, and the speed sits above it. Compact (tray panel) is sized in code.
  -->
  <UserControl.Resources>
    <Style x:Key="Glyph" TargetType="ui:LineIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="StrokeThickness" Value="1.7" />
      <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,10,0" />
    </Style>
    <Style x:Key="NodeDot" TargetType="Ellipse">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="7" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="6,1,0,0" />
    </Style>
    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="150" />
    </Style>
    <Style x:Key="Detail" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="MaxWidth" Value="170" />
    </Style>
    <Style x:Key="Line" TargetType="ui:FlowLine">
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="16,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LineLabel" TargetType="StackPanel">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Margin" Value="0,0,0,26" />
    </Style>
  </UserControl.Resources>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:LineIcon x:Name="HereIcon" Style="{StaticResource Glyph}" Data="{StaticResource I.Laptop}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="HereName" Style="{StaticResource Name}" />
          <Ellipse x:Name="HereDot" Style="{StaticResource NodeDot}" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="HereDetail" Style="{StaticResource Detail}" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Column="1">
      <ui:FlowLine x:Name="HereLine" Style="{StaticResource Line}" />
      <StackPanel x:Name="HereLabel" Style="{StaticResource LineLabel}" Visibility="Collapsed">
        <ui:LineIcon x:Name="HereArrow" Width="12" Height="12" StrokeThickness="2.8" Margin="0,0,4,0"
                     Stroke="{DynamicResource S.Blue}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
        <TextBlock x:Name="HereSpeed" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource S.Blue}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:LineIcon x:Name="ServerIcon" Style="{StaticResource Glyph}" Data="{StaticResource I.Server}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ServerName" Style="{StaticResource Name}" />
          <Ellipse x:Name="ServerDot" Style="{StaticResource NodeDot}" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="ServerDetail" Style="{StaticResource Detail}" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Column="3">
      <ui:FlowLine x:Name="OtherLine" Style="{StaticResource Line}" ServerOnLeft="True" />
      <StackPanel x:Name="OtherLabel" Style="{StaticResource LineLabel}" Visibility="Collapsed">
        <ui:LineIcon Width="12" Height="12" StrokeThickness="2.8" Margin="0,0,4,0" Stroke="{DynamicResource T.Muted}"
                     Data="{StaticResource I.Left}" VerticalAlignment="Center" />
        <TextBlock x:Name="OtherLabelText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource T.Muted}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
      <ui:LineIcon x:Name="OtherIcon" Style="{StaticResource Glyph}" Data="{StaticResource I.Computer}" />
      <StackPanel VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="OtherName" Style="{StaticResource Name}" />
          <Ellipse x:Name="OtherDot" Style="{StaticResource NodeDot}" Fill="{DynamicResource S.Green}" />
        </StackPanel>
        <TextBlock x:Name="OtherDetail" Style="{StaticResource Detail}" />
        <TextBlock x:Name="OtherMore" Style="{StaticResource Detail}" Visibility="Collapsed" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
