<Window x:Class="Pairnets.Client.Ui.NestPlaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        Title="Where your nest keeps files" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <!-- Settings > Your nest > "Change…": the nest's drives, the choice, then how the move goes (looks like the nest update window). -->
  <Window.Resources>
    <Style x:Key="VersionCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource T.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="Tiny" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- One drive on the list: a card that is pressed to pick it (greyed when it can't be used) -->
    <Style x:Key="DriveButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource T.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
      <Setter Property="Foreground" Value="{DynamicResource T.Text}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="14,12">
              <ContentPresenter HorizontalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource T.Hover}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Box" Property="Opacity" Value="0.6" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <Grid MinHeight="400" Margin="28,8,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The heading: a round icon (spinning ring while it works), the title and one sentence -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
        <Ellipse x:Name="RingTrack" Width="48" Height="48" StrokeThickness="3" Stroke="{DynamicResource T.Track}" Visibility="Collapsed" />
        <Path x:Name="Ring" Width="48" Height="48" Stroke="{DynamicResource T.Accent}" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
              Data="M 24,1.5 A 22.5,22.5 0 0 1 46.5,24" />
        <Grid x:Name="BadgeHost" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
          <Ellipse x:Name="Badge" Fill="{DynamicResource T.AccentSoft}" />
          <ui:LineIcon x:Name="BadgeIcon" Width="22" Height="22" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Disk}" />
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="Where your nest keeps files" />
        <TextBlock x:Name="Explanation" Style="{StaticResource Note}" Margin="0,4,0,0" VerticalAlignment="Top" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">

      <!-- 1. The drives -->
      <Grid x:Name="ListPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Drives" Margin="0,20,0,0" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Shield}" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Note}" FontSize="12.5" Text="The old copy is kept until you delete it." />
          </StackPanel>
          <Button Style="{StaticResource SecondaryButton}" Content="Close" HorizontalAlignment="Right" Padding="18,0" Click="OnClose" />
        </Grid>
      </Grid>

      <!-- 2. Sure? -->
      <Grid x:Name="ConfirmPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource VersionCard}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Disk}" Margin="0,0,7,0" />
                  <TextBlock Text="Now" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" />
                </StackPanel>
                <TextBlock x:Name="FromText" FontSize="14" FontWeight="ExtraBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource T.Muted}" />
                <TextBlock x:Name="FromSub" Style="{StaticResource Tiny}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource T.AccentButton}" Margin="10,0">
              <ui:LineIcon Width="18" Height="18" StrokeThickness="2.4" Stroke="White" Data="M5,12 L19,12 M13,6 L19,12 L13,18" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource VersionCard}" Background="{DynamicResource T.AccentSoft}" BorderBrush="{DynamicResource T.AccentInk}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Disk}" Margin="0,0,7,0" />
                  <TextBlock Text="Moves to" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}" />
                </StackPanel>
                <TextBlock x:Name="ToText" FontSize="14" FontWeight="ExtraBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ToSub" Style="{StaticResource Tiny}" Foreground="{DynamicResource T.Muted}" />
              </StackPanel>
            </Border>
          </Grid>
          <StackPanel Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,7 L12,12 L15,14" Margin="0,0,10,0" />
              <TextBlock Style="{StaticResource Note}" Text="Your nest keeps running while they copy, then pauses for a moment." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Shield}" Margin="0,0,10,0" />
              <TextBlock Style="{StaticResource Note}" Text="The old copy is kept until you delete it." />
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="Back" Click="OnBack" />
          <Button x:Name="MoveButton" Style="{StaticResource AccentButton}" Content="Move the files" Margin="8,0,0,0" Click="OnMove" />
        </StackPanel>
      </Grid>

      <!-- 3. Moving -->
      <Grid x:Name="BusyPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource VersionCard}" Margin="0,18,0,0" Padding="18,14" VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="ProgressText" FontSize="12" FontWeight="ExtraBold" Text="Copying your files… 0%" />
              <TextBlock x:Name="ProgressWhere" Style="{StaticResource Tiny}" HorizontalAlignment="Right" MaxWidth="220" />
            </Grid>
            <Border x:Name="BarTrack" Height="6" CornerRadius="3" Background="{DynamicResource T.Track}" Margin="0,8,0,0">
              <Border x:Name="Bar" CornerRadius="3" Background="{DynamicResource T.Accent}" HorizontalAlignment="Left" Width="0" />
            </Border>
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="Close" HorizontalAlignment="Right" Padding="18,0" Click="OnClose" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,11 L12,16 M12,8 L12,8.5" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Note}" FontSize="12.5" Text="You can close this window. The move carries on." />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 4. Done or not moved -->
      <Grid x:Name="ResultPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="OldCopyPanel" Visibility="Collapsed" Margin="0,20,0,0">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Folder}" Margin="0,0,9,0" />
            <TextBlock Text="The old copy" FontSize="13" FontWeight="SemiBold" />
          </StackPanel>
          <Border Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="16" Padding="16,12,12,12" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" Padding="0,4,0,0" VerticalAlignment="Top" />
              <Button Grid.Column="1" Style="{StaticResource AccentButton}" MinHeight="34" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Top" Click="OnCopy">
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{x:Static ui:StepIcons.Copy}" Margin="0,0,7,0" />
                  <TextBlock Text="Copy" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Lock}" Margin="0,0,9,0" />
            <TextBlock Style="{StaticResource Note}" FontSize="12.5" Text="Run it on the nest when everything works, to free the space." />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="RetryButton" Style="{StaticResource SecondaryButton}" Content="Try again" Margin="0,0,8,0" Click="OnRetry" Visibility="Collapsed" />
          <Button x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="Close" Padding="22,0" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
  </Grid>
</Window>
