<Window x:Class="Pairnets.Client.Ui.NestDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        Title="Download a link on the nest" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <!-- "Add a link…" under Downloads on the nest: the link, the nest folder it goes in, then Start download. -->
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource T.AccentSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
        <ui:LineIcon Width="20" Height="20" StrokeThickness="2.2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Download}" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="Let the nest download it" />
        <TextBlock Foreground="{DynamicResource T.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="The nest fetches the file by itself, so you can turn this computer off. When it's done, it syncs to your computers like any other file." />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Margin="0,18,0,0">
      <TextBlock Text="Paste a download link" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
      <TextBox x:Name="LinkBox" Style="{StaticResource PgInput}" FontWeight="Normal" FontSize="13" MaxLength="4000"
               AutomationProperties.Name="Download link" TextChanged="OnLinkChanged" />
    </StackPanel>

    <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource T.Chip}" CornerRadius="14" Padding="14,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon Width="18" Height="18" Margin="0,0,10,0" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Folder}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="12" Text="Save in this nest folder" />
          <TextBlock x:Name="FolderText" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="Downloads" />
        </StackPanel>
        <Button x:Name="ChangeButton" Grid.Column="2" Style="{StaticResource PgChipButton}" Height="34" VerticalAlignment="Center" Content="Change…"
                AutomationProperties.Name="Change the nest folder" Click="OnChangeFolder" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="3">
    <Border x:Name="SealedBox" Margin="0,12,0,0" Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" BorderThickness="1"
            CornerRadius="14" Padding="14,10" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" Margin="0,1,10,0" VerticalAlignment="Top" />
        <TextBlock x:Name="SealedText" Grid.Column="1" Foreground="{DynamicResource T.WarnText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ui:LineIcon Width="14" Height="14" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Shield}" Margin="0,1,8,0" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" Foreground="{DynamicResource T.Muted}" FontSize="12" TextWrapping="Wrap"
                 Text="Only web links (https:// or http://), never addresses in your own network. The nest keeps 5 GB free on its disk and never replaces a file that has the same name." />
    </Grid>
    </StackPanel>

    <Grid Grid.Row="4" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="Problem" Foreground="{DynamicResource T.BadText}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
        <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Padding="20,0" IsDefault="True" Click="OnStart">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{StaticResource I.Download}" Margin="0,0,8,0" />
            <TextBlock x:Name="StartLabel" Text="Start download" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
