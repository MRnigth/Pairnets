<Window x:Class="Pairnets.Client.Ui.ServerUpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        Title="Update your nest" SizeToContent="Height" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="VersionCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource T.Card}" />
      <Setter Property="BorderBrush" Value="{DynamicResource T.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="Big" TargetType="TextBlock">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="ExtraBold" />
      <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style x:Key="Tiny" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource T.TextSoft}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource T.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Window.Resources>
  <Grid>
  <Grid MinHeight="440" Margin="28,8,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The heading: a round icon (spinning ring while it works), the title and one sentence -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Top">
        <Ellipse x:Name="RingTrack" Width="48" Height="48" StrokeThickness="3" Stroke="{DynamicResource T.Track}" Visibility="Collapsed" />
        <Path x:Name="Ring" Width="48" Height="48" Stroke="{DynamicResource T.Accent}" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5"
              Data="M 24,1.5 A 22.5,22.5 0 0 1 46.5,24" />
        <Grid x:Name="BadgeHost" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
          <Ellipse x:Name="Badge" Fill="{DynamicResource T.AccentSoft}" />
          <ui:LineIcon x:Name="BadgeIcon" Width="22" Height="22" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Server}" />
          <Border x:Name="UpBadge" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource T.AccentButton}" BorderBrush="{DynamicResource T.Bg}"
                  BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
            <ui:LineIcon Width="10" Height="10" StrokeThickness="3.4" Stroke="White" Data="M12,19 L12,5 M5,12 L12,5 L19,12" />
          </Border>
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="This app is newer than your nest" />
        <TextBlock x:Name="Explanation" Style="{StaticResource Note}" Margin="0,4,0,0" VerticalAlignment="Top" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- The three steps share one place; each keeps its buttons pinned to the bottom edge -->
      <Grid>

      <!-- 1. Ask -->
      <Grid x:Name="AskPanel">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
        <Grid Margin="0,20,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource VersionCard}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Server}" Margin="0,0,7,0" />
                <TextBlock Text="Your nest now" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" />
              </StackPanel>
              <TextBlock x:Name="NestVersion" Style="{StaticResource Big}" Foreground="{DynamicResource T.Muted}" />
              <TextBlock x:Name="NestSub" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource T.AccentButton}" Margin="10,0">
            <ui:LineIcon Width="18" Height="18" StrokeThickness="2.4" Stroke="White" Data="M5,12 L19,12 M13,6 L19,12 L13,18" />
          </Border>
          <Border Grid.Column="2" Style="{StaticResource VersionCard}" Background="{DynamicResource T.AccentSoft}" BorderBrush="{DynamicResource T.AccentInk}">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Desktop}" Margin="0,0,7,0" />
                <TextBlock Text="This app" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.AccentInk}" />
              </StackPanel>
              <TextBlock x:Name="AppVersion" Style="{StaticResource Big}" />
              <TextBlock Style="{StaticResource Tiny}" Text="The nest gets this one" Foreground="{DynamicResource T.Muted}" />
            </StackPanel>
          </Border>
        </Grid>
        <!-- Kept for code that reads the two versions as one line -->
        <TextBlock x:Name="VersionsText" Visibility="Collapsed" />

        <StackPanel Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,7 L12,12 L15,14" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Note}" Text="Takes about a minute. Syncing pauses meanwhile." />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Shield}" Margin="0,0,10,0" />
            <TextBlock Style="{StaticResource Note}" Text="Your files stay as they are." />
          </StackPanel>
        </StackPanel>
        <CheckBox x:Name="AlwaysBox" Style="{StaticResource Switch}" Content="From now on, update the nest by itself" FontSize="13" FontWeight="SemiBold"
                  HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Button x:Name="SkipButton" Style="{StaticResource FlatButton}" Foreground="{DynamicResource T.Muted}" Content="Don’t ask for this version" HorizontalAlignment="Left" Padding="4,0" Click="OnSkip" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButton}" Content="Not now" Click="OnLater" />
            <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="Update the nest" Margin="8,0,0,0" Click="OnUpdate" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 2. Updating -->
      <Grid x:Name="BusyPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource VersionCard}" Margin="0,18,0,0" Padding="18,14" VerticalAlignment="Top">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="StepCount" FontSize="12" FontWeight="ExtraBold" Text="Step 1 of 3" />
              <TextBlock x:Name="StepWhere" Style="{StaticResource Tiny}" HorizontalAlignment="Right" />
            </Grid>
            <Border Height="6" CornerRadius="3" Background="{DynamicResource T.Track}" Margin="0,8,0,0">
              <Border x:Name="StepBar" CornerRadius="3" Background="{DynamicResource T.Accent}" HorizontalAlignment="Left" Width="0" />
            </Border>
            <StackPanel x:Name="Steps" Margin="0,14,0,0" />
          </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,16,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="Close" HorizontalAlignment="Right" Padding="18,0" Click="OnLater" />
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="M3,12 A9,9 0 1 1 21,12 A9,9 0 1 1 3,12 M12,11 L12,16 M12,8 L12,8.5" Margin="0,0,10,0" />
            <TextBlock x:Name="StepText" Style="{StaticResource Note}" FontSize="12.5" />
          </StackPanel>
        </Grid>
      </Grid>

      <!-- 3. Done, failed, or the one-time setup -->
      <Grid x:Name="ResultPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
        <StackPanel x:Name="DonePanel" Visibility="Collapsed">
          <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource VersionCard}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Server}" Margin="0,0,7,0" />
                  <TextBlock Text="Your nest" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" />
                </StackPanel>
                <TextBlock x:Name="DoneNestVersion" Style="{StaticResource Big}" />
                <TextBlock x:Name="DoneNestSub" Style="{StaticResource Tiny}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource T.OkPill}" Margin="10,0">
              <ui:LineIcon Width="18" Height="18" StrokeThickness="2.8" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.Check}" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource VersionCard}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Desktop}" Margin="0,0,7,0" />
                  <TextBlock Text="This app" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" />
                </StackPanel>
                <TextBlock x:Name="DoneAppVersion" Style="{StaticResource Big}" />
                <TextBlock x:Name="DoneAppSub" Style="{StaticResource Tiny}" />
              </StackPanel>
            </Border>
          </Grid>
          <Border Style="{StaticResource OkChip}" CornerRadius="16" Padding="14,12" Margin="0,16,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="{DynamicResource T.Ok}" Margin="3,0,13,0" />
                <TextBlock Text="Syncing is back on" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <ui:LineIcon Width="16" Height="16" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Shield}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Note}" Text="Your files stayed as they are." />
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- One-time setup: the exact command -->
        <StackPanel x:Name="CommandPanel" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Server}" Margin="0,0,9,0" />
            <TextBlock Text="Run it on the nest itself, in its terminal or over SSH." FontSize="13" FontWeight="SemiBold" />
          </StackPanel>
          <Border Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="16" Padding="16,12,12,12" Margin="0,10,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="CommandText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5" TextWrapping="Wrap" Padding="0,4,0,0" VerticalAlignment="Top"
                       Text="curl -fsSL https://raw.githubusercontent.com/MRnigth/Pairnets/main/deploy/get.sh | sudo bash" />
              <Button Grid.Column="1" Style="{StaticResource AccentButton}" MinHeight="34" Padding="14,0" Margin="12,0,0,0" VerticalAlignment="Top" Click="OnCopy">
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{x:Static ui:StepIcons.Copy}" Margin="0,0,7,0" />
                  <TextBlock Text="Copy" FontWeight="Bold" />
                </StackPanel>
              </Button>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Lock}" Margin="0,0,9,0" />
            <TextBlock Style="{StaticResource Note}" FontSize="12.5" Text="It may ask for the nest’s password. Your files stay as they are." />
          </StackPanel>
        </StackPanel>

        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
          <Button x:Name="RetryButton" Style="{StaticResource SecondaryButton}" Content="Try again" Margin="0,0,8,0" Click="OnUpdate" Visibility="Collapsed" />
          <Button x:Name="CloseButton" Style="{StaticResource AccentButton}" Content="Close" Padding="22,0" Click="OnLater" />
        </StackPanel>
      </Grid>
      </Grid>

      <!-- Debug mode: every step of the app and what the nest's updater reports -->
      <StackPanel x:Name="DetailsPanel" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock Style="{StaticResource MutedSmall}" Text="Details (Debug mode)" />
        <Border Style="{StaticResource CodeBox}" Margin="0,4,0,0">
          <TextBox x:Name="DetailsText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
                   FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap" MaxHeight="220"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Border>
        <Button Style="{StaticResource SubtleButton}" Content="Copy details" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnCopyDetails" />
      </StackPanel>
    </Grid>
  </Grid>
  </Grid>
</Window>
