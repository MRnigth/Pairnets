<UserControl x:Class="Pairnets.Client.Ui.HistoryPageView"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="clr-namespace:Pairnets.Client.Ui"
                xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core">
  <UserControl.Resources>
    <ui:FileIconConverter x:Key="FileIcon" />
    <BooleanToVisibilityConverter x:Key="Visible" />
  </UserControl.Resources>
  <Grid Margin="28,40,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel>
      <TextBlock Style="{StaticResource PgTitle}" Text="History" />
      <TextBlock Style="{StaticResource PgSub}" Text="Get back deleted files and older versions. Your nest keeps them for 30 days." />
    </StackPanel>

    <!-- Tabs, search, reload -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource PgTabs}">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="DeletedTab" Style="{StaticResource PgTab}" GroupName="history" IsChecked="True" Checked="OnHistoryModeChanged">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="15" Height="15" Margin="0,0,7,0" StrokeThickness="2" Data="{StaticResource I.Trash}"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="Deleted files" />
              <TextBlock x:Name="DeletedCount" Margin="7,0,0,0" FontWeight="SemiBold" Opacity="0.65" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="FilesTab" Style="{StaticResource PgTab}" GroupName="history" Margin="0" Checked="OnHistoryModeChanged">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="15" Height="15" Margin="0,0,7,0" StrokeThickness="2" Data="{StaticResource I.File}"
                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              <TextBlock Text="All files" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>
      <ui:SearchBox x:Name="HistorySearch" Grid.Column="1" Height="42" Margin="10,0,10,0" Placeholder="Search deleted files by name or folder" />
      <Button Grid.Column="2" Style="{StaticResource PgIconButton}" ToolTip="Reload from the server" Click="OnHistoryReload">
        <ui:LineIcon Width="17" Height="17" StrokeThickness="2.2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Refresh}" />
      </Button>
    </Grid>

    <!-- How the last restore went -->
    <Border x:Name="RestoreMessage" Grid.Row="2" Style="{StaticResource OkChip}" Margin="0,16,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
      <TextBlock x:Name="RestoreMessageText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
    </Border>

    <Grid Grid.Row="3" Margin="0,16,0,0">
      <!-- Loading, errors, nothing to show -->
      <StackPanel x:Name="HistoryMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
        <ui:LineIcon x:Name="HistoryMessageIcon" Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.TextSoft}" Data="{StaticResource I.History}" HorizontalAlignment="Center" />
        <TextBlock x:Name="HistoryMessageText" Style="{StaticResource PgSub}" TextAlignment="Center" MaxWidth="360" Margin="0,10,0,0" />
        <Button x:Name="HistoryRetry" Style="{StaticResource PgButton}" Content="Try again" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnHistoryReload" Visibility="Collapsed" />
      </StackPanel>

      <!-- Deleted files: one wide table -->
      <Grid x:Name="DeletedPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource PgCard}" VerticalAlignment="Top" Padding="10,4,10,6">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="12,12,12,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource PgCaps}" Text="FILE" Margin="48,0,0,0" />
              <TextBlock Style="{StaticResource PgCaps}" Grid.Column="1" Text="DELETED" />
            </Grid>
            <ScrollViewer x:Name="DeletedScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="DeletedList" Style="{StaticResource PlainList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type c:ServerFile}">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="12,9">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="170" />
                          <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Style="{StaticResource PgChipSquare}" Margin="0,0,14,0">
                            <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{Binding Path, Converter={StaticResource FileIcon}}" />
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding WhenText}" FontSize="13" />
                          <TextBlock x:Name="DaysLeft" Text="{Binding DaysLeftText}" Style="{StaticResource PgSmall}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PgSmallButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Click="OnRestoreFile" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <ui:LineIcon Width="15" Height="15" Margin="0,0,6,0" StrokeThickness="2.2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Restore2}" />
                            <TextBlock Text="Restore" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding ExpiresSoon}" Value="True">
                        <Setter TargetName="DaysLeft" Property="Foreground" Value="{DynamicResource T.WarnText}" />
                        <Setter TargetName="DaysLeft" Property="FontWeight" Value="Bold" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4,16,0,0">
          <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
          <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="13" TextWrapping="Wrap"
                     Text="Restored files go back to the folder they came from. After 30 days your nest removes deleted files for good." />
        </StackPanel>
      </Grid>

      <!-- All files: the list, and the versions of the chosen file -->
      <Grid x:Name="FilesPane" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="1.12*" />
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource PgCard}" Padding="8,6" Margin="0,0,8,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="HistorySummary" Style="{StaticResource PgSmall}" Margin="10,10,10,8" />
            <ListBox x:Name="FileList" Grid.Row="1" Style="{StaticResource PgFileList}" SelectionChanged="OnFileSelected">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type c:ServerFile}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="11" Margin="0,0,12,0" Background="{DynamicResource T.Chip}">
                      <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{Binding Path, Converter={StaticResource FileIcon}}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding FolderAndWhen}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource PgCard}" Margin="8,0,0,0" Padding="22,20">
          <Grid>
            <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.TextSoft}" Data="{StaticResource I.Restore}" HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource PgSub}" TextAlignment="Center" MaxWidth="260" Margin="0,10,0,0"
                         Text="Choose a file to see the versions your nest keeps, and get one back." />
            </StackPanel>
            <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Top">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="DetailTile" Width="48" Height="48" CornerRadius="14" Margin="0,0,14,0" Background="{DynamicResource T.OkPill}">
                    <ui:LineIcon x:Name="DetailIcon" Width="22" Height="22" StrokeThickness="1.9" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.File}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailName" FontSize="18" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailFolder" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button x:Name="ShowInFolderButton" Grid.Column="2" Style="{StaticResource PgButton}" Height="34" FontSize="12" FontWeight="Bold" Padding="12,0"
                          VerticalAlignment="Center" Click="OnShowInFolder">
                    <StackPanel Orientation="Horizontal">
                      <ui:LineIcon Width="15" Height="15" Margin="0,0,7,0" StrokeThickness="1.9" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Folder}" />
                      <TextBlock Text="Show in folder" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border Style="{StaticResource PgHair}" Margin="0,18,0,16" />
                <Grid Margin="0,0,0,4">
                  <TextBlock Style="{StaticResource PgCaps}" Text="VERSIONS ON YOUR NEST" />
                  <TextBlock x:Name="VersionCount" Style="{StaticResource PgSmall}" HorizontalAlignment="Right" />
                </Grid>
              </StackPanel>
              <Border DockPanel.Dock="Bottom" CornerRadius="14" Padding="14,12" Margin="0,12,0,0" Background="{DynamicResource T.Chip}">
                <StackPanel Orientation="Horizontal">
                  <ui:LineIcon Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
                  <TextBlock Style="{StaticResource PgSub}" Margin="0" FontSize="13" MaxWidth="360"
                             Text="Restore puts that version back in your folder. The one you have now stays here as a version, so nothing is lost." />
                </StackPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="VersionList" />
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
