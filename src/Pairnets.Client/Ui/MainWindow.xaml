<Window x:Class="Pairnets.Client.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core"
        Title="Pairnets" Width="980" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ui:ActivityBrushConverter x:Key="KindBrush" />
    <ui:ActivityIconConverter x:Key="KindIcon" />
    <ui:DirectionBrushConverter x:Key="DirectionBrush" />
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="ToolIcon" TargetType="ui:LineIcon">
      <Setter Property="Width" Value="17" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0,0,7,0" />
      <Setter Property="Stroke" Value="{DynamicResource T.Text}" />
    </Style>
    <Style x:Key="TileIcon" TargetType="ui:LineIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="StrokeThickness" Value="2.3" />
      <Setter Property="Stroke" Value="{DynamicResource T.Muted}" />
    </Style>

    <!-- Activity rows and day headings (Overview and Activity pages) -->
    <DataTemplate DataType="{x:Type c:ActivityDay}">
      <TextBlock Style="{StaticResource Day}" Text="{Binding Text}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type c:ActivityItem}">
      <Border x:Name="ActivityRow" Style="{StaticResource Row}" ToolTip="{Binding TimeText}" Loaded="OnRowLoaded">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Show in folder" Click="OnRevealActivity" />
            <MenuItem Header="Show versions…" Click="OnActivityVersions" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Width="30" Height="30" Margin="0,0,12,0">
            <Ellipse Fill="{Binding Kind, Converter={StaticResource KindBrush}}" />
            <ui:LineIcon Width="19" Height="19" StrokeThickness="2.6" Stroke="White"
                         Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
          </Grid>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Primary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource MutedSmall}"
                     VerticalAlignment="Center" Margin="12,0,4,0" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <!-- Messages without a file have nothing to show in a folder -->
        <DataTrigger Binding="{Binding Path}" Value="{x:Null}">
          <Setter TargetName="ActivityRow" Property="ContextMenu" Value="{x:Null}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ======================= Sidebar ======================= -->
    <Border Style="{StaticResource Sidebar}">
      <DockPanel Margin="12,18,12,14">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
          <Image x:Name="AppIcon" Width="30" Height="30" Margin="0,0,10,0" />
          <TextBlock Text="Pairnets" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Bottom: the app update (instead of a banner over everything) and the version -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border x:Name="UpdateCard" Style="{StaticResource Banner}" Padding="12,10" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon x:Name="UpdateIcon" Width="16" Height="16" Margin="0,0,7,0" Stroke="{DynamicResource T.Accent}" Data="{StaticResource I.Download}" VerticalAlignment="Top" />
                <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxWidth="150" />
              </StackPanel>
              <TextBlock x:Name="UpdateDetail" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,6,0,0" />
              <ProgressBar x:Name="UpdateProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Margin="0,6,0,0" Visibility="Collapsed" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Padding="11,5" FontSize="12.5" Content="Update now" Click="OnUpdateNow" />
                <Button x:Name="UpdateLater" Style="{StaticResource FlatButton}" Padding="9,5" FontSize="12.5" Margin="4,0,0,0" Content="Later" Click="OnUpdateLater" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AppVersion" Style="{StaticResource MutedSmall}" Margin="10,0,0,0" VerticalAlignment="Center" />
            <RadioButton x:Name="NavSettings" Grid.Column="1" Style="{StaticResource Nav}" GroupName="page" Margin="0"
                         ToolTip="Settings" Checked="OnNav">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Data="{StaticResource I.Settings}" Width="16" Height="16" Margin="0,0,7,0" />
                <TextBlock Text="Settings" FontSize="12.5" VerticalAlignment="Center" />
              </StackPanel>
            </RadioButton>
          </Grid>
        </StackPanel>

        <StackPanel>
          <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="page" IsChecked="True" Checked="OnNav">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.Home}" Margin="0,0,11,0" />
              <TextBlock Text="Overview" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavActivity" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.Activity}" Margin="0,0,11,0" />
              <TextBlock Text="Activity" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.History}" Margin="0,0,11,0" />
              <TextBlock Text="History" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavDevices" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.Computer}" Margin="0,0,11,0" />
              <TextBlock Text="Devices" VerticalAlignment="Center" />
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="NavAttention" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:LineIcon Data="{StaticResource I.Warning}" />
              <TextBlock Grid.Column="1" Text="Needs attention" VerticalAlignment="Center" Margin="11,0,0,0" />
              <Border x:Name="AttentionBadge" Grid.Column="2" Style="{StaticResource Badge}" Margin="6,0,0,0" Visibility="Collapsed">
                <TextBlock x:Name="AttentionCount" Foreground="White" FontSize="11" FontWeight="SemiBold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Grid>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ======================= Page ======================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="28,22,28,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="PageTitle" Style="{StaticResource Title}" Text="Overview" VerticalAlignment="Center" />
        <TextBlock x:Name="PageSubtitle" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnOpenFolder" ToolTip="Open the synced folder">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Style="{StaticResource ToolIcon}" Data="{StaticResource I.Folder}" />
              <TextBlock Text="Open folder" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0" Click="OnPause">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon x:Name="PauseGlyph" Style="{StaticResource ToolIcon}" Data="{StaticResource I.Pause}" />
              <TextBlock x:Name="PauseText" Text="Pause" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="OnSyncNow">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Style="{StaticResource ToolIcon}" Stroke="White" Data="{StaticResource I.Sync}" />
              <TextBlock Text="Sync now" />
            </StackPanel>
          </Button>
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" ToolTip="More" Click="OnMore">
            <ui:LineIcon Width="18" Height="18" StrokeThickness="3.2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.More}" />
            <Button.ContextMenu>
              <ContextMenu Placement="Bottom">
                <MenuItem Header="View log" Click="OnViewLog" />
                <MenuItem Header="Report a bug…" Click="OnReportBug" />
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <!-- ============ Overview ============ -->
        <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="28,18,28,24">
            <Border Style="{StaticResource Hero}">
              <Grid>
                <Border x:Name="HeroTint" CornerRadius="15" IsHitTestVisible="False" />
                <StackPanel Margin="22,20,22,22">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid x:Name="StatusBadgeHost" Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,16,0">
                      <Ellipse x:Name="StatusBadge" Fill="{StaticResource S.Grey}" />
                      <ui:LineIcon x:Name="StatusGlyph" Width="23" Height="23" StrokeThickness="2.6" Stroke="White" Data="{StaticResource I.CloudOff}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="Starting…" />
                      <TextBlock x:Name="Detail" Style="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button x:Name="FixButton" Grid.Column="2" Style="{StaticResource WarnButton}" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnFix" />
                  </Grid>

                  <ui:DeviceMapView x:Name="Map" Margin="0,22,0,0" />

                  <!-- Waiting for the other computer's big batch -->
                  <StackPanel x:Name="WaitPanel" Margin="0,22,0,0" Visibility="Collapsed">
                    <ProgressBar x:Name="WaitProgress" Style="{StaticResource RoundProgress}" Minimum="0" Maximum="100" />
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="WaitText" Style="{StaticResource MutedSmall}" />
                      <TextBlock Grid.Column="1" Style="{StaticResource MutedSmall}" Text="Your own changes still upload" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Style="{StaticResource SubtleButton}" Content="Download now anyway" Click="OnDownloadNow" />
                      <TextBlock Style="{StaticResource MutedSmall}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" Margin="10,0,0,0"
                                 Text="Stops waiting by itself if the other computer goes quiet for 2 minutes." />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Something needs a decision -->
            <Border x:Name="AttentionCallout" Style="{StaticResource Callout}" Margin="0,14,0,0" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:LineIcon Width="18" Height="18" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="AttentionCalloutText" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource T.WarnText}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Content="Review" Click="OnReviewAttention" />
              </Grid>
            </Border>

            <!-- Current transfer: the whole batch, speed, and the files in progress -->
            <Border x:Name="TransferCard" Style="{StaticResource Card}" Padding="18,14,18,16" Margin="0,14,0,0" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon x:Name="TransferArrow" Width="16" Height="16" StrokeThickness="2.4" Margin="0,0,6,0"
                                 Stroke="{StaticResource S.Green}" Data="{StaticResource I.Up}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TransferTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </StackPanel>
                  <TextBlock x:Name="TransferSpeed" Grid.Column="1" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Border x:Name="LimitPill" Grid.Column="2" Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="LimitText" FontSize="11.5" />
                  </Border>
                </Grid>
                <ProgressBar x:Name="TransferProgress" Style="{StaticResource RoundProgress}" Minimum="0" Maximum="100" Margin="0,10,0,0" />
                <TextBlock x:Name="TransferOverall" Style="{StaticResource MutedSmall}" Margin="0,8,0,0" />
                <Border x:Name="ActiveDivider" Style="{StaticResource Divider}" Margin="0,10,0,2" />
                <ItemsControl x:Name="ActiveList" Style="{StaticResource PlainList}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Margin="0,6,16,2" Loaded="OnRowLoaded">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource MutedSmall}" Margin="6,0,0,0" />
                        </Grid>
                        <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" ui:Motion.SmoothValue="{Binding PercentValue, Mode=OneWay}" Margin="0,4,0,0"
                                     Foreground="{Binding IsUpload, Converter={StaticResource DirectionBrush}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Facts -->
            <UniformGrid Columns="4" Margin="-5,14,-5,0">
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Style="{StaticResource TileIcon}" Data="{StaticResource I.Folder}" />
                    <TextBlock Style="{StaticResource Caps}" Text="FOLDER" />
                  </StackPanel>
                  <TextBlock x:Name="FolderText" Style="{StaticResource Value}" Text="–" Margin="0,4,0,0" />
                  <Button Style="{StaticResource LinkButton}" Margin="-6,2,0,-4" HorizontalAlignment="Left" Content="Open" Click="OnOpenFolder" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Style="{StaticResource TileIcon}" Data="{StaticResource I.Clock}" />
                    <TextBlock Style="{StaticResource Caps}" Text="LAST SYNCED" />
                  </StackPanel>
                  <TextBlock x:Name="LastSync" Style="{StaticResource Value}" Text="Not yet" Margin="0,4,0,0" />
                  <TextBlock x:Name="ConnectionText" Style="{StaticResource MutedSmall}" Margin="0,6,0,0" />
                </StackPanel>
              </Border>
              <Border x:Name="VersionTile" Style="{StaticResource Tile}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Style="{StaticResource TileIcon}" Data="{StaticResource I.Server}" />
                    <TextBlock Style="{StaticResource Caps}" Text="SERVER" />
                  </StackPanel>
                  <TextBlock x:Name="VersionText" Style="{StaticResource Value}" Text="–" Margin="0,4,0,0" />
                  <Button x:Name="VersionButton" Style="{StaticResource LinkButton}" Margin="-6,2,0,-4" HorizontalAlignment="Left" Click="OnUpdateServer" Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border x:Name="SpaceTile" Style="{StaticResource Tile}">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Style="{StaticResource TileIcon}" Data="{StaticResource I.Disk}" />
                    <TextBlock Style="{StaticResource Caps}" Text="FREE SPACE" />
                  </StackPanel>
                  <TextBlock x:Name="SpaceText" Style="{StaticResource Value}" Text="–" Margin="0,4,0,0" />
                  <TextBlock Style="{StaticResource MutedSmall}" Margin="0,6,0,0" Text="on the server" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Recent activity -->
            <Border Style="{StaticResource Card}" Padding="10,12,10,8" Margin="0,14,0,0">
              <StackPanel>
                <Grid Margin="8,0,2,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource H2}" Text="Recent activity" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="See all" Click="OnSeeAllActivity" />
                </Grid>
                <ItemsControl x:Name="RecentList" Style="{StaticResource PlainList}" Margin="0,4,0,0" />
                <TextBlock x:Name="RecentEmpty" Style="{StaticResource Muted}" Margin="8,6,8,8"
                           Text="Nothing has happened yet. Changes appear here as they sync." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Activity ============ -->
        <Border x:Name="ActivityPage" Style="{StaticResource Card}" Margin="28,18,28,24" Padding="8,4,8,8" Visibility="Collapsed">
          <Grid>
            <ScrollViewer x:Name="ActivityPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="ActivityList" Style="{StaticResource PlainList}" />
            </ScrollViewer>
            <StackPanel x:Name="ActivityEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}"
                           Data="{StaticResource I.Activity}" HorizontalAlignment="Center" Margin="0,0,0,8" />
              <TextBlock Style="{StaticResource Muted}" Text="Nothing has happened yet. Changes appear here as they sync." />
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============ History ============ -->
        <Grid x:Name="HistoryPage" Margin="28,18,28,24" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Segments}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DeletedTab" Style="{StaticResource Seg}" GroupName="history" IsChecked="True" Checked="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Width="14" Height="14" Margin="0,0,6,0" Data="{StaticResource I.Trash}"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="Deleted files" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilesTab" Style="{StaticResource Seg}" GroupName="history" Checked="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Width="14" Height="14" Margin="0,0,6,0" Data="{StaticResource I.File}"
                                 Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                    <TextBlock Text="All files" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="12,0,8,0">
              <TextBox x:Name="HistorySearch" Style="{StaticResource Input}" Padding="30,6,8,6" VerticalContentAlignment="Center" TextChanged="OnHistorySearch" />
              <ui:LineIcon Width="15" Height="15" Margin="11,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Search}" IsHitTestVisible="False" />
              <TextBlock x:Name="SearchHint" Style="{StaticResource Muted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search by name or folder" />
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Reload from the server" Click="OnHistoryReload">
              <ui:LineIcon Width="17" Height="17" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Sync}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="11*" />
              <ColumnDefinition Width="10*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,7,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HistorySummary" Style="{StaticResource MutedSmall}" Margin="8,4,8,6" />
                <ListBox x:Name="FileList" Grid.Row="1" Style="{StaticResource Rows}" SelectionChanged="OnFileSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:ServerFile}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource T.Pill}" Margin="0,0,11,0">
                          <Grid>
                            <ui:LineIcon x:Name="FileGlyph" Width="17" Height="17" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.File}" />
                            <ui:LineIcon Width="17" Height="17" StrokeThickness="2" Stroke="{StaticResource S.Red}" Data="{StaticResource I.Trash}"
                                         Visibility="{Binding Deleted, Converter={StaticResource Visible}}" />
                          </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        </StackPanel>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Deleted}" Value="True">
                          <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="HistoryMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                  <ui:LineIcon x:Name="HistoryMessageIcon" Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.History}" HorizontalAlignment="Center" />
                  <TextBlock x:Name="HistoryMessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,10,0,0" />
                  <Button x:Name="HistoryRetry" Style="{StaticResource SubtleButton}" Content="Try again" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnHistoryReload" Visibility="Collapsed" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="18,16">
              <Grid>
                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Restore}" HorizontalAlignment="Center" />
                  <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" Margin="0,10,0,0"
                             Text="Choose a file to see the versions the server keeps, and get one back." />
                </StackPanel>
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="DetailName" Style="{StaticResource H2}" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailFolder" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,3,0,0" />
                    <Border x:Name="DetailStatePill" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,10,0,0">
                      <TextBlock x:Name="DetailState" FontSize="12" />
                    </Border>
                    <Border x:Name="RestoreMessage" Style="{StaticResource OkChip}" Margin="0,10,0,0" Visibility="Collapsed">
                      <TextBlock x:Name="RestoreMessageText" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <TextBlock Style="{StaticResource Caps}" Text="VERSIONS ON THE SERVER" Margin="0,16,0,4" />
                  </StackPanel>
                  <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="VersionList" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type c:VersionRow}">
                            <Border Style="{StaticResource Row}" Loaded="OnRowLoaded">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{DynamicResource T.Line}" Margin="2,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" VerticalAlignment="Center" Margin="10,0,0,0" Click="OnRestore" CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal">
                                    <ui:LineIcon Width="15" Height="15" Margin="0,0,6,0" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Restore}" />
                                    <TextBlock Text="Restore" />
                                  </StackPanel>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="VersionsMessage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="8" Visibility="Collapsed" />
                  </Grid>
                </DockPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ============ Devices: every computer that uses the server ============ -->
        <Border x:Name="DevicesPage" Style="{StaticResource Card}" Margin="28,18,28,24" Padding="8" Visibility="Collapsed">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="DevicesPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
              <ItemsControl x:Name="DevicesList" Style="{StaticResource PlainList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type c:DeviceRowView}">
                    <Border Style="{StaticResource Row}" Padding="10" Loaded="OnRowLoaded">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" Margin="0,0,14,0">
                          <Ellipse Fill="{DynamicResource T.Node}" Stroke="{DynamicResource T.NodeRing}" StrokeThickness="1.5" />
                          <ui:LineIcon Width="20" Height="20" StrokeThickness="1.9" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Computer}" />
                          <Ellipse x:Name="StateDot" Width="12" Height="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Stroke="{DynamicResource T.Card}" StrokeThickness="2.5" Fill="{StaticResource S.Grey}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="12,0,4,0">
                          <TextBlock Text="{Binding StatusText}" FontSize="12" />
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Online}" Value="True">
                        <Setter TargetName="StateDot" Property="Fill" Value="{StaticResource S.Green}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
              <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Server}" HorizontalAlignment="Center" />
              <TextBlock x:Name="DevicesEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Margin="0,10,0,0"
                         Text="Loading the computers that use your server…" />
            </StackPanel>
            <!-- Adding happens on the new computer (it signs in); removing and renaming on the nest's website. -->
            <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="6,12,6,4" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource SubtleButton}" Content="+ Add a computer…" Click="OnAddComputer" />
                <Button Style="{StaticResource LinkButton}" Content="Manage devices on your nest" Margin="14,0,0,0" VerticalAlignment="Center" Click="OnManageDevices" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <!-- ============ Needs attention ============ -->
        <ScrollViewer x:Name="AttentionPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="28,18,28,24">
            <ItemsControl x:Name="AttentionList" Style="{StaticResource PlainList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,10" Loaded="OnRowLoaded">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Border CornerRadius="11,0,0,11" Background="{StaticResource S.Orange}" />
                      <StackPanel Grid.Column="1" Margin="16,14,0,14">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,3,0,0" />
                      </StackPanel>
                      <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Content="{Binding ActionLabel}" Margin="16,0,16,0"
                              VerticalAlignment="Center" Click="OnAttentionAction" CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel x:Name="AttentionEmpty" HorizontalAlignment="Center" Margin="0,80,0,0" Visibility="Collapsed">
              <Grid Width="56" Height="56" HorizontalAlignment="Center">
                <Ellipse Fill="{DynamicResource T.OkPill}" />
                <ui:LineIcon Width="28" Height="28" StrokeThickness="2.2" Stroke="{StaticResource S.Green}" Data="{StaticResource I.Check}" />
              </Grid>
              <TextBlock Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Nothing needs your attention" />
              <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Conflicts and files Pairnets can't sync show up here." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Settings (the form is a SettingsView the controller provides) ============ -->
        <ContentControl x:Name="SettingsPage" Margin="28,12,14,6" Focusable="False" Visibility="Collapsed" />
      </Grid>
    </Grid>
  </Grid>
</Window>
