<Window x:Class="Pairnets.Client.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core"
        Title="Pairnets" Width="980" Height="700" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ui:ActivityIconConverter x:Key="KindIcon" />
    <ui:VisibleConverter x:Key="Visible" />
    <ui:VisibleConverter x:Key="Hidden" Invert="True" />

    <!-- Activity rows, day headings and folder rows (Overview, Activity page) -->
    <DataTemplate DataType="{x:Type c:ActivityDay}">
      <Border Style="{StaticResource HairlineBottom}" Padding="0,14,0,6">
        <TextBlock Style="{StaticResource Day}" Text="{Binding Text}" />
      </Border>
    </DataTemplate>
    <DataTemplate DataType="{x:Type c:ActivityItem}">
      <Border x:Name="ActivityRow" Style="{StaticResource LineRow}" Padding="0,8" ToolTip="{Binding TimeText}" Loaded="OnRowLoaded">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Show in folder" Click="OnRevealActivity" />
            <MenuItem Header="Show versions…" Click="OnActivityVersions" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource GlyphCircle}" Margin="0,0,12,0">
            <ui:LineIcon Style="{StaticResource ToneIcon}" Tag="{Binding Tone}" Width="14" Height="14" StrokeThickness="2.4"
                         Data="{Binding Kind, Converter={StaticResource KindIcon}}" />
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Primary}" Style="{StaticResource Strong}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <!-- Messages without a file have nothing to show in a folder -->
        <DataTrigger Binding="{Binding Path}" Value="{x:Null}">
          <Setter TargetName="ActivityRow" Property="ContextMenu" Value="{x:Null}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate DataType="{x:Type c:ActivityFolder}">
      <Border Style="{StaticResource LineRow}" Padding="0,8" Loaded="OnRowLoaded">
        <StackPanel>
          <ToggleButton x:Name="FolderToggle" Style="{StaticResource RowToggle}" Checked="OnChevronToggled" Unchecked="OnChevronToggled">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource GlyphCircle}" Margin="0,0,12,0">
                <ui:LineIcon Style="{StaticResource ToneIcon}" Tag="{Binding Tone}" Width="14" Height="14" StrokeThickness="2.1" Data="{StaticResource I.Folder}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Primary}" Style="{StaticResource Bold}" TextTrimming="CharacterEllipsis" />
                  <ui:LineIcon x:Name="Chevron" Width="12" Height="12" StrokeThickness="2.6" Stroke="{DynamicResource T.Muted}"
                               Data="{StaticResource I.Chevron}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock Grid.Column="2" Text="{Binding WhenText}" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
          </ToggleButton>
          <ItemsControl ItemsSource="{Binding Items}" Style="{StaticResource PlainList}" Margin="40,6,0,0"
                        Visibility="{Binding IsChecked, ElementName=FolderToggle, Converter={StaticResource Visible}}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type c:ActivityItem}">
                <Grid Height="26">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Primary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding WhenText}" Style="{StaticResource MutedSmall}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="68" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ======================= Icon rail ======================= -->
    <Border Style="{StaticResource Sidebar}">
      <DockPanel Margin="0,18,0,16">
        <StackPanel DockPanel.Dock="Top">
          <Image x:Name="AppIcon" Width="32" Height="32" Margin="0,0,0,24" HorizontalAlignment="Center" ToolTip="Pairnets" />
          <RadioButton x:Name="NavOverview" Style="{StaticResource Nav}" GroupName="page" IsChecked="True" Checked="OnNav"
                       ToolTip="Overview" AutomationProperties.Name="Overview" Margin="0,0,0,6">
            <ui:LineIcon Data="{StaticResource I.Home}" />
          </RadioButton>
          <RadioButton x:Name="NavActivity" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav"
                       ToolTip="Activity" AutomationProperties.Name="Activity" Margin="0,0,0,6">
            <ui:LineIcon Data="{StaticResource I.Activity}" />
          </RadioButton>
          <RadioButton x:Name="NavHistory" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav"
                       ToolTip="History" AutomationProperties.Name="History" Margin="0,0,0,6">
            <ui:LineIcon Data="{StaticResource I.History}" />
          </RadioButton>
          <RadioButton x:Name="NavDevices" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav"
                       ToolTip="Devices" AutomationProperties.Name="Devices" Margin="0,0,0,6">
            <ui:LineIcon Data="{StaticResource I.Computer}" />
          </RadioButton>
          <RadioButton x:Name="NavAttention" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav"
                       ToolTip="Needs attention" AutomationProperties.Name="Needs attention">
            <Grid Width="44" Height="44">
              <ui:LineIcon Data="{StaticResource I.Warning}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Border x:Name="AttentionBadge" Style="{StaticResource Badge}" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,3,0">
                <TextBlock x:Name="AttentionCount" />
              </Border>
            </Grid>
          </RadioButton>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Button x:Name="UpdateRailButton" Style="{StaticResource RailButton}" Visibility="Collapsed" Click="OnToggleUpdate" Margin="0,0,0,6"
                  ToolTip="A new version of Pairnets is available" AutomationProperties.Name="Update available">
            <Grid Width="44" Height="44">
              <ui:LineIcon x:Name="UpdateIcon" Width="21" Height="21" StrokeThickness="1.8" Stroke="{DynamicResource T.Accent}" Data="{StaticResource I.Download}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              <Ellipse Width="8" Height="8" Fill="{DynamicResource T.Accent}" Stroke="{DynamicResource T.Sidebar}" StrokeThickness="2"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,9,0" />
            </Grid>
          </Button>
          <Button x:Name="AccountButton" Style="{StaticResource RailButton}" Click="OnToggleAccount" ToolTip="Account" AutomationProperties.Name="Account" Margin="0,0,0,6">
            <Border Style="{StaticResource Avatar}">
              <TextBlock x:Name="AccountInitial" Text="?" />
            </Border>
          </Button>
          <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav"
                       ToolTip="Settings" AutomationProperties.Name="Settings">
            <ui:LineIcon Data="{StaticResource I.Settings}" />
          </RadioButton>
          <!-- The Account page has no rail entry of its own (the account button opens it); this keeps the group whole. -->
          <RadioButton x:Name="NavAccount" Style="{StaticResource Nav}" GroupName="page" Checked="OnNav" Visibility="Collapsed" />
        </StackPanel>
        <Grid />
      </DockPanel>
    </Border>

    <!-- ======================= Page ======================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Margin="36,24,36,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Style="{StaticResource Title}" Text="Overview" VerticalAlignment="Center" />
          <Button x:Name="AttentionCallout" Style="{StaticResource CalloutButton}" Visibility="Collapsed" Click="OnReviewAttention" VerticalAlignment="Center" Margin="12,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource T.WarnFill}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock x:Name="AttentionCalloutText" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Review" FontSize="13" FontWeight="SemiBold" TextDecorations="Underline" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <TextBlock x:Name="PageSubtitle" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Click="OnOpenFolder" ToolTip="Open the synced folder" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.Folder}" Margin="0,0,8,0" />
              <TextBlock Text="Open folder" />
            </StackPanel>
          </Button>
          <Button Click="OnPause" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon x:Name="PauseGlyph" Data="{StaticResource I.Pause}" Margin="0,0,8,0" />
              <TextBlock x:Name="PauseText" Text="Pause" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource AccentButton}" Click="OnSyncNow" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon StrokeThickness="2" Data="{StaticResource I.Sync}" Margin="0,0,8,0" />
              <TextBlock Text="Sync now" />
            </StackPanel>
          </Button>
          <Button x:Name="MoreButton" Style="{StaticResource IconButton}" ToolTip="More" AutomationProperties.Name="More" Click="OnMore">
            <ui:LineIcon Width="18" Height="18" StrokeThickness="3.2" Data="{StaticResource I.More}" />
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="View log" Click="OnViewLog">
                  <MenuItem.Icon>
                    <ui:LineIcon Data="{StaticResource I.Log}" />
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Report a bug…" Click="OnReportBug">
                  <MenuItem.Icon>
                    <ui:LineIcon Data="{StaticResource I.Bug}" />
                  </MenuItem.Icon>
                </MenuItem>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <!-- ============ Overview ============ -->
        <ScrollViewer x:Name="OverviewPage" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="36,18,36,0">
            <!-- The ring and what it means -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="152" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid x:Name="RingHost" Width="152" Height="152" VerticalAlignment="Top">
                <ui:ProgressRing x:Name="Ring" Thickness="8" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock x:Name="RingText" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="RingCaption" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,1,0,0" Visibility="Collapsed" />
                </StackPanel>
                <ui:LineIcon x:Name="RingIcon" Width="50" Height="50" StrokeThickness="2.2" Visibility="Collapsed"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Grid>
              <StackPanel Grid.Column="1" Margin="36,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Headline" Style="{StaticResource H1}" Text="Starting…" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="116" />
                <TextBlock x:Name="Lead" Style="{StaticResource Lead}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <ItemsControl x:Name="DetailLines" Style="{StaticResource PlainList}" Margin="0,8,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" Style="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="FixButton" Style="{StaticResource WarnButton}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnFix" />
                <StackPanel x:Name="WaitPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
                  <Button Content="Download now anyway" Click="OnDownloadNow" />
                  <TextBlock Style="{StaticResource MutedSmall}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="330" Margin="14,0,0,0"
                             Text="Stops waiting by itself if the other computer goes quiet for 2 minutes." />
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- This computer ── server ── the other computer -->
            <Border Style="{StaticResource Hairline}" BorderThickness="0,1,0,1" Padding="0,14" Margin="0,22,0,0">
              <ui:DeviceMapView x:Name="Map" />
            </Border>

            <!-- In progress (while files move) and recent activity -->
            <Grid x:Name="ListsGrid" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel x:Name="TransferCard" Visibility="Collapsed">
                <TextBlock Style="{StaticResource H2}" Text="In progress" Margin="0,0,0,4" />
                <ItemsControl x:Name="ActiveList" Style="{StaticResource PlainList}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type c:TransferRowView}">
                      <StackPanel Loaded="OnRowLoaded">
                        <!-- One file -->
                        <StackPanel Margin="0,9" Visibility="{Binding IsFolder, Converter={StaticResource Hidden}}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Strong}" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding PercentText}" Style="{StaticResource Muted}" Margin="12,0,0,0" />
                          </Grid>
                          <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Margin="0,7,0,0"
                                       ui:Motion.SmoothValue="{Binding PercentValue, Mode=OneWay}" />
                        </StackPanel>
                        <!-- A folder: opens to list every file of this sync in it -->
                        <StackPanel Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
                          <ToggleButton x:Name="GroupToggle" Style="{StaticResource RowToggle}" Padding="0,9" Checked="OnChevronToggled" Unchecked="OnChevronToggled">
                            <StackPanel>
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:LineIcon x:Name="Chevron" Width="12" Height="12" StrokeThickness="2.6" Stroke="{DynamicResource T.Muted}"
                                             Data="{StaticResource I.Chevron}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:LineIcon Grid.Column="1" Stroke="{DynamicResource T.Accent}" Data="{StaticResource I.Folder}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Title}" Style="{StaticResource Bold}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding PercentText}" Style="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" />
                              </Grid>
                              <ProgressBar Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Margin="0,7,0,0"
                                           ui:Motion.SmoothValue="{Binding PercentValue, Mode=OneWay}" />
                            </StackPanel>
                          </ToggleButton>
                          <ScrollViewer MaxHeight="112" Margin="28,0,0,4" HorizontalScrollBarVisibility="Disabled"
                                        Visibility="{Binding IsChecked, ElementName=GroupToggle, Converter={StaticResource Visible}}">
                            <ItemsControl ItemsSource="{Binding Files}" Style="{StaticResource PlainList}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type c:BatchFile}">
                                  <Grid Height="26">
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="Auto" />
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="13" Height="13" Margin="0,0,10,0" VerticalAlignment="Center">
                                      <ui:LineIcon Width="13" Height="13" StrokeThickness="2.6" Stroke="{DynamicResource S.Green}"
                                                   Data="{StaticResource I.Check}" Visibility="{Binding IsDone, Converter={StaticResource Visible}}" />
                                      <ui:LineIcon Width="13" Height="13" StrokeThickness="2.6" Stroke="{DynamicResource S.Blue}"
                                                   Data="{StaticResource I.Up}" Visibility="{Binding IsMovingUp, Converter={StaticResource Visible}}" />
                                      <ui:LineIcon Width="13" Height="13" StrokeThickness="2.6" Stroke="{DynamicResource S.Blue}"
                                                   Data="{StaticResource I.Down}" Visibility="{Binding IsMovingDown, Converter={StaticResource Visible}}" />
                                      <Ellipse Width="5" Height="5" Fill="{DynamicResource T.Muted}" Visibility="{Binding IsWaiting, Converter={StaticResource Visible}}" />
                                    </Grid>
                                    <TextBlock x:Name="FileName" Grid.Column="1" Text="{Binding FileName}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                  </Grid>
                                  <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsWaiting}" Value="True">
                                      <Setter TargetName="FileName" Property="Foreground" Value="{DynamicResource T.Muted}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMoving}" Value="True">
                                      <Setter TargetName="FileName" Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                  </DataTemplate.Triggers>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </ScrollViewer>
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel x:Name="RecentPanel" Grid.ColumnSpan="3">
                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource H2}" Text="Recent" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="See all" Click="OnSeeAllActivity" />
                </Grid>
                <ItemsControl x:Name="RecentList" Style="{StaticResource PlainList}" />
                <TextBlock x:Name="RecentEmpty" Style="{StaticResource Muted}" Margin="0,8" TextWrapping="Wrap"
                           Text="Nothing has happened yet. Changes appear here as they sync." />
              </StackPanel>
            </Grid>

            <!-- Facts -->
            <Border Style="{StaticResource Hairline}" Padding="0,14,0,18" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="24" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Tile}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Folder" Margin="0,0,0,3" />
                    <TextBlock x:Name="FolderText" Style="{StaticResource Value}" Text="–" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Grid.Column="2">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Last synced" Margin="0,0,0,3" />
                    <TextBlock x:Name="LastSync" Style="{StaticResource Value}" Text="Not yet" />
                  </StackPanel>
                </Border>
                <Border x:Name="VersionTile" Style="{StaticResource Tile}" Grid.Column="4">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Server" Margin="0,0,0,3" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Value}" Text="–" />
                    <Button x:Name="VersionButton" Style="{StaticResource LinkButton}" FontSize="12.5" HorizontalAlignment="Left" Margin="0,3,0,0" Click="OnUpdateServer" Visibility="Collapsed" />
                  </StackPanel>
                </Border>
                <Border x:Name="SpaceTile" Style="{StaticResource Tile}" Grid.Column="6">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Caps}" Text="Free space" Margin="0,0,0,3" />
                    <TextBlock x:Name="SpaceText" Style="{StaticResource Value}" Text="–" />
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Activity ============ -->
        <Grid x:Name="ActivityPage" Margin="36,18,36,0" Visibility="Collapsed">
          <ScrollViewer x:Name="ActivityPanel" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ActivityList" Style="{StaticResource PlainList}" Margin="0,0,0,24" />
          </ScrollViewer>
          <StackPanel x:Name="ActivityEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Activity}" HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" Text="Nothing has happened yet. Changes appear here as they sync." />
          </StackPanel>
        </Grid>

        <!-- ============ History ============ -->
        <Grid x:Name="HistoryPage" Margin="36,20,36,24" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Segments}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="DeletedTab" Style="{StaticResource Seg}" GroupName="history" IsChecked="True" Checked="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource I.Trash}" />
                    <TextBlock Text="Deleted files" />
                  </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FilesTab" Style="{StaticResource Seg}" GroupName="history" Checked="OnHistoryModeChanged">
                  <StackPanel Orientation="Horizontal">
                    <ui:LineIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource I.File}" />
                    <TextBlock Text="All files" />
                  </StackPanel>
                </RadioButton>
              </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="10,0">
              <TextBox x:Name="HistorySearch" Style="{StaticResource Input}" Padding="38,8,12,8" ui:Look.Placeholder="Search by name or folder" TextChanged="OnHistorySearch" />
              <ui:LineIcon Width="16" Height="16" Margin="13,0,0,0" HorizontalAlignment="Left" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Search}" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" ToolTip="Reload from the server" Click="OnHistoryReload">
              <ui:LineIcon Data="{StaticResource I.Sync}" />
            </Button>
          </Grid>

          <Border Grid.Row="1" Style="{StaticResource Hairline}" Margin="0,18,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border BorderBrush="{DynamicResource T.Border}" BorderThickness="0,0,1,0" Padding="0,14,24,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock x:Name="HistorySummary" Style="{StaticResource MutedSmall}" FontWeight="SemiBold" Margin="0,0,0,8" />
                  <ListBox x:Name="FileList" Grid.Row="1" Style="{StaticResource Rows}" SelectionChanged="OnFileSelected">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type c:ServerFile}">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Border Style="{StaticResource GlyphCircle}" Width="30" Height="30" CornerRadius="15" Margin="0,0,12,0">
                            <Grid>
                              <ui:LineIcon Width="14" Height="14" StrokeThickness="2.1" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.File}"
                                           Visibility="{Binding Deleted, Converter={StaticResource Hidden}}" />
                              <ui:LineIcon Width="14" Height="14" StrokeThickness="2.1" Stroke="{DynamicResource S.Red}" Data="{StaticResource I.Trash}"
                                           Visibility="{Binding Deleted, Converter={StaticResource Visible}}" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Strong}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Secondary}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel x:Name="HistoryMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <ui:LineIcon x:Name="HistoryMessageIcon" Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.History}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HistoryMessageText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" Margin="0,10,0,0" />
                    <Button x:Name="HistoryRetry" Content="Try again" HorizontalAlignment="Center" Margin="0,10,0,0" Click="OnHistoryReload" Visibility="Collapsed" />
                  </StackPanel>
                </Grid>
              </Border>

              <Grid Grid.Column="1" Margin="28,18,0,0">
                <StackPanel x:Name="DetailEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Restore}" HorizontalAlignment="Center" />
                  <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260" Margin="0,10,0,0"
                             Text="Choose a file to see the versions the server keeps, and get one back." />
                </StackPanel>
                <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                  <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="DetailName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailFolder" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <Border x:Name="DetailStatePill" Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,5">
                      <TextBlock x:Name="DetailState" />
                    </Border>
                    <Border x:Name="RestoreMessage" Style="{StaticResource OkChip}" Margin="0,12,0,0" Visibility="Collapsed">
                      <TextBlock x:Name="RestoreMessageText" TextWrapping="Wrap" FontSize="12.5" />
                    </Border>
                    <TextBlock Style="{StaticResource H2}" Text="Versions on the server" Margin="0,24,0,4" />
                  </StackPanel>
                  <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="VersionList" Style="{StaticResource PlainList}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type c:VersionRow}">
                            <Border Style="{StaticResource LineRow}" Padding="0,10" Loaded="OnRowLoaded">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource T.Muted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Title}" Style="{StaticResource Bold}" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0" MinHeight="32" Padding="12,0" Click="OnRestore" CommandParameter="{Binding}">
                                  <StackPanel Orientation="Horizontal">
                                    <ui:LineIcon Width="14" Height="14" Margin="0,0,7,0" Data="{StaticResource I.Restore}" />
                                    <TextBlock Text="Restore" />
                                  </StackPanel>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="VersionsMessage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8" Visibility="Collapsed" />
                  </Grid>
                </DockPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- ============ Devices: every computer that uses the server ============ -->
        <Grid x:Name="DevicesPage" Margin="36,20,36,24" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <ScrollViewer x:Name="DevicesPanel" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
            <Border Style="{StaticResource Hairline}" VerticalAlignment="Top">
              <ItemsControl x:Name="DevicesList" Style="{StaticResource PlainList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type c:DeviceRow}">
                    <Border Style="{StaticResource LineRow}" Padding="0,14" Loaded="OnRowLoaded">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" Margin="0,0,14,0">
                          <Border Style="{StaticResource GlyphCircle}" Width="40" Height="40" CornerRadius="20">
                            <ui:LineIcon Width="19" Height="19" StrokeThickness="1.8" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Computer}" />
                          </Border>
                          <Ellipse x:Name="StateDot" Style="{StaticResource Dot}" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Fill="{DynamicResource S.Grey}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Bold}" FontSize="14" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedSmall}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border x:Name="StatePill" Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center" Margin="12,0,0,0" Padding="10,4">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                      </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Online}" Value="True">
                        <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource S.Green}" />
                        <Setter TargetName="StatePill" Property="Style" Value="{StaticResource OkPill}" />
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </ScrollViewer>
          <StackPanel x:Name="DevicesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Server}" HorizontalAlignment="Center" />
            <TextBlock x:Name="DevicesEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Margin="0,10,0,0"
                       Text="Loading the computers that use your server…" />
          </StackPanel>
          <!-- Adding happens on the new computer (it signs in); removing and renaming on the nest's website. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,0">
            <Button Click="OnAddComputer" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Data="{StaticResource I.Plus}" Margin="0,0,8,0" />
                <TextBlock Text="Add a computer…" />
              </StackPanel>
            </Button>
            <Button Click="OnManageDevices">
              <StackPanel Orientation="Horizontal">
                <ui:LineIcon Width="15" Height="15" Data="{StaticResource I.External}" Margin="0,0,8,0" />
                <TextBlock Text="Manage devices on the web" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ============ Needs attention ============ -->
        <ScrollViewer x:Name="AttentionPage" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="36,20,36,24">
            <Border x:Name="AttentionListBorder" Style="{StaticResource Hairline}">
              <ItemsControl x:Name="AttentionList" Style="{StaticResource PlainList}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource LineRow}" Padding="0,16" Loaded="OnRowLoaded">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="{DynamicResource T.WarnPill}" Margin="0,0,14,0" VerticalAlignment="Center">
                          <ui:LineIcon Width="17" Height="17" StrokeThickness="2.2" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" Style="{StaticResource Bold}" FontSize="14" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="{Binding ActionLabel}" Margin="16,0,0,0" MinHeight="34"
                                VerticalAlignment="Center" Click="OnAttentionAction" CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <StackPanel x:Name="AttentionEmpty" HorizontalAlignment="Center" Margin="0,110,0,0" Visibility="Collapsed">
              <Border Width="64" Height="64" CornerRadius="32" BorderThickness="2" BorderBrush="{DynamicResource S.Green}" HorizontalAlignment="Center">
                <ui:LineIcon Width="28" Height="28" StrokeThickness="2.2" Stroke="{DynamicResource S.Green}" Data="{StaticResource I.Check}" />
              </Border>
              <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" Text="Nothing needs you right now" />
              <TextBlock Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Conflicts and files Pairnets can't sync on its own show up here." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- ============ Settings (the form is a SettingsView the controller provides) ============ -->
        <ContentControl x:Name="SettingsPage" Margin="36,12,20,0" Focusable="False" Visibility="Collapsed" />

        <!-- ============ Account (from the account button) ============ -->
        <ScrollViewer x:Name="AccountPage" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
          <StackPanel Margin="36,20,36,24">
            <Border Style="{StaticResource Hairline}" Padding="0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="Signed in" />
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Style="{StaticResource AvatarLarge}" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="AccountPageInitial" Text="?" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AccountPageTitle" Style="{StaticResource Bold}" FontSize="15" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountPageSubtitle" Style="{StaticResource Muted}" FontSize="13" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource DangerButton}" Content="Sign out of this computer…" VerticalAlignment="Center" Click="OnSignOut" />
                </Grid>
              </Grid>
            </Border>
            <Border Style="{StaticResource Hairline}" Padding="0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="Your nest" />
                <StackPanel Grid.Column="1">
                  <TextBlock x:Name="AccountNest" Style="{StaticResource Strong}" FontSize="14" TextTrimming="CharacterEllipsis" />
                  <TextBlock x:Name="AccountNestDetail" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Click="OnOpenNest" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal">
                        <ui:LineIcon Width="15" Height="15" Data="{StaticResource I.External}" Margin="0,0,8,0" />
                        <TextBlock Text="Open your nest" />
                      </StackPanel>
                    </Button>
                    <Button Click="OnManageDevices">
                      <StackPanel Orientation="Horizontal">
                        <ui:LineIcon Width="15" Height="15" Data="{StaticResource I.External}" Margin="0,0,8,0" />
                        <TextBlock Text="Manage devices on the web" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Hairline}" Padding="0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="This computer" />
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="AccountDevice" Style="{StaticResource Strong}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="AccountDeviceDetail" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Rename in Settings" VerticalAlignment="Center" Click="OnRenameInSettings" />
                </Grid>
              </Grid>
            </Border>
            <Border Style="{StaticResource Hairline}" Padding="0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="Notifications" />
                <StackPanel Grid.Column="1">
                  <CheckBox x:Name="NotifyJoin" Style="{StaticResource Switch}" IsChecked="True" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged"
                            Content="When another computer wants to join" />
                  <CheckBox x:Name="NotifyAttention" Style="{StaticResource Switch}" IsChecked="True" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged"
                            Content="When something needs your attention" Margin="0,22,0,0" />
                  <CheckBox x:Name="NotifyUpdates" Style="{StaticResource Switch}" IsChecked="True" Checked="OnNotifyChanged" Unchecked="OnNotifyChanged"
                            Content="When a new version of Pairnets is out" Margin="0,22,0,0" />
                </StackPanel>
              </Grid>
            </Border>
            <Border Style="{StaticResource Hairline}" BorderThickness="0,1,0,1" Padding="0,18">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SettingLabel}" Text="Start over" />
                <Grid Grid.Column="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Style="{StaticResource Help}" Margin="0,0,18,0" VerticalAlignment="Center"
                             Text="Forgets every setting, signs this computer out of your nest and starts again from the sign-in screen. The files in your sync folder are never deleted." />
                  <Button Grid.Column="1" Style="{StaticResource DangerButton}" Content="Reset this app…" VerticalAlignment="Center" Click="OnResetApp" />
                </Grid>
              </Grid>
            </Border>
            <TextBlock x:Name="AppVersion" Style="{StaticResource MutedSmall}" Margin="0,18,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ======================= Things that float over the window (in the window, so screenshots show them) ======================= -->
    <Grid x:Name="PopoverLayer" Grid.ColumnSpan="2" Visibility="Collapsed" Background="Transparent" MouseDown="OnPopoverLayerPressed">
      <!-- The app update (from the rail's download button) -->
      <Border x:Name="UpdateCard" Style="{StaticResource Popover}" Width="292" Padding="16" Margin="76,0,0,112"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" MouseDown="OnPopoverPressed">
        <StackPanel>
          <TextBlock x:Name="UpdateTitle" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="UpdateDetail" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
          <ProgressBar x:Name="UpdateProgress" Style="{StaticResource ThinProgress}" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,10,0,0" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" MinHeight="32" Padding="14,0" Content="Download" Click="OnUpdateNow" />
            <Button x:Name="UpdateLater" Style="{StaticResource FlatButton}" MinHeight="32" Padding="12,0" Margin="8,0,0,0" Content="Later" Click="OnUpdateLater" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- The account menu (from the rail's account button) -->
      <Border x:Name="AccountMenu" Style="{StaticResource Popover}" Width="300" Padding="8" Margin="76,0,0,62"
              HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed" MouseDown="OnPopoverPressed">
        <StackPanel>
          <Grid Margin="10,10,10,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Avatar}" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
              <TextBlock x:Name="AccountMenuInitial" Text="?" FontSize="17" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="AccountMenuTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="AccountMenuSubtitle" Style="{StaticResource Muted}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
          <Border Style="{StaticResource Hairline}" Margin="10,0" Padding="0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="This computer" Margin="0,0,14,6" />
              <TextBlock x:Name="AccountMenuDevice" Grid.Column="1" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
              <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="12.5" Text="Your nest" Margin="0,0,14,0" />
              <TextBlock x:Name="AccountMenuNest" Grid.Row="1" Grid.Column="1" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
            </Grid>
          </Border>
          <Border Style="{StaticResource Hairline}" Margin="10,0,10,6" />
          <Button Style="{StaticResource MenuItemButton}" Click="OnAccountSettings">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.Person}" Margin="0,0,10,0" />
              <TextBlock Text="Account settings" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuItemButton}" Click="OnManageDevices">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.External}" Margin="0,0,10,0" />
              <TextBlock Text="Manage devices on the web" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource MenuItemDangerButton}" Click="OnSignOut">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Data="{StaticResource I.SignOut}" Margin="0,0,10,0" />
              <TextBlock Text="Sign out of this computer…" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
