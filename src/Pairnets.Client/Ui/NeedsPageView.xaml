<UserControl x:Class="Pairnets.Client.Ui.NeedsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="28,40,28,24">
      <StackPanel>
        <TextBlock Style="{StaticResource PgTitle}" Text="Needs you" />
        <TextBlock x:Name="Subtitle" Style="{StaticResource PgSub}" />
      </StackPanel>

      <StackPanel x:Name="Cards" Margin="0,16,0,0" />

      <!-- Nothing to decide -->
      <StackPanel x:Name="CalmState" HorizontalAlignment="Center" Margin="0,90,0,0" Visibility="Collapsed">
        <Grid Width="56" Height="56" HorizontalAlignment="Center">
          <Ellipse Fill="{DynamicResource T.OkPill}" />
          <ui:LineIcon Width="28" Height="28" StrokeThickness="2.4" Stroke="{DynamicResource T.Ok}" Data="{StaticResource I.Check}" />
        </Grid>
        <TextBlock Text="Nothing needs you" FontSize="22" FontWeight="ExtraBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock Style="{StaticResource PgSub}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" Margin="0,8,0,0"
                   Text="Conflicts, new computers and files Pairnets can't sync show up here. Everything is syncing fine." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
