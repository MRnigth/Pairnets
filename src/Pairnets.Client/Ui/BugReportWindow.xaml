<Window x:Class="Pairnets.Client.Ui.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        Title="Report a bug" Width="680" Height="580" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid>
  <Grid Margin="24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="StateCircle" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource T.AccentSoft}" VerticalAlignment="Top" Margin="0,0,14,0">
        <ui:LineIcon x:Name="StateIcon" Width="20" Height="20" StrokeThickness="2.6" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Clock}" />
      </Border>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="ExtraBold" TextWrapping="Wrap" Text="Building the bug report…" />
        <TextBlock x:Name="Explanation" Foreground="{DynamicResource T.Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="It collects the versions, your settings (never the token), the sync status, the nest's update details, crash notes (cleaned of your files and names), recent activity and the last part of the log." />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
      <Border Style="{StaticResource OkChip}" CornerRadius="13" Padding="10,4">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="13" Height="13" StrokeThickness="2.2" Stroke="{DynamicResource T.OkText}" Data="{x:Static ui:StepIcons.Shield}" Margin="0,0,6,0" />
          <TextBlock x:Name="SentChipText" Text="Nothing was sent anywhere" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.OkText}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Chip}" CornerRadius="13" Padding="10,4" Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="13" Height="13" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{x:Static ui:StepIcons.Lock}" Margin="0,0,6,0" />
          <TextBlock Text="No passwords or keys inside" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Shown when crash cards were not sent yet: the only thing in this window that sends anything, and only when pressed. -->
    <Border x:Name="CrashBanner" Grid.Row="2" Margin="0,14,0,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource T.Border}"
            Background="{DynamicResource T.AccentSoft}" Padding="14,12" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon Width="18" Height="18" StrokeThickness="2.2" Stroke="{DynamicResource T.AccentInk}" Data="{x:Static ui:StepIcons.Mail}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="CrashBannerTitle" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Text="Pairnets crashed. Help us fix it?" />
          <TextBlock x:Name="CrashBannerText" FontSize="12" Foreground="{DynamicResource T.Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Text="Send the crash report to us. You see exactly what is sent first." />
        </StackPanel>
        <Button x:Name="SendCrashButton" Grid.Column="2" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="OnSendCrash">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="White" Data="{x:Static ui:StepIcons.Arrow}" Margin="0,0,8,0" />
            <TextBlock Text="Send crash report…" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="3" Margin="0,14,0,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource T.Border}" Background="{DynamicResource T.Card}" Padding="4,4">
      <TextBox x:Name="ReportText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
               FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="12,8" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Border>

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="OnCopy">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{x:Static ui:StepIcons.Copy}" Margin="0,0,8,0" />
          <TextBlock Text="Copy again" />
        </StackPanel>
      </Button>
      <Button x:Name="OpenButton" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsEnabled="False" Click="OnOpenFile">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.File}" Margin="0,0,8,0" />
          <TextBlock Text="Open the saved file" />
        </StackPanel>
      </Button>
      <Button Style="{StaticResource AccentButton}" Content="Close" Padding="20,0" Click="OnClose" />
    </StackPanel>
  </Grid>
  </Grid>
</Window>
