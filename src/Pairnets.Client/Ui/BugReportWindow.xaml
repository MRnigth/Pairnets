<Window x:Class="Pairnets.Client.Ui.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pairnets – report a bug" Width="680" Height="580" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" Style="{StaticResource H2}" FontSize="18" Text="Building the bug report…" />
      <TextBlock x:Name="Explanation" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="It collects the versions, your settings (never the token), the sync status, the server's update details, recent activity and the last part of the log." />
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource CodeBox}" Margin="0,14,0,0">
      <TextBox x:Name="ReportText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource T.Text}"
               FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="OpenButton" Style="{StaticResource SubtleButton}" Content="Open file" Margin="0,0,8,0" IsEnabled="False" Click="OnOpenFile" />
      <Button x:Name="CopyButton" Style="{StaticResource SubtleButton}" Content="Copy again" Margin="0,0,8,0" IsEnabled="False" Click="OnCopy" />
      <Button Style="{StaticResource AccentButton}" Content="Close" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
