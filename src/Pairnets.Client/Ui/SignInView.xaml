<UserControl x:Class="Pairnets.Client.Ui.SignInView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <!-- Signing in with a Pairnets account: sign in → finish in the browser → (no nest yet) → choose the folder.
       "I run my own nest" leads to the nest's own sign-in: its address → approve this computer there → choose the folder. -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,26,28,24">

        <!-- 1. Sign in to Pairnets: Google, or email -->
        <StackPanel x:Name="AccountStep" MaxWidth="364" Margin="0,30,0,0">
          <Image x:Name="AccountIcon" Width="52" Height="52" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource H1}" FontSize="26" Text="Sign in to Pairnets" HorizontalAlignment="Center" Margin="0,18,0,0" />
          <TextBlock Style="{StaticResource Muted}" Text="Keep one folder the same on all your computers." HorizontalAlignment="Center"
                     TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
          <Border x:Name="AccountOutcomeBox" Style="{StaticResource Callout}" Margin="0,18,0,-12" Visibility="Collapsed">
            <TextBlock x:Name="AccountOutcomeText" Foreground="{DynamicResource T.WarnText}" TextWrapping="Wrap" />
          </Border>

          <!-- "Continue with Google": the browser page signs in with Google -->
          <Button x:Name="AccountGoogleButton" Style="{StaticResource SubtleButton}" Padding="13,12" HorizontalAlignment="Stretch"
                  Margin="0,30,0,0" Click="OnAccountGoogle">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                <Canvas Width="48" Height="48">
                  <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                  <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                  <Path Fill="#34A853" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                  <Path Fill="#FBBC05" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                </Canvas>
              </Viewbox>
              <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- or -->
          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Style="{StaticResource MutedSmall}" Text="or" Margin="12,0" />
            <Border Grid.Column="2" Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
          </Grid>

          <!-- "Continue with email": the browser page sends a sign-in link to this address -->
          <Grid Margin="0,12,0,0">
            <TextBox x:Name="AccountEmailBox" Style="{StaticResource Input}" Padding="13,11" />
            <TextBlock x:Name="AccountEmailHint" Style="{StaticResource Muted}" Text="Enter your email" Margin="15,0,0,0"
                       VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
          <TextBlock x:Name="AccountEmailProblem" Style="{StaticResource MutedSmall}" Foreground="{DynamicResource T.BadText}" Margin="2,6,0,0"
                     Text="Type your email address first." Visibility="Collapsed" />
          <Button x:Name="AccountEmailButton" Style="{StaticResource AccentButton}" Content="Continue with email" Padding="13,12"
                  HorizontalAlignment="Stretch" Margin="0,12,0,0" Click="OnAccountEmail" />

          <!-- Accounts are made by signing in: the service's sign-in page -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <TextBlock Style="{StaticResource Muted}" Text="New here?" VerticalAlignment="Center" />
            <Button x:Name="MakeAccountButton" Style="{StaticResource LinkButton}" Padding="4,3" Margin="1,0,0,0" VerticalAlignment="Center" Click="OnMakeAccount">
              <TextBlock Text="Make an account" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource T.Text}" TextDecorations="Underline" />
            </Button>
          </StackPanel>
        </StackPanel>

        <!-- 2. Finish in your browser: the code to compare, until this computer is allowed there -->
        <StackPanel x:Name="AccountWaitStep" MaxWidth="364" Margin="0,38,0,0" Visibility="Collapsed">
          <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource T.Pill}" HorizontalAlignment="Center">
            <ui:LineIcon Width="24" Height="24" StrokeThickness="1.8" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Browser}" />
          </Border>
          <TextBlock Style="{StaticResource H1}" FontSize="26" Text="Finish in your browser" HorizontalAlignment="Center" Margin="0,18,0,0" />
          <TextBlock x:Name="AccountWaitIntro" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0">
            <Run Text="We opened " /><Run x:Name="AccountServiceRun" Text="sync.pairnets.app" Foreground="{DynamicResource T.Text}" FontWeight="SemiBold" /><Run Text=". Sign in there and press Allow." />
          </TextBlock>
          <TextBlock x:Name="AccountStartingText" Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                     Text="Asking Pairnets for a code…" Visibility="Collapsed" />
          <Border BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="12" Padding="12,18,12,20" Margin="0,26,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="The page shows this code. It should match:" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" />
              <TextBlock x:Name="AccountCodeText" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="32" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <Grid Margin="0,18,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
              <Ellipse Width="16.4" Height="16.4" Stroke="{DynamicResource T.Track}" StrokeThickness="2.4" />
              <Path x:Name="AccountRing" Width="18" Height="18" Stroke="{DynamicResource T.Accent}" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12.5,2.94 A 7,7 0 0 1 15.06,12.5" />
            </Grid>
            <TextBlock x:Name="AccountWaitText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" />
          </Grid>
          <TextBlock x:Name="AccountExpiresText" Style="{StaticResource MutedSmall}" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <!-- 3. Allowed, but the account has no nest yet: how to set one up, until it has one -->
        <StackPanel x:Name="NoNestStep" MaxWidth="364" Margin="0,30,0,0" Visibility="Collapsed">
          <Border Style="{StaticResource OkChip}" CornerRadius="14" Padding="12,5" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="13" Height="13" StrokeThickness="2.8" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.Check}"
                           Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock x:Name="NoNestAccountText" Foreground="{DynamicResource T.OkText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource H1}" FontSize="26" Text="Your account has no nest yet" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" Margin="0,22,0,0" />
          <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"
                     Text="A nest is your own Linux computer that keeps your folder. Set it up once with one command, and every computer you sign in finds it by itself." />
          <Button x:Name="ShowMeHowButton" Style="{StaticResource AccentButton}" Content="Show me how" Padding="13,12" HorizontalAlignment="Stretch"
                  Margin="0,28,0,0" Click="OnShowMeHow" />
          <Grid Margin="0,18,0,0" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top">
              <Ellipse Width="16.4" Height="16.4" Stroke="{DynamicResource T.Track}" StrokeThickness="2.4" />
              <Path x:Name="NoNestRing" Width="18" Height="18" Stroke="{DynamicResource T.Accent}" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 12.5,2.94 A 7,7 0 0 1 15.06,12.5" />
            </Grid>
            <TextBlock x:Name="NoNestWaitText" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Text="Waiting for your nest…" />
          </Grid>
        </StackPanel>

        <!-- 4. I run my own nest: which nest, then the ways to sign in there -->
        <StackPanel x:Name="WelcomeStep" MaxWidth="470" Visibility="Collapsed">
          <Image x:Name="AppIcon" Width="64" Height="64" HorizontalAlignment="Center" />
          <TextBlock Style="{StaticResource H1}" Text="Sign in" HorizontalAlignment="Center" Margin="0,14,0,0" />
          <TextBlock Style="{StaticResource Muted}" Text="Keep one folder the same on all your computers." HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,14" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Style="{StaticResource Label}" Text="Your nest" />
              <TextBox x:Name="AddressBox" Style="{StaticResource Input}" Margin="0,6,0,0" ToolTip="Your nest's name, for example nest.example.com" />
              <StackPanel x:Name="CheckRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                <ui:LineIcon x:Name="CheckIcon" Width="14" Height="14" Margin="0,2,6,0" VerticalAlignment="Top" />
                <TextBlock x:Name="CheckText" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" MaxWidth="380" />
              </StackPanel>

              <!-- "Continue with Google": the browser signs in with Google right away -->
              <Button x:Name="GoogleButton" Style="{StaticResource SubtleButton}" Padding="13,10" HorizontalAlignment="Stretch"
                      Margin="0,16,0,0" Click="OnGoogle" IsEnabled="False" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Viewbox Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="48" Height="48">
                      <Path Fill="#EA4335" Data="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                      <Path Fill="#4285F4" Data="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                      <Path Fill="#34A853" Data="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                      <Path Fill="#FBBC05" Data="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Continue with Google" VerticalAlignment="Center" />
                </StackPanel>
              </Button>

              <!-- or -->
              <Grid x:Name="OrRow" Margin="0,14,0,2" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource MutedSmall}" Text="OR" Margin="10,0" />
                <Border Grid.Column="2" Height="1" Background="{DynamicResource T.Border}" VerticalAlignment="Center" />
              </Grid>

              <!-- "Continue with email": a sign-in link lands in the owner's inbox -->
              <StackPanel x:Name="EmailPanel" Visibility="Collapsed">
                <Grid Margin="0,12,0,0">
                  <TextBox x:Name="EmailBox" Style="{StaticResource Input}" IsEnabled="False" />
                  <TextBlock x:Name="EmailHint" Style="{StaticResource Muted}" Text="Enter your email" Margin="9,0,0,0"
                             VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <Button x:Name="EmailButton" Style="{StaticResource AccentButton}" Content="Continue with email" Padding="13,10"
                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Click="OnEmail" IsEnabled="False" IsDefault="True" />
              </StackPanel>

              <!-- password, passkey, and everything else live on the nest's own page -->
              <Button x:Name="BrowserButton" Style="{StaticResource AccentButton}" Content="Sign in with your browser" Padding="13,10"
                      HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnSignIn" IsEnabled="False" />
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                     Text="Your nest is your own server. New computers only get in when you allow them there." />
        </StackPanel>

        <!-- 5. Waiting: the code to compare, until it is approved on the nest -->
        <StackPanel x:Name="WaitStep" MaxWidth="470" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Approve this computer" />
          <TextBlock x:Name="WaitIntro" TextWrapping="Wrap" Margin="0,10,0,12"
                     Text="Your browser opened your nest. Sign in there and check that it shows this code:" />
          <Border Style="{StaticResource Card}" Padding="12,18">
            <TextBlock x:Name="CodeText" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" FontSize="34" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
          </Border>
          <StackPanel x:Name="WaitRow" Orientation="Horizontal" Margin="0,14,0,0">
            <ui:LineIcon Width="16" Height="16" Margin="0,0,8,0" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Wait}" />
            <TextBlock x:Name="WaitText" Style="{StaticResource Muted}" />
          </StackPanel>
          <TextBlock x:Name="WaitHint" Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Text="Your other computers show a “wants to join” notice too; it leads to the same page." />
          <Border x:Name="OutcomeBox" Style="{StaticResource Callout}" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="OutcomeText" TextWrapping="Wrap" />
          </Border>
          <WrapPanel Margin="0,14,0,0">
            <Button x:Name="OpenAgainButton" Style="{StaticResource SubtleButton}" Content="Open the browser again" Margin="0,0,8,8" Click="OnOpenAgain" />
            <Button x:Name="CopyButton" Style="{StaticResource SubtleButton}" Content="Copy link" Margin="0,0,8,8" Click="OnCopy" />
            <Button x:Name="RetryButton" Style="{StaticResource AccentButton}" Content="Get a new code" Margin="0,0,8,8" Click="OnRetry" Visibility="Collapsed" />
            <Button x:Name="BackButton" Style="{StaticResource FlatButton}" Content="Cancel" Margin="0,0,8,8" Click="OnBack" />
          </WrapPanel>
        </StackPanel>

        <!-- 6. Signed in: which folder to keep in sync -->
        <StackPanel x:Name="FolderStep" MaxWidth="470" Visibility="Collapsed">
          <Border Style="{StaticResource OkChip}" HorizontalAlignment="Left">
            <TextBlock x:Name="SignedInText" Foreground="{DynamicResource T.OkText}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Style="{StaticResource H1}" Text="Choose the folder to keep in sync" TextWrapping="Wrap" Margin="0,14,0,14" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderBox" Style="{StaticResource Input}" />
                <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
              </Grid>
              <TextBlock Style="{StaticResource MutedSmall}" TextWrapping="Wrap" Margin="0,8,0,0"
                         Text="Files on your nest are copied here. Files already in this folder are kept and merged, never replaced." />
              <CheckBox x:Name="AutoStartBox" Style="{StaticResource Switch}" Content="Start Pairnets when I sign in to Windows" Margin="0,14,0,0" />
            </StackPanel>
          </Border>
          <Button x:Name="StartButton" Style="{StaticResource AccentButton}" Content="Start syncing" Padding="18,10" HorizontalAlignment="Right"
                  Margin="0,14,0,0" Click="OnStart" />
        </StackPanel>

      </Grid>
    </ScrollViewer>

    <!-- The bottom line of the steps above that have one -->
    <Grid x:Name="Footer" Grid.Row="1" MaxWidth="364" Margin="28,0,28,28">
      <Border x:Name="AccountFooter" BorderBrush="{DynamicResource T.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
        <Button x:Name="OwnNestButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Click="OnOwnNest">
          <TextBlock Text="I run my own nest on my own domain: use its address" Foreground="{DynamicResource T.Muted}" TextDecorations="Underline"
                     TextWrapping="Wrap" TextAlignment="Center" />
        </Button>
      </Border>
      <StackPanel x:Name="AccountWaitFooter" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
        <Button x:Name="AccountOpenAgainButton" Style="{StaticResource SubtleButton}" Content="Open the page again" Padding="14,10" Margin="0,0,8,0"
                Click="OnAccountOpenAgain" />
        <Button x:Name="AccountCancelButton" Style="{StaticResource FlatButton}" Content="Cancel" Padding="14,10" Foreground="{DynamicResource T.Muted}"
                Click="OnAccountCancel" />
      </StackPanel>
      <Border x:Name="NoNestFooter" BorderBrush="{DynamicResource T.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="NoNestOwnNestButton" Style="{StaticResource LinkButton}" Click="OnOwnNest">
            <TextBlock Text="I run my own nest: use its address" Foreground="{DynamicResource T.Muted}" TextDecorations="Underline" />
          </Button>
          <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Text="·" VerticalAlignment="Center" />
          <Button x:Name="NoNestSignOutButton" Style="{StaticResource LinkButton}" Click="OnAccountCancel">
            <TextBlock Text="Sign out" Foreground="{DynamicResource T.Muted}" TextDecorations="Underline" />
          </Button>
        </StackPanel>
      </Border>
      <Border x:Name="AddressFooter" BorderBrush="{DynamicResource T.Border}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Visibility="Collapsed">
        <Button x:Name="BackToAccountButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Click="OnBackToAccount">
          <TextBlock Text="Sign in with a Pairnets account instead" Foreground="{DynamicResource T.Muted}" TextDecorations="Underline" />
        </Button>
      </Border>
    </Grid>
  </Grid>
</UserControl>
