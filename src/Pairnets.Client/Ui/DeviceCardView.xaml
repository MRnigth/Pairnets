<UserControl x:Class="Pairnets.Client.Ui.DeviceCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui">
  <Border x:Name="Frame" Padding="16" CornerRadius="18" BorderThickness="1"
          Background="{DynamicResource T.Card}" BorderBrush="{DynamicResource T.Border}">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- The computer's icon: solid when it is reachable, dashed when it is not -->
        <Grid x:Name="IconBox" Width="40" Height="40" Margin="0,0,12,0">
          <Border x:Name="IconSolid" CornerRadius="12" Background="{DynamicResource T.Chip}" />
          <Rectangle x:Name="IconDashed" RadiusX="12" RadiusY="12" StrokeThickness="1" StrokeDashArray="3 2" Visibility="Collapsed"
                     Stroke="{DynamicResource T.Dash}" Fill="{DynamicResource T.ChipDim}" />
          <!-- ICON SLOT: the glyph of Card.Icon is drawn here, by DrawIcon (the icon chooser of a later stage plugs in at this place) -->
          <ui:LineIcon x:Name="IconSlot" Width="20" Height="20" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Desktop}" />
          <Ellipse x:Name="Dot" Width="11" Height="11" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"
                   Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}" />
          <!-- The pencil: opens the icon chooser; shown only when the nest can save icons -->
          <ui:DeviceIconPencil x:Name="PencilButton" Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="NameText" FontSize="15" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SystemText" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Button x:Name="CardMoreButton" Grid.Column="2" Style="{StaticResource PgButton}" Width="28" Height="28" Padding="0" BorderThickness="0"
                Background="Transparent" ui:Pg.Radius="9" Click="OnMore">
          <ui:LineIcon Width="16" Height="16" StrokeThickness="3.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.More}" />
        </Button>
      </Grid>

      <Border Style="{StaticResource PgHair}" Margin="0,12,0,12" />

      <Grid Height="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{DynamicResource T.Ok}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" FontSize="13" FontWeight="Bold" />
          <TextBlock x:Name="NoteText" FontSize="13" FontWeight="Medium" Margin="6,0,0,0" />
        </StackPanel>
        <Border x:Name="ThisPill" Grid.Column="2" Height="20" CornerRadius="10" Padding="8,0" Background="{DynamicResource T.AccentSoft}" Visibility="Collapsed">
          <TextBlock Text="This computer" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource T.AccentInk}" />
        </Border>
      </Grid>
      <TextBlock x:Name="LastChangeText" Style="{StaticResource PgSmall}" Margin="0,3,0,0" />
    </StackPanel>
  </Border>
</UserControl>
