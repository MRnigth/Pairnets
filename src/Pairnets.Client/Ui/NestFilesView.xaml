<UserControl x:Class="Pairnets.Client.Ui.NestFilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui"
             xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core">
  <UserControl.Resources>
    <ui:FileIconConverter x:Key="FileIcon" />
    <ui:WhereIconConverter x:Key="WhereIcon" />
    <ui:WhereBrushConverter x:Key="WhereBrush" />
    <BooleanToVisibilityConverter x:Key="Visible" />
    <ui:InverseVisibilityConverter x:Key="Hidden" />
  </UserControl.Resources>
  <!-- "All files" on the Files page: the nest's folders and files, where each lives, and what can be done with them. -->
  <Grid Margin="28,16,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Search, refresh, clean up, add -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ui:SearchBox x:Name="FilesSearch" Height="42" Placeholder="Search files by name or folder" />
      <Button Grid.Column="1" Style="{StaticResource PgIconButton}" Margin="10,0,0,0" ToolTip="Refresh" AutomationProperties.Name="Refresh" Click="OnFilesRefresh">
        <ui:LineIcon Width="17" Height="17" StrokeThickness="2.2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Refresh}" />
      </Button>
      <Button Grid.Column="2" Style="{StaticResource PgButton}" Height="42" Padding="14,0" Margin="10,0,0,0" Click="OnCleanUp">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="16" Height="16" Margin="0,0,7,0" StrokeThickness="2" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Disk}" />
          <TextBlock Text="Clean up…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button x:Name="AddFilesButton" Grid.Column="3" Style="{StaticResource PgPrimary}" Height="42" Padding="16,0" Margin="10,0,0,0" Click="OnAddFiles">
        <StackPanel Orientation="Horizontal">
          <ui:LineIcon Width="16" Height="16" Margin="0,0,7,0" StrokeThickness="2.2" Stroke="White" Data="{StaticResource I.ArrowUp}" />
          <TextBlock Text="Add files" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Where we are, and where this folder lives -->
    <Border Grid.Row="1" Style="{StaticResource PgCard}" Margin="0,12,0,0" Padding="16,8,10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <WrapPanel x:Name="CrumbPanel" VerticalAlignment="Center" />
        <TextBlock x:Name="LivesLabel" Grid.Column="1" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" Margin="12,0,8,0" Text="This folder lives" />
        <Button x:Name="PlacementButton" Grid.Column="2" Style="{StaticResource PgButton}" Height="34" Padding="10,0" Click="OnPlacementMenu">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon x:Name="PlacementIcon" Width="15" Height="15" Margin="0,0,7,0" StrokeThickness="2.1" Stroke="{DynamicResource T.OkText}" Data="{StaticResource I.Desktop}" />
            <TextBlock x:Name="PlacementText" Text="On this PC" VerticalAlignment="Center" />
            <ui:LineIcon Width="12" Height="12" Margin="8,0,0,0" StrokeThickness="2.4" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.ChevDown}" />
          </StackPanel>
          <Button.ContextMenu>
            <ContextMenu x:Name="PlacementMenu" Placement="Bottom">
              <MenuItem x:Name="PickOnThisPc" Tag="ThisPc" Click="OnPickPlacement" />
              <MenuItem x:Name="PickOnDemand" Tag="Demand" Click="OnPickPlacement" />
              <MenuItem x:Name="PickNestOnly" Tag="Nest" Click="OnPickPlacement" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>
    </Border>

    <!-- The nest can't be reached; how the last change went -->
    <StackPanel Grid.Row="2">
      <Border x:Name="OfflineBanner" Margin="0,12,0,0" Padding="16,12" CornerRadius="14" BorderThickness="1"
              Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:LineIcon Width="20" Height="20" Margin="0,0,12,0" StrokeThickness="2" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.CloudOff}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource T.WarnText}">
            <Run FontWeight="Bold" Text="Your nest can't be reached." />
            <Run x:Name="OfflineRun" />
          </TextBlock>
        </Grid>
      </Border>
      <Border x:Name="FilesMessage" Style="{StaticResource OkChip}" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
        <TextBlock x:Name="FilesMessageText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
      </Border>
    </StackPanel>

    <!-- The list (files can be dropped on it) -->
    <Border x:Name="ListCard" Grid.Row="3" Style="{StaticResource PgCard}" Margin="0,12,0,0" Padding="8,4,8,6" AllowDrop="True">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="10,10,10,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.4*" />
            <ColumnDefinition Width="1.4*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="40" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource PgCaps}" Text="NAME" Margin="48,0,0,0" />
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="1" Text="WHERE" />
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="2" Text="SIZE" />
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="3" Text="CHANGED" />
        </Grid>
        <ListBox x:Name="EntryList" Grid.Row="1" Style="{StaticResource PgFileList}" AutomationProperties.Name="Files on your nest">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type c:NestRow}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2.4*" />
                  <ColumnDefinition Width="1.4*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="1.1*" />
                  <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="RowIcon" Width="34" Height="34" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource T.Chip}">
                    <ui:LineIcon x:Name="RowGlyph" Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{Binding Entry.Path, Converter={StaticResource FileIcon}}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="RowName" Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:LineIcon Width="15" Height="15" Margin="0,0,6,0" StrokeThickness="2" Data="{Binding Shows, Converter={StaticResource WhereIcon}}" Stroke="{Binding Shows, Converter={StaticResource WhereBrush}}" />
                  <TextBlock Text="{Binding WhereText}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding WhenText}" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="4" Style="{StaticResource PgIconButton}" Width="32" Height="32" BorderThickness="0" Background="Transparent" ToolTip="More" Click="OnRowMore">
                  <ui:LineIcon Width="16" Height="16" StrokeThickness="3" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.More}" />
                  <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                      <MenuItem Header="Open" Click="OnRowOpen" />
                      <MenuItem Header="Save a copy…" Click="OnRowSaveCopy" Visibility="{Binding IsFolder, Converter={StaticResource Hidden}}" />
                      <MenuItem Header="Rename…" Click="OnRowRename" />
                      <MenuItem Header="Move to…" Click="OnRowMove" />
                      <MenuItem Header="Delete…" Click="OnRowDelete" />
                      <Separator Visibility="{Binding IsFolder, Converter={StaticResource Visible}}" />
                      <MenuItem Header="Where this folder lives" Visibility="{Binding IsFolder, Converter={StaticResource Visible}}">
                        <MenuItem Header="On this PC" Tag="ThisPc" Click="OnRowPlace" />
                        <MenuItem Header="On-Demand" Tag="Demand" Click="OnRowPlace" />
                        <MenuItem Header="Only on the nest" Tag="Nest" Click="OnRowPlace" />
                      </MenuItem>
                    </ContextMenu>
                  </Button.ContextMenu>
                </Button>
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                  <Setter TargetName="RowIcon" Property="Background" Value="{DynamicResource T.AccentSoft}" />
                  <Setter TargetName="RowGlyph" Property="Stroke" Value="{DynamicResource T.AccentInk}" />
                  <Setter TargetName="RowGlyph" Property="Data" Value="{StaticResource I.Folder}" />
                  <Setter TargetName="RowName" Property="FontWeight" Value="Bold" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- Not connected, nothing here, nothing found -->
        <StackPanel x:Name="EmptyMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" Visibility="Collapsed">
          <ui:LineIcon Width="30" Height="30" StrokeThickness="1.6" Stroke="{DynamicResource T.TextSoft}" Data="{StaticResource I.Folder}" HorizontalAlignment="Center" />
          <TextBlock x:Name="EmptyText" Style="{StaticResource PgSub}" TextAlignment="Center" MaxWidth="360" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- How much is here, and the drop hint -->
    <StackPanel Grid.Row="4" Margin="4,12,0,0">
      <TextBlock x:Name="FooterText" Style="{StaticResource PgSmall}" FontSize="13" />
      <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
        <ui:LineIcon Width="15" Height="15" Margin="0,0,8,0" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.InfoCircle}" />
        <TextBlock Style="{StaticResource PgSmall}" FontSize="13" TextWrapping="Wrap" Text="Drop files here to put them on your nest. Double-click a file to open it: changes you save go back to your nest." />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
