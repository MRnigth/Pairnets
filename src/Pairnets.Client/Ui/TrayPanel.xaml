<Window x:Class="Pairnets.Client.Ui.TrayPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Pairnets.Client.Ui"
        xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core"
        Title="Pairnets" Width="404" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual">
  <Window.Resources>
    <!-- A row of "Latest changes": a square with an arrow, the file, what happened, and when. -->
    <DataTemplate x:Key="ChangeRow" DataType="{x:Type c:TrayChange}">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Square" Width="30" Height="30" CornerRadius="10" Background="{DynamicResource T.Chip}" Margin="0,0,10,0" VerticalAlignment="Center">
          <ui:LineIcon x:Name="Glyph" Width="14" Height="14" StrokeThickness="2.4" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Up}" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="Sub" Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource T.TextSoft}" />
        </StackPanel>
        <TextBlock x:Name="Right" Grid.Column="2" Text="{Binding Right}" FontSize="11.5" Foreground="{DynamicResource T.TextSoft}" VerticalAlignment="Center" Margin="8,0,0,0" />
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Live">
          <Setter TargetName="Square" Property="Background" Value="{DynamicResource T.AccentSoft}" />
          <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource T.AccentInk}" />
          <Setter TargetName="Sub" Property="FontWeight" Value="SemiBold" />
          <Setter TargetName="Right" Property="Foreground" Value="{DynamicResource T.Muted}" />
          <Setter TargetName="Right" Property="FontWeight" Value="Bold" />
        </DataTrigger>
        <!-- The live row of a file coming from the nest: a down arrow (still blue, it is moving now). -->
        <DataTrigger Binding="{Binding LiveDown}" Value="True">
          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource I.Down}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Down">
          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource I.Down}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource T.OkText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Warn">
          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource I.Warning}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource T.WarnText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Bad">
          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource I.X}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource T.BadText}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Muted">
          <Setter TargetName="Glyph" Property="Data" Value="{StaticResource I.Info}" />
          <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource T.TextSoft}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <!-- The quick look that opens from the tray icon. The margin leaves room for the shadow. -->
  <Border Margin="10" Background="{DynamicResource T.Bg}" BorderBrush="{DynamicResource T.Border}" BorderThickness="1" CornerRadius="22" Padding="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.22" />
    </Border.Effect>
    <StackPanel>
      <!-- Header: logo, name, the "…" menu -->
      <Grid Height="32" Margin="4,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="Logo" Width="24" Height="24" Margin="0,0,8,0" />
        <TextBlock Grid.Column="1" Text="Pairnets" FontSize="15" FontWeight="ExtraBold" VerticalAlignment="Center" />
        <Button x:Name="MoreButton" Grid.Column="2" Style="{StaticResource RoundIconButton}" Width="32" Height="32" MinWidth="32" MinHeight="32"
                ToolTip="More" Click="OnMore">
          <ui:LineIcon Width="16" Height="16" StrokeThickness="3" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.More}" />
          <Button.ContextMenu>
            <ContextMenu Placement="Bottom" Closed="OnMenuClosed">
              <MenuItem Header="Sync now" Click="OnSyncNow" />
              <MenuItem Header="Settings…" Click="OnSettings" />
              <MenuItem Header="History…" Click="OnHistory" />
              <Separator />
              <MenuItem Header="View log" Click="OnViewLog" />
              <MenuItem Header="Report a bug…" Click="OnReportBug" />
              <Separator />
              <MenuItem Header="Exit Pairnets" Click="OnQuit" />
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </Grid>

      <!-- Status, then the nest with a line to every computer -->
      <Border Style="{StaticResource Card}" Padding="14,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,12,0" VerticalAlignment="Center">
              <Ellipse x:Name="StatusBadge" Fill="{DynamicResource T.AccentSoft}" />
              <ui:LineIcon x:Name="StatusGlyph" Width="20" Height="20" StrokeThickness="2.2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Sync}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="Headline" FontSize="17" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" Text="Starting…" />
              <TextBlock x:Name="Detail" FontSize="12" Foreground="{DynamicResource T.Muted}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34" />
            </StackPanel>
            <TextBlock x:Name="PercentText" Grid.Column="2" FontSize="24" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" />
          </Grid>

          <ProgressBar x:Name="Progress" Style="{StaticResource RoundProgress}" Height="6" Minimum="0" Maximum="100" Margin="0,10,0,0" Visibility="Collapsed" />
          <Grid x:Name="ProgressLine" Margin="0,7,0,0" Visibility="Collapsed">
            <TextBlock x:Name="FilesText" FontSize="12" Foreground="{DynamicResource T.Muted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" />
            <TextBlock x:Name="LeftText" FontSize="12" Foreground="{DynamicResource T.Muted}" HorizontalAlignment="Right" />
          </Grid>
          <Border x:Name="PausedNote" Background="{DynamicResource T.Chip}" CornerRadius="12" Padding="10,6" Margin="0,10,0,0" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
              <ui:LineIcon Width="15" Height="15" StrokeThickness="2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Info}" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock x:Name="PausedNoteText" FontSize="12" Foreground="{DynamicResource T.Muted}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Border Height="1" Background="{DynamicResource T.Border}" Margin="0,10" />

          <!-- The nest -->
          <Grid Height="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Width="28" Height="28" Margin="0,0,10,0">
              <Border Background="{DynamicResource T.AccentSoft}" CornerRadius="9">
                <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.Nest}" />
              </Border>
              <Ellipse x:Name="NestDotShape" Width="10" Height="10" StrokeThickness="2" Stroke="{DynamicResource T.Card}" Fill="{DynamicResource T.Ok}"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
            </Grid>
            <TextBlock Grid.Column="1" Text="Your nest" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
            <TextBlock x:Name="NestSub" Grid.Column="2" FontSize="11.5" Foreground="{DynamicResource T.TextSoft}" VerticalAlignment="Center" />
          </Grid>
          <Border Width="2" Height="4" Margin="13,0,0,0" HorizontalAlignment="Left" Background="{DynamicResource T.Line}" />
          <StackPanel x:Name="Branches" Margin="13,0,0,0" />
          <TextBlock x:Name="MoreText" FontSize="11.5" Foreground="{DynamicResource T.TextSoft}" Margin="13,4,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <Button x:Name="FixButton" Style="{StaticResource WarnButton}" HorizontalAlignment="Stretch" Margin="0,10,0,0" Visibility="Collapsed" Click="OnFix" />

      <!-- Something needs a decision -->
      <Border x:Name="AttentionButton" Height="44" CornerRadius="16" Background="{DynamicResource T.WarnPill}" BorderBrush="{DynamicResource T.WarnBorder}" BorderThickness="1"
              Margin="0,10,0,0" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonUp="OnAttention">
        <Grid Margin="14,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:LineIcon Width="18" Height="18" StrokeThickness="2" Stroke="{DynamicResource T.WarnText}" Data="{StaticResource I.Warning}" Margin="0,0,10,0" />
          <TextBlock x:Name="AttentionText" Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource T.WarnText}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="Review" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource T.Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ui:LineIcon Grid.Column="3" Width="16" Height="16" StrokeThickness="2.2" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.Chevron}" />
        </Grid>
      </Border>

      <!-- Latest changes -->
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
        <StackPanel>
          <Grid>
            <TextBlock Text="Latest changes" FontSize="13" FontWeight="ExtraBold" VerticalAlignment="Center" />
            <Button Content="See all" Style="{StaticResource LinkButton}" Foreground="{DynamicResource T.AccentInk}" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,-3,-6,0" Click="OnSeeAll" />
          </Grid>
          <ItemsControl x:Name="RecentList" Margin="0,4,0,0" ItemTemplate="{StaticResource ChangeRow}" Focusable="False" />
          <TextBlock x:Name="RecentEmpty" Foreground="{DynamicResource T.Muted}" FontSize="12" Margin="0,2,0,4" Text="Nothing has synced yet." />
        </StackPanel>
      </Border>

      <!-- Quick buttons -->
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="PauseButton" Style="{StaticResource SubtleButton}" Padding="13,0" Click="OnPause">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon x:Name="PauseGlyph" Width="15" Height="15" StrokeThickness="2.2" Margin="0,0,7,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="{StaticResource I.Pause}" />
            <TextBlock x:Name="PauseText" Text="Pause" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Padding="13,0" Margin="8,0,0,0" Click="OnOpenFolder" ToolTip="Open the synced folder">
          <StackPanel Orientation="Horizontal">
            <ui:LineIcon Width="15" Height="15" StrokeThickness="1.9" Margin="0,0,7,0" Stroke="{DynamicResource T.Text}" Data="{StaticResource I.Folder}" />
            <TextBlock Text="Folder" />
          </StackPanel>
        </Button>
        <Button x:Name="OpenButton" Grid.Column="2" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Content="Open Pairnets" Click="OnOpenApp" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
