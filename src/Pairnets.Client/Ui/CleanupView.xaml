<UserControl x:Class="Pairnets.Client.Ui.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Pairnets.Client.Ui"
             xmlns:c="clr-namespace:Pairnets.Core.Client;assembly=Pairnets.Core">
  <UserControl.Resources>
    <ui:FileIconConverter x:Key="FileIcon" />
  </UserControl.Resources>
  <!-- "Clean up your nest": the biggest files on the nest, to save elsewhere or (only when completely sure) delete for good. -->
  <Grid Margin="28,40,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Style="{StaticResource PgTitle}" Text="Clean up your nest" />
        <TextBlock x:Name="CleanupSubtitle" Style="{StaticResource PgSub}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource PgButton}" Padding="18,0" VerticalAlignment="Center" Content="Done" Click="OnCleanupDone" />
    </Grid>

    <!-- We recommend not deleting -->
    <Border Grid.Row="1" Margin="0,16,0,0" Padding="16,12" CornerRadius="14" Background="{DynamicResource T.AccentSoft}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:LineIcon Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top" StrokeThickness="2" Stroke="{DynamicResource T.AccentInk}" Data="{StaticResource I.InfoCircle}" />
        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource T.AccentInk}">
          <Run FontWeight="Bold" Text="We recommend you don't delete anything." />
          <Run Text="Better ways to make room: save big files you rarely need to an external drive with Save a copy, or give your nest a bigger disk. Delete only if you are completely sure." />
        </TextBlock>
      </Grid>
    </Border>

    <!-- Kinds of file, biggest first -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <WrapPanel x:Name="KindChips" />
      <TextBlock Grid.Column="1" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" Text="Sort: biggest first" />
    </Grid>

    <!-- How the last change went -->
    <Border x:Name="CleanupMessage" Grid.Row="3" Style="{StaticResource OkChip}" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="Collapsed">
      <TextBlock x:Name="CleanupMessageText" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" />
    </Border>

    <!-- The biggest files, then older versions and deleted files -->
    <Border Grid.Row="4" Style="{StaticResource PgCard}" Margin="0,12,0,0" Padding="8,4,8,6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="10,10,10,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="0.8*" />
            <ColumnDefinition Width="1.2*" />
            <ColumnDefinition Width="230" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="1" Text="FILE" />
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="2" Text="TYPE" />
          <TextBlock Style="{StaticResource PgCaps}" Grid.Column="3" Text="SIZE" />
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl x:Name="BigList" Style="{StaticResource PlainList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type c:CleanupRow}">
                  <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="10,9">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="230" />
                      </Grid.ColumnDefinitions>
                      <Border Style="{StaticResource PgChipSquare}" Margin="0,0,14,0">
                        <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{Binding Entry.Path, Converter={StaticResource FileIcon}}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding KindText}" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding SizeText}" FontWeight="Bold" FontSize="13" />
                        <ProgressBar Style="{StaticResource RoundProgress}" Height="5" Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Margin="0,5,0,0" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource PgSmallButton}" Content="Save a copy…" Click="OnCleanupSave" />
                        <Button Style="{StaticResource PgSmallButton}" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Content="Delete…" Click="OnCleanupDelete" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border x:Name="HistoryRow" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource T.Border}" Padding="10,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="48" />
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="0.8*" />
                  <ColumnDefinition Width="1.2*" />
                  <ColumnDefinition Width="230" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PgChipSquare}" Margin="0,0,14,0">
                  <ui:LineIcon Width="16" Height="16" StrokeThickness="1.9" Stroke="{DynamicResource T.Muted}" Data="{StaticResource I.History}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Older versions and deleted files" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Kept 30 days in History, then removed by your nest by itself" Style="{StaticResource PgSmall}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="History" Style="{StaticResource PgSmall}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock x:Name="HistorySize" Grid.Column="3" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                <Button Grid.Column="4" Style="{StaticResource PgSmallButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Open History" Click="OnOpenHistory" />
              </Grid>
            </Border>
            <TextBlock x:Name="CleanupEmpty" Style="{StaticResource PgSub}" Margin="10,16" TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <TextBlock x:Name="CleanupFooter" Grid.Row="5" Style="{StaticResource PgSmall}" FontSize="13" Margin="4,12,0,0" />
  </Grid>
</UserControl>
