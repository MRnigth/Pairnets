# Files that run on Linux keep LF line endings, also in a Windows checkout: the pre-deploy check installs the
# server inside a Linux test box straight from this folder, and bash refuses scripts with CRLF endings.
*.sh                          text eol=lf
*.py                          text eol=lf
*.mjs                         text eol=lf
*.service                     text eol=lf
*.path                        text eol=lf
*.timer                       text eol=lf
deploy/pairnets.env.example   text eol=lf
deploy/macos/Info.plist       text eol=lf
