# /etc/tether/tether.env  (owner root, mode 600). Read by systemd before dropping privileges.
# install.sh writes this file for you; this is only a reference.

# Shared secret. Generate with: openssl rand -hex 32
SYNC_TOKEN=<paste-a-64-character-hex-token-here>

# Listen ONLY on the server's Tailscale address (get it with: tailscale ip -4).
# Never use 0.0.0.0 here.
ASPNETCORE_URLS=http://<tailscale-ip>:5075

Sync__DataDir=/var/lib/tether
# Where update requests go; must be the folder the root updater watches.
Sync__UpdateDir=/var/lib/tether/update
Sync__HistoryRetentionDays=30
Sync__HistoryMinVersions=5

# Optional: abandon an upload that sends no data for this long (default 00:01:00).
# Sync__UploadStallTimeout=00:01:00
