[Unit]
Description=Tether server self-update (started by tether-update.path)
Documentation=https://github.com/MRnigth/Tether/blob/main/docs/DEPLOY.md
After=network-online.target
Wants=network-online.target
# Runs only for a waiting request (the timer fallback starts it every 2 minutes), and is never
# disabled by systemd's start limit, however often it ran.
ConditionPathExists=/var/lib/tether/update/request
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/opt/tether/update.sh
TimeoutStartSec=15min
