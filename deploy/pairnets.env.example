# /etc/pairnets/pairnets.env  (owner root, mode 600). Read by systemd before dropping privileges.
# install.sh writes this file for you and keeps your changes on upgrades; this is only a reference.
# After editing it: sudo systemctl restart pairnets-server

# Shared secret, only for older Pairnets apps that still ask for a token (today's apps sign in with
# the browser instead). install.sh generates it once; by hand: openssl rand -hex 32
SYNC_TOKEN=<paste-a-64-character-hex-token-here>

# Listen ONLY on 127.0.0.1: the Cloudflare Tunnel (pairnets-tunnel.service) brings the PCs in.
# Never use 0.0.0.0 here.
ASPNETCORE_URLS=http://127.0.0.1:5075

Sync__DataDir=/var/lib/pairnets
# Where update requests go; must be the folder the root updater watches.
Sync__UpdateDir=/var/lib/pairnets/update
Sync__HistoryRetentionDays=30
Sync__HistoryMinVersions=5

# Optional: abandon an upload that sends no data for this long (default 00:01:00).
# Sync__UploadStallTimeout=00:01:00

# Cloudflare Tunnel only (install.sh writes it): every request then comes from 127.0.0.1, so take the
# client's address from CF-Connecting-IP (trusted on loopback connections only).
# Sync__TrustProxyHeaders=true

# ---- Linked to your Pairnets account (install.sh writes these on a first install, or with --link):
# the server is reached through https://sync.pairnets.app, and Pairnets signs its own calls to it with
# the key. Both or neither; the server does not start with only one. No public name then (below).
# Sync__RelayNestId=nst_<26 letters and digits>
# Sync__RelayKey=<the key from Pairnets, 43 characters>
# Sync__RelayServiceUrl=https://sync.pairnets.app

# ---- Your own domain (advanced):
# The nest's public name (install.sh --public-url writes it). The server builds its website, sign-in
# links and passkeys on it, and the apps type it to sign in. Without it there is no website, and only
# older apps with the token can connect. If Sync__PublicUrl or PUBLIC_URL is also set, those win;
# install.sh --public-url removes them.
# PAIRNETS_PUBLIC_URL=https://sync.example.com
# The tunnel token itself is kept in /etc/pairnets/tunnel.env (root only, mode 600).

# ---- Optional: sign in with an emailed link. Any SMTP service works, e.g. Resend (host smtp.resend.com,
# user "resend", an API key as the password). Off while Sync__SmtpHost is unset; needs the public name.
# Sync__SmtpHost=smtp.example.com
# 587 (STARTTLS) is the default port.
# Sync__SmtpPort=587
# Sync__SmtpUser=<smtp-user>
# Sync__SmtpPassword=<smtp-password>
# The sender; its domain must be allowed to send mail (SPF/DKIM). Required with Sync__SmtpHost.
# Sync__SmtpFrom="Pairnets nest <nest@example.com>"
# STARTTLS is on by default; turn it off only for a mail server on this machine.
# Sync__SmtpUseTls=false

# ---- Optional: "Continue with Google". Create your own OAuth client (type "Web application") in the
# Google Cloud console and add the redirect URI {public name}/auth/google/callback, for example
# https://sync.example.com/auth/google/callback. Off unless both are set; needs the public name.
# Sync__GoogleClientId=<client-id>.apps.googleusercontent.com
# Sync__GoogleClientSecret=<client-secret>

# ---- Optional: the domain passkeys are tied to. Default: the nest's own host name (sync.example.com).
# Set it to a parent domain (example.com) only if something else on that domain should share the
# passkeys; it must be the nest's host or a parent of it. Changing it later makes existing passkeys stop working.
# Sync__PasskeyRpId=example.com
