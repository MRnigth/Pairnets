#!/bin/sh
# Pairnets push checks (installed by scripts/deploy-gate/install.mjs), for every push from every worktree:
#  1. Secrets: the commits this push sends that no remote branch has yet go through check-secrets.sh --range,
#     before anything is public. It is the copy installed next to the gate, so branches made before --range existed
#     are checked too.
#  2. The pre-deploy check: a push to main or of a v* tag is a release, so it needs a passed check for exactly that
#     commit. This hook only looks for the pass record; it never runs the check itself (that takes about 15 minutes).
dir="${HOME:-$USERPROFILE}/.claude/hooks/pairnets-deploy-gate"
if command -v cygpath >/dev/null 2>&1; then dir="$(cygpath -m "$dir")"; fi
gate="$dir/deploy-gate.mjs"
scan="$dir/check-secrets.sh"
if ! command -v node >/dev/null 2>&1 || [ ! -f "$gate" ] || [ ! -f "$scan" ]; then
  echo "pre-push: the Pairnets push checks are not installed properly (node, $gate or $scan is missing), so nothing was pushed." >&2
  echo "pre-push: install them again with: node scripts/deploy-gate/install.mjs" >&2
  exit 1
fi

input="$(cat)"
printf '%s\n' "$input" | while read -r local_ref local_sha remote_ref _; do
  [ -n "$local_sha" ] || continue
  # Deleting a remote branch or tag sends nothing.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  if ! bash "$scan" --range "$local_sha" --not --remotes >/dev/null; then
    echo "pre-push: nothing was pushed: $local_ref -> $remote_ref adds something that looks like a secret or personal data (above)." >&2
    exit 1
  fi
done || exit 1

printf '%s\n' "$input" | node "$gate" --pre-push "$@"
