<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Puts Pairnets into the real File Explorer of a throwaway CI computer (windows-latest) and takes pictures of it, for
    review. It changes that computer's registry and folders, so it only runs in CI: never on a person's computer. Not shipped.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <!-- Windows 10 2004 SDK: Windows.Storage.Provider, to register the Pairnets folder as a cloud folder (Explorer ticks). -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pairnets.Client\Pairnets.Client.csproj" />
  </ItemGroup>

</Project>
